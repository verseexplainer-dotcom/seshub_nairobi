# SES ICT HUB - Environment Variables Template
# Copy this file to .env or .env.local and fill in the values

# Public Supabase credentials (safe for client-side)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_FALLBACK_IMAGE_URL=https://your-project.supabase.co/storage/v1/object/public/site-assets/product-placeholder.webp
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Private Supabase credentials (NEVER commit these!)
# Required for Worker-side API routes (/api/checkout, /api/events, /api/newsletter)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Meta integrations
# Public Pixel ID is safe for browser use. Keep all other Meta values private.
PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=

# Cloudflare Worker deployment auth (read from .env.local by project scripts; never commit real values)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
