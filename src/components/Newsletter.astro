---
import TurnstileWidget from './TurnstileWidget.astro';
---

<section class="newsletter section" aria-labelledby="newsletter-title">
  <div class="container">
    <div class="newsletter-shell">
      <div class="newsletter-copy">
        <p class="section-kicker">Deal alerts</p>
        <h2 id="newsletter-title" class="section-title">Get restock and offer alerts.</h2>
        <p class="section-copy">
          Join the list for laptop deals, printer restocks, and useful buying updates.
        </p>
      </div>

      <form class="newsletter-form" id="newsletter-form">
        <div class="newsletter-input-row">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="Email address"
            required
            autocomplete="email"
            inputmode="email"
          />
          <button type="submit" class="pill-button primary">Get alerts</button>
        </div>

        <label class="newsletter-consent">
          <input type="checkbox" name="consent" required />
          <span>I agree to receive promotions, restock alerts, and useful buying updates.</span>
        </label>

        <TurnstileWidget widgetId="newsletter-turnstile" action="newsletter_signup" />
        <div id="newsletter-message" class="newsletter-message" aria-live="polite" hidden></div>
      </form>
    </div>
  </div>
</section>

<style>
  .newsletter-shell {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    overflow: hidden;
    background: linear-gradient(135deg, #061633, #0b1220);
    color: #ffffff;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
  }

  .newsletter-copy,
  .newsletter-form {
    position: relative;
    z-index: 1;
  }

  .newsletter-copy :global(.section-title) {
    color: #ffffff;
  }

  .newsletter-copy :global(.section-kicker) {
    color: #b6f5d4;
  }

  .newsletter-copy :global(.section-copy),
  .newsletter-consent {
    color: rgba(255, 255, 255, 0.76);
  }

  .newsletter-copy .section-intro {
    margin-bottom: 0;
  }

  .newsletter-form {
    display: grid;
    gap: 0.85rem;
  }

  .newsletter-input-row {
    display: grid;
    gap: 0.75rem;
  }

  .newsletter-input-row input {
    width: 100%;
    min-height: 3.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(229, 231, 235, 0.92);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.94);
  }

  .newsletter-consent {
    display: flex;
    align-items: start;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .newsletter-message {
    font-weight: 700;
  }

  .turnstile-unavailable {
    color: var(--color-danger);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .newsletter-message.success {
    color: var(--color-success);
  }

  .newsletter-message.error {
    color: var(--color-danger);
  }

  @media (min-width: 980px) {
    .newsletter-shell {
      grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.9fr);
      align-items: center;
    }

    .newsletter-input-row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
</style>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const messageEl = document.getElementById('newsletter-message');
  const resetTurnstile = () => window.turnstile?.reset?.('newsletter-turnstile');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const email = formData.get('email');
    const consent = formData.get('consent') === 'on';
    const turnstileToken = formData.get('cf-turnstile-response');

    if (messageEl) {
      messageEl.hidden = false;
      messageEl.textContent = 'Subscribing...';
      messageEl.classList.remove('success', 'error');
    }

    try {
      const response = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          consent,
          source_page: window.location.pathname,
          session_id: localStorage.getItem('ses_session_id'),
          turnstile_token: turnstileToken
        })
      });

      const body = await response.json().catch(() => null);
      if (!response.ok || !body?.ok) {
        throw new Error(body?.error?.message || 'Failed to subscribe');
      }

      if (messageEl) {
        messageEl.textContent = 'You are on the list. Watch for stock drops and limited offers.';
        messageEl.classList.add('success');
      }

      form.reset();
      resetTurnstile();
    } catch {
      if (messageEl) {
        messageEl.textContent = 'We could not complete the signup right now. Please try again shortly.';
        messageEl.classList.add('error');
      }
      resetTurnstile();
    }
  });
</script>
