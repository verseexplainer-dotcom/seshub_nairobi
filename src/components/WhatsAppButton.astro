---
import { buildWhatsAppLink } from '../lib/storefront';

interface Props {
  message?: string;
  label?: string;
  productSlug?: string | null;
  class?: string;
}

const {
  message = 'Hi SES ICT HUB, I need help with prices, stock, or delivery.',
  label = 'WhatsApp',
  productSlug,
  class: className = ''
} = Astro.props;

const productRef = productSlug ? ` Product: https://sesicthub.co.ke/product/${productSlug}` : '';
const href = buildWhatsAppLink(`${message}${productRef}`);
---

<a
  href={href}
  class={`chat-button whatsapp ${className}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  data-product-ref={productSlug || undefined}
>
  <span class="chat-button-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M4.4 19.7 5.5 16A8.1 8.1 0 1 1 8 18.3l-3.6 1.4Z" />
      <path d="M9.1 7.8c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.3-.2-.6-.4l-1.8-.9c-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.5-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2.1-.4 0-.6l-.8-1.9Z" />
    </svg>
  </span>
  <strong>{label}</strong>
</a>

<style>
  .chat-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.72rem 1rem;
    border-radius: 999px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
  }

  .chat-button-icon {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.2);
  }

  .chat-button-icon svg {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chat-button.whatsapp {
    background: #128c4a;
    color: #ffffff;
  }
</style>
