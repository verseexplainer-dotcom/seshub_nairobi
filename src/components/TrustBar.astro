---
import { getSiteAssets } from '../lib/siteAssets';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const trustItems = [
  {
    title: 'Fast Delivery',
    description: '2-hour Nairobi delivery | 24-48h countrywide',
    icon: siteAssets.trustIcons.delivery,
    alt: 'Delivery icon'
  },
  {
    title: 'Secure Payments',
    description: 'M-PESA and Cash on Delivery checkout',
    icon: siteAssets.trustIcons.payments,
    alt: 'Payments icon'
  },
  {
    title: 'Trusted Warranty',
    description: 'Warranty-backed electronics with support',
    icon: siteAssets.trustIcons.security,
    alt: 'Security and trust icon'
  }
];
---
<section class="trust-bar">
  <div class="container trust-grid">
    {trustItems.map((item) => (
      <article class="trust-card">
        <div class="trust-icon">
          <img src={item.icon} alt={item.alt} loading="lazy" class="trust-icon-image" />
        </div>
        <div class="trust-text">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    background-color: var(--white);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .trust-card {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .trust-icon {
    background: linear-gradient(145deg, #eff6ff, #ffffff);
    border: 1px solid #bfdbfe;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .trust-icon-image {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .trust-text h3 {
    font-size: 1rem;
    font-weight: 700;
  }

  .trust-text p {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
