---
const features = [
  {
    title: 'Fast Shipping',
    description: 'Same-day Nairobi movement on eligible orders, with pickup when you want more control.',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h8A2.5 2.5 0 0 1 16 6.5V8h1.59a2 2 0 0 1 1.64.85l1.93 2.77c.23.33.34.71.34 1.11v2.77A1.5 1.5 0 0 1 20 17h-.66a2.75 2.75 0 0 1-5.34 0H9.34a2.75 2.75 0 0 1-5.34 0H4A1 1 0 0 1 3 16V6.5Zm2.5-.5a.5.5 0 0 0-.5.5V15h.26a2.76 2.76 0 0 1 5.48 0h2.52a2.76 2.76 0 0 1 5.48 0H19v-2.14L17.2 10.3A.5.5 0 0 0 16.8 10H16V6.5a.5.5 0 0 0-.5-.5h-10ZM7.5 15.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Zm9 0a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z"/></svg>`
  },
  {
    title: 'Warranty Coverage',
    description: 'Key products call out clear warranty periods so customers know exactly what support looks like.',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5 4 5.7v5.24c0 4.94 3.42 9.54 8 10.96 4.58-1.42 8-6.02 8-10.96V5.7L12 2.5Zm0 2.15 6 2.4v3.9c0 3.9-2.54 7.58-6 8.88-3.46-1.3-6-4.98-6-8.88v-3.9l6-2.4Zm-1.05 9.85-1.9-1.9-1.41 1.4 3.31 3.32 5.66-5.66-1.41-1.41-4.25 4.25Z"/></svg>`
  },
  {
    title: 'Flexible Returns',
    description: 'Clear issue handling and responsive support when an order needs follow-up after delivery.',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a8 8 0 1 1-7.75 10H1l3.5 4L8 14H5.28A6 6 0 1 0 11 6V4Zm2 4v4.59l2.3 2.3-1.42 1.41L11 13.41V8h2Z"/></svg>`
  },
  {
    title: 'Secure Payments',
    description: 'M-PESA, bank transfer support, and pay-on-delivery flows where the order qualifies.',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 18.5v-13Zm2.5-.5a.5.5 0 0 0-.5.5V8h12V5.5a.5.5 0 0 0-.5-.5h-11ZM6 10v8.5c0 .276.224.5.5.5h11a.5.5 0 0 0 .5-.5V10H6Zm6 1.25a3.25 3.25 0 1 1 0 6.5 3.25 3.25 0 0 1 0-6.5Zm0 2a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z"/></svg>`
  },
  {
    title: 'Expert Support',
    description: 'Buyers can get practical guidance before checkout instead of guessing between similar listings.',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a8 8 0 0 1 8 8v3.27c0 .53-.21 1.04-.59 1.41l-2.73 2.73A2 2 0 0 1 15.27 18H13v1a2 2 0 0 1-2 2H9v-2h2v-2.5a1.5 1.5 0 0 1 1.5-1.5h2.77l2.73-2.73V10a6 6 0 1 0-12 0v5H4v-5a8 8 0 0 1 8-8Zm-2 8a2 2 0 1 1 4 0c0 .93-.64 1.58-1.17 2.1-.4.39-.83.8-.83 1.4h-2c0-1.43.86-2.28 1.43-2.84.36-.36.57-.59.57-.66a.5.5 0 0 0-1 0h-2Z"/></svg>`
  },
  {
    title: 'Authenticity First',
    description: 'Listings stay anchored to real stock, condition language, and in-person trust cues from the Moi Avenue shop.',
    icon: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 6v6c0 5.25 3.66 10.03 9 11.5 5.34-1.47 9-6.25 9-11.5V6l-9-4Zm0 2.18 7 3.11v4.7c0 4.11-2.7 8-7 9.3-4.3-1.3-7-5.19-7-9.3v-4.7l7-3.11Zm-1.53 9.9-1.9-1.9-1.42 1.41 3.32 3.31 6.36-6.36-1.41-1.42-4.95 4.96Z"/></svg>`
  }
];
---

<section class="why-choose section" aria-labelledby="why-choose-title">
  <div class="container">
    <div class="section-intro">
      <p class="section-kicker">Why choose us</p>
      <h2 id="why-choose-title" class="section-title">Confidence-building signals without clutter or fake urgency</h2>
      <p class="section-copy">
        The homepage now stays grounded in the decisions that matter most to electronics buyers: delivery, warranty, authenticity, and human support.
      </p>
    </div>

    <div class="why-choose-grid">
      {features.map((feature) => (
        <article class="why-choose-card surface-card">
          <div class="why-choose-icon" set:html={feature.icon} />
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why-choose {
    background:
      radial-gradient(circle at top right, rgba(37, 99, 235, 0.08), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 1), rgba(248, 250, 252, 0.96));
  }

  .why-choose-grid {
    display: grid;
    gap: 1rem;
  }

  .why-choose-card {
    display: grid;
    gap: 0.85rem;
    padding: 1.3rem;
  }

  .why-choose-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 1rem;
    background: rgba(37, 99, 235, 0.1);
    color: var(--color-primary);
  }

  .why-choose-icon :global(svg) {
    width: 1.55rem;
    height: 1.55rem;
    fill: currentColor;
  }

  .why-choose-card h3 {
    font-size: 1.08rem;
  }

  .why-choose-card p {
    color: var(--color-text-muted);
  }

  @media (min-width: 760px) {
    .why-choose-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1160px) {
    .why-choose-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
