---
interface Props {
  variant?: 'floating' | 'inline';
  placeholder?: string;
}

const {
  variant = 'floating',
  placeholder = 'Search for laptops, desktops, phones, printers, or brands...'
} = Astro.props;
---

<div class={`search-container ${variant}`} data-search-root>
  <div class="search-box">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input
      type="text"
      class="search-input"
      data-search-input
      placeholder={placeholder}
      aria-label="Search products"
      autocomplete="off"
    />
  </div>
  <div class="search-suggestions hidden" data-search-suggestions></div>
</div>

<style>
  .search-container {
    max-width: 600px;
    position: relative;
    z-index: 80;
  }

  .search-container.floating {
    margin: -30px auto var(--space-xl);
    padding: 0 var(--space-md);
  }

  .search-container.inline {
    margin: 0;
    max-width: 100%;
  }

  .search-box {
    background-color: var(--white);
    border-radius: var(--radius-full);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
  }

  .search-container.inline .search-box {
    box-shadow: none;
    background: rgb(248 250 252 / 0.96);
  }

  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input {
    border: none;
    background: none;
    flex: 1;
    min-width: 0;
    font-size: 1rem;
    color: var(--text-main);
    outline: none;
  }

  .search-suggestions {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    background-color: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px rgb(15 23 42 / 0.12);
    border: 1px solid var(--border);
    overflow: hidden;
    max-height: 400px;
    overflow-y: auto;
  }

  .search-container.floating .search-suggestions {
    left: var(--space-md);
    right: var(--space-md);
  }

  .suggestion-section {
    padding: 0.5rem 0;
    border-top: 1px solid var(--border);
  }

  .suggestion-section:first-child {
    border-top: none;
  }

  .section-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 700;
    padding: 0.25rem 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .suggestion-item {
    display: block;
    padding: 0.75rem 1rem;
    transition: background-color 0.2s ease;
  }

  .suggestion-item:hover {
    background-color: #f8fafc;
  }

  .prod-title,
  .category-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .prod-price,
  .category-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .prod-price {
    color: var(--primary);
    font-weight: 700;
  }

  .no-results {
    color: var(--text-muted);
    cursor: default;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 640px) {
    .search-container.floating {
      margin-top: -15px;
    }

    .search-box {
      padding-inline: 1rem;
    }
  }
</style>

<script>
  const searchRoots = Array.from(document.querySelectorAll('[data-search-root]'));

  function toCategoryLabel(value: string) {
    return value
      .split(/[-_\s]+/)
      .filter(Boolean)
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ');
  }

  type SearchProduct = {
    title: string;
    slug: string;
    price_kes: number;
  };

  type SearchPayload = {
    products: SearchProduct[];
    categories: string[];
  };

  function normalizePayload(data: unknown): SearchPayload {
    const record = data && typeof data === 'object' ? (data as Record<string, unknown>) : {};
    const products = Array.isArray(record.products)
      ? record.products
          .filter((prod: any) => prod && typeof prod.slug === 'string' && typeof prod.title === 'string')
          .map((prod: any) => ({
            title: String(prod.title),
            slug: String(prod.slug),
            price_kes: Number(prod.price_kes || 0)
          }))
      : [];

    const categories = Array.isArray(record.categories)
      ? record.categories.filter((cat: unknown) => typeof cat === 'string').map((cat: string) => cat.trim()).filter(Boolean)
      : [];

    return { products, categories };
  }

  function makeSection(title: string) {
    const section = document.createElement('div');
    section.className = 'suggestion-section';

    const sectionTitle = document.createElement('div');
    sectionTitle.className = 'section-title';
    sectionTitle.textContent = title;
    section.appendChild(sectionTitle);

    return section;
  }

  function makeCategoryItem(category: string) {
    const item = document.createElement('a');
    item.className = 'suggestion-item category-item';
    item.href = `/category/${encodeURIComponent(category)}`;

    const title = document.createElement('div');
    title.className = 'category-title';
    title.textContent = toCategoryLabel(category);

    const note = document.createElement('div');
    note.className = 'category-note';
    note.textContent = 'Browse this category';

    item.append(title, note);
    return item;
  }

  function makeProductItem(product: SearchProduct) {
    const item = document.createElement('a');
    item.className = 'suggestion-item product-item';
    item.href = `/product/${encodeURIComponent(product.slug)}`;

    const title = document.createElement('div');
    title.className = 'prod-title';
    title.textContent = product.title;

    const price = document.createElement('div');
    price.className = 'prod-price';
    const safePrice = Number.isFinite(Number(product.price_kes)) ? Number(product.price_kes) : 0;
    price.textContent = `KSh ${safePrice.toLocaleString('en-KE')}`;

    item.append(title, price);
    return item;
  }

  searchRoots.forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.searchBound === '1') {
      return;
    }

    root.dataset.searchBound = '1';

    const searchInput = root.querySelector('[data-search-input]') as HTMLInputElement | null;
    const suggestionsBox = root.querySelector('[data-search-suggestions]') as HTMLElement | null;
    let debounceTimer: number | undefined;

    function clearSuggestions() {
      suggestionsBox?.replaceChildren();
    }

    function hideSuggestions() {
      suggestionsBox?.classList.add('hidden');
    }

    function renderSuggestions(data: unknown) {
      if (!suggestionsBox) {
        return;
      }

      const { products, categories } = normalizePayload(data);
      clearSuggestions();

      if (products.length === 0 && categories.length === 0) {
        const emptyState = document.createElement('div');
        emptyState.className = 'suggestion-item no-results';
        emptyState.textContent = 'No matches found';

        const browseAll = document.createElement('a');
        browseAll.className = 'suggestion-item';
        browseAll.href = '/shop';
        browseAll.textContent = 'Browse all products';

        suggestionsBox.append(emptyState, browseAll);
        suggestionsBox.classList.remove('hidden');
        return;
      }

      if (categories.length > 0) {
        const categorySection = makeSection('Categories');
        categories.forEach((category) => categorySection.appendChild(makeCategoryItem(category)));
        suggestionsBox.appendChild(categorySection);
      }

      if (products.length > 0) {
        const productSection = makeSection('Products');
        products.forEach((product) => productSection.appendChild(makeProductItem(product)));
        suggestionsBox.appendChild(productSection);
      }

      suggestionsBox.classList.remove('hidden');
    }

    searchInput?.addEventListener('input', (event) => {
      const query = (event.target as HTMLInputElement).value;
      clearTimeout(debounceTimer);

      if (query.length < 2) {
        hideSuggestions();
        return;
      }

      debounceTimer = window.setTimeout(async () => {
        try {
          const response = await fetch(`/api/search/suggest?q=${encodeURIComponent(query)}`);
          if (!response.ok) {
            hideSuggestions();
            return;
          }

          const data = await response.json().catch(() => ({}));
          renderSuggestions(data);
        } catch {
          hideSuggestions();
        }
      }, 300);
    });

    searchInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        hideSuggestions();
      }
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) {
        hideSuggestions();
      }
    });
  });
</script>
