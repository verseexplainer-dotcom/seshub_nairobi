---
import { Image } from 'astro:assets';
import { buildImageOnError, getSiteAssets } from '../lib/siteAssets';
import { mainShopLinks, supportLinks } from '../lib/storefront';
import type { SessionLocals } from '../lib/app-types';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const logoImage = siteAssets.logo;
const logoOnError = buildImageOnError(logoImage.fallback);
const logoWidth = 96;
const logoHeight = 96;
const locals = Astro.locals as SessionLocals;
const user = locals.user;
const isStaff = locals.isStaff;

const authLinks = user
      ? [
          { label: 'Account', href: '/account' },
          ...(isStaff ? [{ label: 'Admin', href: '/admin' }] : []),
          { label: 'Logout', href: '/api/auth/logout' }
        ]
  : [{ label: 'Sign In', href: '/auth/login' }];

const desktopLinks = [...mainShopLinks, { label: 'FAQ', href: '/faq' }];
const mobileLinks = [...mainShopLinks, ...supportLinks];
---

<header class="site-header">
  <div class="container header-shell">
    <a href="/" class="brand" aria-label="SES ICT HUB home">
      <span class="brand-mark">
        <Image
          src={logoImage.src}
          alt="SES ICT HUB logo"
          width={logoWidth}
          height={logoHeight}
          class="brand-logo"
          loading="eager"
          decoding="async"
          onerror={logoOnError}
        />
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="desktop-nav-list" role="list">
        {desktopLinks.map((link) => (
          <li><a href={link.href} class="desktop-nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="desktop-account-links">
        {authLinks.map((link) => (
          <a href={link.href} class={`account-link ${link.label === 'Logout' ? 'muted' : ''}`}>{link.label}</a>
        ))}
      </div>

      <a href="/shop" class="pill-button primary browse-cta">Browse Shop</a>

      <a href="/cart" class="cart-link" aria-label="View cart">
        <span class="cart-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="20" r="1" />
            <circle cx="18" cy="20" r="1" />
            <path d="M2.5 3h2l2.4 11.2a2 2 0 0 0 1.95 1.58h8.76a2 2 0 0 0 1.96-1.61l1.03-5.35H7.2" />
          </svg>
        </span>
        <span class="cart-label">Cart</span>
        <span id="cart-badge" class="cart-badge">0</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open site menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="3" y1="6.5" x2="21" y2="6.5"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17.5" x2="21" y2="17.5"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="container mobile-menu-inner">
      <div class="mobile-menu-block">
        <p class="mobile-menu-title">Shop</p>
        <ul class="mobile-menu-list" role="list">
          {mobileLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="mobile-menu-block">
        <p class="mobile-menu-title">Account</p>
        <ul class="mobile-menu-list" role="list">
          {authLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <a href="/shop" class="pill-button primary mobile-menu-cta">Browse Shop</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    border-bottom: 1px solid rgba(229, 231, 235, 0.86);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px);
  }

  .header-shell {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 5.35rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(4.9rem, 13vw, 7.6rem);
    height: clamp(2.95rem, 7vw, 4.35rem);
    padding: 0.1rem 0.35rem;
    border-radius: 1.2rem;
    border: 1px solid rgba(37, 99, 235, 0.12);
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 1), rgba(241, 245, 255, 0.98)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.95));
    box-shadow:
      0 12px 28px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    overflow: hidden;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(2.55);
    transform-origin: center;
    display: block;
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.3rem;
  }

  .desktop-nav-link,
  .account-link {
    color: #64748b;
    font-size: 0.94rem;
    font-weight: 800;
    transition: color 0.2s ease;
  }

  .desktop-nav-link:hover,
  .account-link:hover {
    color: var(--color-primary);
  }

  .account-link.muted {
    color: #475569;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .desktop-account-links,
  .browse-cta {
    display: none;
  }

  .desktop-account-links {
    align-items: center;
    gap: 1rem;
  }

  .cart-link,
  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border: 1px solid rgba(226, 232, 240, 0.92);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-text);
  }

  .cart-link {
    position: relative;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    font-weight: 700;
  }

  .cart-icon {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
  }

  .cart-label {
    display: none;
    font-size: 0.9rem;
  }

  .cart-badge {
    min-width: 1.3rem;
    height: 1.3rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.72rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-toggle {
    width: 3rem;
    height: 3rem;
  }

  .mobile-menu-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .mobile-menu {
    border-bottom: 1px solid rgba(229, 231, 235, 0.92);
    background: rgba(255, 255, 255, 0.98);
  }

  .mobile-menu-inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem 1.5rem;
  }

  .mobile-menu-block {
    display: grid;
    gap: 0.7rem;
  }

  .mobile-menu-title {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-menu-list {
    display: grid;
    gap: 0.15rem;
  }

  .mobile-menu-link {
    display: block;
    padding: 0.55rem 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .mobile-menu-cta {
    width: 100%;
  }

  @media (max-width: 419px) {
    .header-shell {
      min-height: 5rem;
      gap: 0.65rem;
    }

    .brand-mark {
      width: 4.45rem;
      height: 2.7rem;
      border-radius: 1rem;
    }

    .brand-logo {
      transform: scale(2.35);
    }
  }

  @media (min-width: 420px) {
    .cart-label {
      display: block;
    }
  }

  @media (min-width: 720px) {
    .header-shell {
      min-height: 5.8rem;
    }

    .brand-mark {
      width: clamp(5.8rem, 10vw, 8rem);
      height: clamp(3.2rem, 5.5vw, 4.65rem);
      border-radius: 1.35rem;
      padding-inline: 0.38rem;
    }

    .brand-logo {
      transform: scale(2.7);
    }
  }

  @media (min-width: 1080px) {
    .desktop-nav {
      display: block;
    }

    .desktop-account-links {
      display: flex;
    }

    .browse-cta {
      display: inline-flex;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .mobile-menu[hidden] {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setMenuState(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close site menu' : 'Open site menu');
    menu.hidden = !open;
  }

  function updateCartBadge() {
    const cart = JSON.parse(localStorage.getItem('ses_cart') || '[]') as Array<{ qty?: number | string }>;
    const badge = document.getElementById('cart-badge');
    if (badge) {
      const quantity = cart.reduce((total, item) => total + Number(item.qty || 0), 0);
      badge.textContent = String(quantity);
    }
  }

  if (toggle instanceof HTMLButtonElement) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setMenuState(!expanded);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuState(false);
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1080) {
      setMenuState(false);
    }
  });

  updateCartBadge();
  window.addEventListener('pageshow', updateCartBadge);
  window.addEventListener('storage', updateCartBadge);
  window.addEventListener('cart-updated', updateCartBadge);
</script>
