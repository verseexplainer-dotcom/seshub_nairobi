---
import { Image } from 'astro:assets';
import { buildImageOnError, getSiteAssets } from '../lib/siteAssets';
import { mainShopLinks, supportLinks } from '../lib/storefront';
import type { SessionLocals } from '../lib/app-types';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const logoImage = siteAssets.logo;
const logoOnError = buildImageOnError(logoImage.fallback);
const logoWidth = 96;
const logoHeight = 96;
const locals = Astro.locals as SessionLocals;
const user = locals.user;
const isStaff = locals.isStaff;

const authLinks = user
      ? [
          { label: 'Account', href: '/account' },
          ...(isStaff ? [{ label: 'Admin', href: '/admin' }] : []),
          { label: 'Logout', href: '/api/auth/logout' }
        ]
  : [{ label: 'Sign In', href: '/auth/login' }];

const desktopLinks = [...mainShopLinks, { label: 'FAQ', href: '/faq' }];
const mobileLinks = [...mainShopLinks, ...supportLinks];
const megaMenuLinks = [
  { label: 'Business laptops', href: '/category/laptops?condition=refurbished', note: 'Core i5, i7, SSD, and warranty options' },
  { label: 'Office printers', href: '/category/printers', note: 'Ink tank, laser, and setup help' },
  { label: 'Desktop setups', href: '/category/desktops', note: 'Ready for offices, shops, and schools' },
  { label: 'Accessories', href: '/search?category=accessories', note: 'Chargers, storage, bags, and cables' }
];
---

<header class="site-header">
  <div class="header-trust-bar">
    <div class="container header-trust-inner">
      <span>Tested devices</span>
      <span>Warranty included</span>
      <span>Nairobi pickup</span>
      <span>Countrywide delivery</span>
      <a href="https://wa.me/254720480475" target="_blank" rel="noreferrer">WhatsApp us</a>
    </div>
  </div>

  <div class="container header-shell">
    <a href="/" class="brand" aria-label="SES ICT HUB home">
      <span class="brand-mark">
        <Image
          src={logoImage.src}
          alt="SES ICT HUB logo"
          width={logoWidth}
          height={logoHeight}
          class="brand-logo"
          loading="eager"
          decoding="async"
          onerror={logoOnError}
        />
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="desktop-nav-list" role="list">
        <li class="nav-mega-item">
          <a href="/shop" class="desktop-nav-link">Shop</a>
          <div class="mega-menu" aria-label="Shop categories">
            <div class="mega-menu-inner">
              <p>Shop categories</p>
              <div class="mega-menu-grid">
                {megaMenuLinks.map((link) => (
                  <a href={link.href}>
                    <strong>{link.label}</strong>
                    <span>{link.note}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </li>
        {desktopLinks.map((link) => (
          <li><a href={link.href} class="desktop-nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="desktop-account-links">
        {authLinks.map((link) => (
          <a href={link.href} class={`account-link ${link.label === 'Logout' ? 'muted' : ''}`}>{link.label}</a>
        ))}
      </div>

      <form class="header-search-form" action="/search" role="search">
        <label class="sr-only" for="header-search-input">Search products</label>
        <span aria-hidden="true" class="header-search-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
        </span>
        <input
          id="header-search-input"
          type="search"
          name="q"
          placeholder="Search products"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>

      <a href="/cart" class="cart-link" aria-label="View cart">
        <span class="cart-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="20" r="1" />
            <circle cx="18" cy="20" r="1" />
            <path d="M2.5 3h2l2.4 11.2a2 2 0 0 0 1.95 1.58h8.76a2 2 0 0 0 1.96-1.61l1.03-5.35H7.2" />
          </svg>
        </span>
        <span class="cart-label">Cart</span>
        <span id="cart-badge" class="cart-badge" aria-label="Cart items">0</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open site menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="3" y1="6.5" x2="21" y2="6.5"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17.5" x2="21" y2="17.5"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="container mobile-menu-inner">
      <div class="mobile-menu-block">
        <p class="mobile-menu-title">Shop</p>
        <form class="mobile-search-form" action="/search" role="search">
          <label class="sr-only" for="mobile-search-input">Search products</label>
          <input
            id="mobile-search-input"
            type="search"
            name="q"
            placeholder="Search products"
            autocomplete="off"
          />
          <button type="submit">Search</button>
        </form>
        <ul class="mobile-menu-list" role="list">
          {mobileLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="mobile-menu-block">
        <p class="mobile-menu-title">Account</p>
        <ul class="mobile-menu-list" role="list">
          {authLinks.map((link) => (
            <li><a href={link.href} class="mobile-menu-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <a href="/shop" class="pill-button primary mobile-menu-cta">Browse Shop</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    border-bottom: 1px solid rgba(229, 231, 235, 0.86);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
  }

  .header-trust-bar {
    background: #061633;
    color: #ffffff;
  }

  .header-trust-inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-height: 1.85rem;
    overflow-x: auto;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    scrollbar-width: none;
  }

  .header-trust-inner::-webkit-scrollbar {
    display: none;
  }

  .header-trust-inner span {
    flex: 0 0 auto;
  }

  .header-trust-inner span::before {
    content: "✓";
    margin-right: 0.35rem;
    color: #6ee7b7;
  }

  .header-trust-inner a {
    flex: 0 0 auto;
    margin-left: auto;
    color: #ffffff;
  }

  .header-shell {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 4.65rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(4.25rem, 11vw, 6.5rem);
    height: clamp(2.55rem, 6vw, 3.85rem);
    padding: 0.1rem 0.35rem;
    border-radius: 1.2rem;
    border: 1px solid rgba(37, 99, 235, 0.12);
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 1), rgba(241, 245, 255, 0.98)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.95));
    box-shadow:
      0 12px 28px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    overflow: hidden;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(2.55);
    transform-origin: center;
    display: block;
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.05rem;
  }

  .desktop-nav-link,
  .account-link {
    color: #64748b;
    font-size: 0.86rem;
    font-weight: 800;
    transition: color 0.2s ease;
  }

  .desktop-nav-link:hover,
  .nav-mega-item:focus-within > .desktop-nav-link,
  .nav-mega-item:hover > .desktop-nav-link,
  .account-link:hover {
    color: var(--color-primary);
  }

  .nav-mega-item {
    position: relative;
  }

  .mega-menu {
    position: absolute;
    top: calc(100% + 1rem);
    left: 50%;
    z-index: 100;
    width: min(38rem, calc(100vw - 2rem));
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.5rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .nav-mega-item:hover .mega-menu,
  .nav-mega-item:focus-within .mega-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .mega-menu-inner {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(219, 229, 243, 0.92);
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 24px 54px rgba(15, 23, 42, 0.16);
  }

  .mega-menu-inner p {
    color: var(--color-text-muted);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mega-menu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .mega-menu-grid a {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem;
    border-radius: 0.9rem;
    background: #f8fbff;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .mega-menu-grid a:hover {
    background: #eef5ff;
    transform: translateY(-1px);
  }

  .mega-menu-grid strong {
    color: var(--color-dark);
    font-size: 0.95rem;
  }

  .mega-menu-grid span {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .account-link.muted {
    color: #475569;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .desktop-account-links {
    display: none;
  }

  .desktop-account-links {
    align-items: center;
    gap: 1rem;
  }

  .header-search-form {
    display: none;
    align-items: center;
    gap: 0.45rem;
    width: clamp(12rem, 16vw, 17.5rem);
    min-height: 2.6rem;
    padding: 0.26rem 0.35rem 0.26rem 0.75rem;
    border: 1px solid rgba(203, 213, 225, 0.92);
    border-radius: 999px;
    background: rgba(248, 250, 252, 0.96);
    color: var(--color-text);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  .header-search-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: #64748b;
    flex: 0 0 auto;
  }

  .header-search-form input {
    min-width: 0;
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 0.84rem;
    font-weight: 700;
    outline: 0;
  }

  .header-search-form input::placeholder {
    color: #64748b;
  }

  .header-search-form button {
    flex: 0 0 auto;
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 850;
    cursor: pointer;
  }

  .cart-link,
  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border: 1px solid rgba(226, 232, 240, 0.92);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-text);
  }

  .cart-link {
    position: relative;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    font-weight: 700;
  }

  .cart-icon {
    display: inline-flex;
    width: 1.15rem;
    height: 1.15rem;
  }

  .cart-label {
    display: none;
    font-size: 0.9rem;
  }

  .cart-badge {
    position: absolute;
    top: -0.35rem;
    right: -0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding: 0;
    border: 2px solid #ffffff;
    border-radius: 999px;
    background: #dc2626;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1;
    box-shadow: 0 10px 18px rgba(220, 38, 38, 0.22);
    transform: scale(0);
    transform-origin: center;
    transition: transform 0.18s ease;
  }

  .cart-badge[data-has-items="true"] {
    transform: scale(1);
  }

  .mobile-menu-toggle {
    width: 3rem;
    height: 3rem;
  }

  .mobile-menu-toggle svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .mobile-menu {
    border-bottom: 1px solid rgba(229, 231, 235, 0.92);
    background: rgba(255, 255, 255, 0.98);
  }

  .mobile-menu-inner {
    display: grid;
    gap: 1.5rem;
    padding-block: 1rem 1.5rem;
  }

  .mobile-menu-block {
    display: grid;
    gap: 0.7rem;
  }

  .mobile-menu-title {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobile-search-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    align-items: center;
  }

  .mobile-search-form input {
    min-width: 0;
    min-height: 2.85rem;
    padding: 0 0.95rem;
    border: 1px solid rgba(203, 213, 225, 0.92);
    border-radius: 999px;
    background: #f8fafc;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 700;
    outline: 0;
  }

  .mobile-search-form button {
    min-height: 2.85rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 850;
  }

  .mobile-menu-list {
    display: grid;
    gap: 0.15rem;
  }

  .mobile-menu-link {
    display: block;
    padding: 0.55rem 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .mobile-menu-cta {
    width: 100%;
  }

  @media (max-width: 419px) {
    .header-shell {
      min-height: 4.55rem;
      gap: 0.65rem;
    }

    .brand-mark {
      width: 4.45rem;
      height: 2.7rem;
      border-radius: 1rem;
    }

    .brand-logo {
      transform: scale(2.35);
    }
  }

  @media (max-width: 719px) {
    .header-trust-inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.32rem 0.72rem;
      min-height: 0;
      padding-block: 0.38rem;
      overflow: visible;
      font-size: 0.58rem;
      line-height: 1.2;
      text-align: center;
    }

    .header-trust-inner a {
      margin-left: 0;
    }
  }

  @media (min-width: 420px) {
    .cart-label {
      display: block;
    }
  }

  @media (min-width: 720px) {
    .header-shell {
      min-height: 4.8rem;
    }

    .brand-mark {
      width: clamp(5rem, 9vw, 6.8rem);
      height: clamp(2.85rem, 5vw, 4rem);
      border-radius: 1.35rem;
      padding-inline: 0.38rem;
    }

    .brand-logo {
      transform: scale(2.7);
    }
  }

  @media (min-width: 1080px) {
    .desktop-nav {
      display: block;
    }

    .desktop-account-links {
      display: flex;
    }

    .header-search-form {
      display: inline-flex;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .mobile-menu[hidden] {
      display: none;
    }
  }

  @media (min-width: 1080px) and (max-width: 1199px) {
    .header-search-form {
      width: 12rem;
    }

    .header-search-form button {
      width: 2rem;
      padding: 0;
      overflow: hidden;
      color: transparent;
      position: relative;
    }

    .header-search-form button::before {
      content: "→";
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: #ffffff;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  function setMenuState(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close site menu' : 'Open site menu');
    menu.hidden = !open;
  }

  function updateCartBadge() {
    const cart = JSON.parse(localStorage.getItem('ses_cart') || '[]') as Array<{ qty?: number | string }>;
    const badge = document.getElementById('cart-badge');
    if (badge) {
      const quantity = cart.reduce((total, item) => total + Number(item.qty || 0), 0);
      badge.textContent = String(quantity);
      badge.dataset.hasItems = quantity > 0 ? 'true' : 'false';
    }
  }

  if (toggle instanceof HTMLButtonElement) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      setMenuState(!expanded);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuState(false);
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1080) {
      setMenuState(false);
    }
  });

  updateCartBadge();
  window.addEventListener('pageshow', updateCartBadge);
  window.addEventListener('storage', updateCartBadge);
  window.addEventListener('cart-updated', updateCartBadge);
</script>
