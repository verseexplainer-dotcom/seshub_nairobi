---
import Button from '../ui/Button.astro';
import { buildWhatsAppLink } from '../../lib/storefront';

const whatsappHref = buildWhatsAppLink('Hi SES ICT HUB, I need help choosing the right laptop, printer, phone, or desktop.');
---

<section class="customer-banner section">
  <div class="container">
    <div class="banner-card">
      <div class="banner-copy">
        <p class="eyebrow">Need Help Deciding?</p>
        <h2>Need help choosing the right laptop, printer, or phone?</h2>
        <p>Message us first and we will help you compare stock, specs, and delivery options before you order.</p>
      </div>

      <div class="banner-actions">
        <Button href={whatsappHref} variant="whatsapp" target="_blank" rel="noreferrer">WhatsApp Us</Button>
        <Button href="/shop" variant="ghost">Browse All Products</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .banner-card {
    display: grid;
    gap: 1rem;
    padding: clamp(1.35rem, 4vw, 2rem);
    border-radius: calc(var(--radius-card) + 0.3rem);
    background:
      radial-gradient(circle at top right, rgba(96, 165, 250, 0.22), transparent 30%),
      linear-gradient(135deg, #0f172a, #0b1220 55%, #10213f);
    color: #f8fafc;
    box-shadow: var(--shadow-lg);
  }

  .banner-copy {
    display: grid;
    gap: 0.75rem;
  }

  .eyebrow {
    color: rgba(191, 219, 254, 0.92);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .banner-copy h2 {
    color: #ffffff;
    font-size: clamp(1.8rem, 5vw, 2.9rem);
    letter-spacing: -0.05em;
  }

  .banner-copy p:last-child {
    color: rgba(226, 232, 240, 0.82);
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 920px) {
    .banner-card {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .banner-actions {
      justify-content: flex-end;
    }
  }
</style>
