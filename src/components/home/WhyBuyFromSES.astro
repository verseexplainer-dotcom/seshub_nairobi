---
import { buildWhatsAppLink } from '../../lib/storefront';

const whatsappHref = buildWhatsAppLink('Hi SES ICT HUB, I want to confirm availability before I buy.');
---

<section class="home-section why-ses" aria-labelledby="why-ses-title">
  <div class="home-container why-ses__inner">
    <div class="why-ses__copy">
      <p class="home-kicker">Before you buy</p>
      <h2 id="why-ses-title">We can help you confirm the right item.</h2>
      <p>
        Tell us your budget, the work you need to do, and the specs you prefer. One of our team will assist you on WhatsApp.
      </p>
      <a class="home-button home-button--whatsapp" href={whatsappHref} target="_blank" rel="noreferrer">
        Confirm on WhatsApp
      </a>
    </div>
    <div class="why-ses__panel" aria-label="SES ICT HUB support checklist">
      <span>What we can confirm</span>
      <ul>
        <li>Current stock and final price</li>
        <li>Warranty terms for the item</li>
        <li>Delivery or pickup timing</li>
        <li>Accessories you may need</li>
      </ul>
    </div>
  </div>
</section>
