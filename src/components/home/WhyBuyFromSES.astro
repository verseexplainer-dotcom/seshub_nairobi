---
const reasons = [
  { title: 'Warranty details', copy: 'Confirmed for each item' },
  { title: 'Nairobi pickup', copy: 'Moi Avenue shop' },
  { title: 'Tested devices', copy: 'Condition checked' },
  { title: 'Payment options', copy: 'M-PESA and eligible pay on delivery' }
];
---

<section class="why-buy" aria-label="Why shop with SES ICT HUB">
  <div class="why-buy__inner">
    {reasons.map((reason) => (
      <div class="why-buy__item">
        <strong>{reason.title}</strong>
        <span>{reason.copy}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .why-buy { background: #061633; color: #fff; }
  .why-buy__inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(calc(100% - 2 * var(--storefront-gutter)), var(--storefront-content-width)); margin-inline: auto; }
  .why-buy__item { display: grid; align-content: center; gap: 0.2rem; min-width: 0; padding: 0.9rem 0.7rem; border-bottom: 1px solid rgba(255,255,255,0.12); }
  .why-buy__item strong { font-size: 0.82rem; line-height: 1.2; }
  .why-buy__item span { color: #cbd5e1; font-size: 0.72rem; line-height: 1.3; }
  @media (min-width: 760px) {
    .why-buy__inner { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .why-buy__item { padding: 1rem 1.25rem; border-bottom: 0; border-right: 1px solid rgba(255,255,255,0.12); }
    .why-buy__item:last-child { border-right: 0; }
  }
</style>
