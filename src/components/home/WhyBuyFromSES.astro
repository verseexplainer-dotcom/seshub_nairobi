---
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { buildWhatsAppLink, storefrontDetails } from '../../lib/storefront';

const whatsappHref = buildWhatsAppLink('Hi SES ICT HUB, I would like help choosing the right product before I pay.');
const reasons = [
  'Physical Nairobi shop presence for easier coordination and pickup.',
  'Practical support before payment on WhatsApp or phone.',
  'Catalog-first stock guidance so buyers are not pushed into fake urgency.',
  'Clear KES pricing, condition labels, and warranty visibility where available.'
];
---

<section class="why-buy section">
  <div class="container why-grid">
    <div class="story-panel">
      <SectionHeading
        eyebrow="Why Buy From SES"
        title="A practical storefront built around trust, not pressure."
        description="SES ICT HUB works best when shoppers can confirm stock, compare specs, and ask questions before paying. The homepage is structured around that buying reality."
      />

      <div class="actions">
        <Button href={whatsappHref} target="_blank" rel="noreferrer">Talk to Us on WhatsApp</Button>
        <Button href="/contact" variant="ghost">Visit Contact Page</Button>
      </div>
    </div>

    <div class="detail-panel">
      <div class="detail-card">
        <h3>Physical shop</h3>
        <p>{storefrontDetails.fullLocation}</p>
      </div>
      <div class="detail-card">
        <h3>Store support</h3>
        <p>{storefrontDetails.deliverySummary}</p>
      </div>
      <div class="reason-list">
        {reasons.map((reason) => (
          <p>{reason}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    gap: 1rem;
  }

  .story-panel,
  .detail-card,
  .reason-list {
    padding: 1.25rem;
    border: 1px solid rgba(203, 213, 225, 0.72);
    border-radius: calc(var(--radius-card) + 0.1rem);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--shadow-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .detail-panel {
    display: grid;
    gap: 1rem;
  }

  .detail-card,
  .reason-list {
    display: grid;
    gap: 0.55rem;
  }

  .detail-card p,
  .reason-list p {
    color: var(--color-text-muted);
  }

  @media (min-width: 980px) {
    .why-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: start;
    }
  }
</style>
