---
import type { CatalogProduct } from '../../types/catalog';
import ProductCard from '../ui/ProductCard.astro';
import { getCatalogCategoryKey } from '../../lib/catalog';

interface Props {
  products: CatalogProduct[];
  publicSupabaseUrl?: string | undefined;
}

const { products, publicSupabaseUrl } = Astro.props as Props;
const visibleProducts = products.slice(0, 12);
const categoryLabels: Record<string, { pill: string; badge: string }> = {
  laptops: { pill: 'Laptops', badge: 'Laptop' },
  smartphones: { pill: 'Smartphones', badge: 'Smartphone' },
  printers: { pill: 'Printers', badge: 'Printer' },
  desktops: { pill: 'Desktops', badge: 'Desktop' }
};
const filterCategories = Object.keys(categoryLabels).filter((category) =>
  visibleProducts.some((product) => getCatalogCategoryKey(product) === category)
);
---

{visibleProducts.length > 0 && (
  <section class="featured-deals" aria-labelledby="featured-deals-title" data-featured-deals>
    <div class="featured-deals__inner">
      <div class="featured-deals__head">
        <div>
          <p>Featured deals</p>
          <h2 id="featured-deals-title">Deals worth checking now.</h2>
          <span>Current listed deals. Confirm availability before ordering.</span>
        </div>
        <a href="/shop?sort=featured&in_stock=1">Browse Shop</a>
      </div>

      {filterCategories.length > 1 && (
        <div class="featured-deals__filters" aria-label="Filter featured deals by category">
          <button type="button" data-deal-filter="all" aria-pressed="true">All</button>
          {filterCategories.map((category) => (
            <button type="button" data-deal-filter={category} aria-pressed="false">{categoryLabels[category]?.pill || category}</button>
          ))}
        </div>
      )}
      <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

      <div class="featured-deals__grid">
        {visibleProducts.map((product) => (
          <div class="featured-deals__item" data-deal-category={getCatalogCategoryKey(product)}>
            <span>{categoryLabels[getCatalogCategoryKey(product)]?.badge || 'Featured'}</span>
            <ProductCard product={product} publicSupabaseUrl={publicSupabaseUrl} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll('[data-featured-deals]').forEach((section) => {
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-deal-filter]'));
    const items = Array.from(section.querySelectorAll<HTMLElement>('[data-deal-category]'));
    const status = section.querySelector<HTMLElement>('[data-filter-status]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.dealFilter || 'all';
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      let visible = 0;
      items.forEach((item) => {
        item.hidden = filter !== 'all' && item.dataset.dealCategory !== filter;
        if (!item.hidden) visible += 1;
      });
      if (status) status.textContent = `Showing ${visible} ${visible === 1 ? 'deal' : 'deals'}.`;
    }));
  });
</script>

<style>
  .featured-deals {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    background: #ffffff;
  }

  .featured-deals__inner {
    display: grid;
    gap: clamp(1.4rem, 4vw, 2.25rem);
    width: min(calc(100% - 2 * var(--storefront-gutter)), var(--storefront-content-width));
    margin-inline: auto;
  }

  .featured-deals__filters { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.2rem; scrollbar-width: thin; }
  .featured-deals__filters button { flex: 0 0 auto; min-height: 2.75rem; padding: 0.6rem 1rem; border: 1px solid #cbd5e1; border-radius: 999px; background: #fff; color: #0b1220; font-weight: 800; cursor: pointer; }
  .featured-deals__filters button[aria-pressed='true'] { border-color: #155dfc; background: #155dfc; color: #fff; }
  .featured-deals__filters button:focus-visible { outline: 3px solid #36f4a4; outline-offset: 2px; }
  .featured-deals__item[hidden] { display: none; }

  .featured-deals__head {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .featured-deals__head p {
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured-deals__head h2 {
    max-width: 48rem;
    color: #0b1220;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 0.98;
  }

  .featured-deals__head span {
    display: block;
    max-width: 34rem;
    margin-top: 0.55rem;
    color: #64748b;
    font-size: 1rem;
  }

  .featured-deals__head a {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(203, 213, 225, 0.85);
    border-radius: 999px;
    color: #0b1220;
    font-weight: 900;
  }

  .featured-deals__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.85rem, 2vw, 1.25rem);
  }

  .featured-deals__item {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .featured-deals__item > span {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #061633;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 680px) {
    .featured-deals__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .featured-deals__head a {
      justify-self: end;
    }
  }

  @media (min-width: 1080px) {
    .featured-deals__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

</style>
