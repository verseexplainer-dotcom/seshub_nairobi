---
import { buildImageOnError, getSiteAssets } from '../../lib/siteAssets';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const lifestyle = siteAssets.homeLifestyle.primary;
---

<section class="lifestyle-banner" aria-labelledby="lifestyle-banner-title">
  <img
    src={lifestyle.src}
    alt="Modern office technology setup available through SES ICT HUB"
    width="1920"
    height="1080"
    loading="lazy"
    decoding="async"
    onerror={buildImageOnError(lifestyle.fallback, siteAssets.homeLifestyle.secondary.src)}
  />
  <div class="lifestyle-banner__shade" aria-hidden="true"></div>
  <div class="lifestyle-banner__copy">
    <p>SES Office Series</p>
    <h2 id="lifestyle-banner-title">Everything for a sharper work setup.</h2>
    <span>Match laptops, desktops, printers, and accessories with help from the SES ICT HUB team.</span>
    <a href="/shop?sort=featured&in_stock=1">Learn more</a>
  </div>
</section>

<style>
  .lifestyle-banner {
    position: relative;
    min-height: clamp(28rem, 58vw, 42rem);
    overflow: hidden;
    color: #ffffff;
    background: #050b16;
    isolation: isolate;
  }

  .lifestyle-banner img,
  .lifestyle-banner__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lifestyle-banner img {
    object-fit: cover;
    object-position: center right;
  }

  .lifestyle-banner__shade {
    background:
      linear-gradient(90deg, rgba(5, 11, 22, 0.9) 0%, rgba(5, 11, 22, 0.66) 42%, rgba(5, 11, 22, 0.1) 100%),
      linear-gradient(180deg, rgba(5, 11, 22, 0.16), rgba(5, 11, 22, 0.72));
  }

  .lifestyle-banner__copy {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: 0.85rem;
    width: min(100% - 2rem, 1180px);
    min-height: inherit;
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .lifestyle-banner__copy p {
    color: #b6f5d4;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lifestyle-banner__copy h2 {
    max-width: 11ch;
    color: #ffffff;
    font-size: clamp(2.7rem, 8vw, 5rem);
    line-height: 0.95;
  }

  .lifestyle-banner__copy span {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(1rem, 2vw, 1.12rem);
  }

  .lifestyle-banner__copy a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 3rem;
    margin-top: 0.35rem;
    padding: 0.85rem 1.15rem;
    border-radius: 999px;
    background: #ffffff;
    color: #061633;
    font-weight: 900;
  }

  @media (max-width: 720px) {
    .lifestyle-banner img {
      object-position: 60% center;
    }

    .lifestyle-banner__shade {
      background:
        linear-gradient(180deg, rgba(5, 11, 22, 0.08) 0%, rgba(5, 11, 22, 0.58) 46%, rgba(5, 11, 22, 0.94) 100%),
        linear-gradient(90deg, rgba(5, 11, 22, 0.48), rgba(5, 11, 22, 0.08));
    }

    .lifestyle-banner__copy {
      align-content: end;
    }
  }
</style>
