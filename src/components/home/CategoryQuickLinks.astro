---
import type { HomepageCategoryCount } from '../../types/catalog';
import CategoryCard from '../ui/CategoryCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  items: HomepageCategoryCount[];
}

const { items } = Astro.props as Props;
---

<section class="quick-links section">
  <div class="container">
    <SectionHeading
      eyebrow="Shop Faster"
      title="Jump into the categories shoppers ask for first."
      description="These counts come from the current catalog so you can move straight into the strongest parts of the store."
    />

    <div class="grid">
      {items.map((item) => (
        <CategoryCard
          title={item.label}
          description={item.description}
          count={item.count}
          href={item.href}
          accent={item.accent}
        />
      ))}
    </div>

    <!-- TODO: if a dedicated storage route is added later, switch the Storage card away from the broader Accessories destination. -->
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
