---
import type { HomepageCategoryCount } from '../../types/catalog';
import CategoryCard from '../ui/CategoryCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getSiteAssets } from '../../lib/siteAssets';

interface Props {
  items: HomepageCategoryCount[];
  publicSupabaseUrl?: string | undefined;
}

const { items, publicSupabaseUrl } = Astro.props as Props;
const siteAssets = getSiteAssets(publicSupabaseUrl);
const categoryImages = {
  Laptops: siteAssets.categoryCards.laptops.src,
  Smartphones: siteAssets.categoryCards.smartphones.src,
  Printers: siteAssets.categoryCards.printers.src,
  Desktops: siteAssets.categoryCards.desktops.src,
  Accessories: siteAssets.categoryCards.accessories.src,
  Storage: siteAssets.categoryCards.accessories.src
} as const;
---

<section class="quick-links section">
  <div class="container">
    <SectionHeading
      eyebrow="Shop Faster"
      title="Start with the four categories most shoppers ask for."
      description="Each card uses live catalog counts so visitors can move straight into the parts of the store that matter most."
    />

    <div class="grid">
      {items.map((item) => (
        <CategoryCard
          title={item.label}
          description={item.description}
          count={item.count}
          href={item.href}
          accent={item.accent}
          imageSrc={categoryImages[item.label as keyof typeof categoryImages] ?? siteAssets.categoryCards.accessories.src}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 900px;
    }
  }
</style>
