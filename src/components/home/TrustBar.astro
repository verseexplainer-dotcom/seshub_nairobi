---
const trustItems = [
  'Nairobi’s Most Preferred Laptop Store',
  'Delivery Across All 47 Counties',
  'Join 1000+ customers'
];
---

<section class="home-trust-bar" aria-label="SES ICT HUB trust highlights">
  <div class="home-trust-bar__inner">
    {trustItems.map((item) => (
      <p>{item}</p>
    ))}
  </div>
</section>

<style>
  .home-trust-bar {
    border-block: 1px solid rgba(226, 232, 240, 0.9);
    background: #ffffff;
  }

  .home-trust-bar__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem clamp(1.4rem, 4vw, 3rem);
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    padding-block: clamp(1rem, 2.5vw, 1.45rem);
    text-align: center;
  }

  .home-trust-bar p {
    color: #111827;
    font-size: clamp(0.88rem, 1.8vw, 1rem);
    font-weight: 900;
  }
</style>
