---
import type { CatalogProduct } from '../../types/catalog';
import ProductCard from '../ui/ProductCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  featured: CatalogProduct[];
  newIn: CatalogProduct[];
  bestValue: CatalogProduct[];
  premium: CatalogProduct[];
  publicSupabaseUrl?: string | undefined;
}

const { featured, newIn, bestValue, premium, publicSupabaseUrl } = Astro.props as Props;

const tabs = [
  { id: 'featured', label: 'Featured', products: featured.slice(0, 6) },
  { id: 'new-in', label: 'New In', products: newIn.slice(0, 6) },
  { id: 'best-value', label: 'Best Value', products: bestValue.slice(0, 6) },
  { id: 'premium', label: 'Premium Picks', products: premium.slice(0, 6) }
].filter((tab) => tab.products.length > 0);
---

<section class="featured-products section" data-featured-grid>
  <div class="container">
    <SectionHeading
      eyebrow="Live Inventory"
      title="Live picks from the current catalog."
      description="Each group is selected from products with live stock, clear pricing, and enough detail to compare properly."
    />

    {tabs.length > 0 ? (
      <>
        <div class="tab-shell">
          <div class="tab-copy">
            <p class="eyebrow">Browse by intent</p>
            <p>Check the current highlights here on the page.</p>
          </div>

          <div class="tab-row" role="tablist" aria-label="Homepage product groups">
          {tabs.map((tab, index) => (
            <button
              type="button"
              class={`tab-button ${index === 0 ? 'is-active' : ''}`}
              data-tab-trigger={tab.id}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`panel-${tab.id}`}
              id={`tab-${tab.id}`}
            >
              <span>{tab.label}</span>
            </button>
          ))}
          </div>
        </div>

        {tabs.map((tab, index) => (
          <div
            class={`tab-panel ${index === 0 ? 'is-active' : ''}`}
            id={`panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${tab.id}`}
            hidden={index !== 0}
            data-tab-panel={tab.id}
          >
            <div class="products-grid">
              {tab.products.map((product) => (
                <ProductCard product={product} publicSupabaseUrl={publicSupabaseUrl} />
              ))}
            </div>
          </div>
        ))}
      </>
    ) : (
      <div class="empty-state">
        <h3>Live products will appear here once catalog data is available.</h3>
      </div>
    )}
  </div>

  <script>
    const root = document.currentScript?.closest('[data-featured-grid]');
    if (root) {
      const triggers = Array.from(root.querySelectorAll('[data-tab-trigger]'));
      const panels = Array.from(root.querySelectorAll('[data-tab-panel]'));

      const activate = (tabId: string | null) => {
        if (!tabId) {
          return;
        }

        triggers.forEach((trigger) => {
          const isActive = trigger.getAttribute('data-tab-trigger') === tabId;
          trigger.classList.toggle('is-active', isActive);
          trigger.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const isActive = panel.getAttribute('data-tab-panel') === tabId;
          panel.classList.toggle('is-active', isActive);
          panel.toggleAttribute('hidden', !isActive);
        });
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => activate(trigger.getAttribute('data-tab-trigger')));
      });
    }
  </script>
</section>

<style>
  .tab-shell {
    display: grid;
    gap: 0.8rem;
    margin-bottom: 1.25rem;
  }

  .tab-copy {
    display: grid;
    gap: 0.3rem;
  }

  .tab-copy .eyebrow {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .tab-copy p:last-child {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 42rem;
  }

  .tab-row {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    scrollbar-width: none;
  }

  .tab-row::-webkit-scrollbar {
    display: none;
  }

  .tab-button {
    flex: 0 0 auto;
    min-height: 2.95rem;
    min-width: clamp(7rem, 22vw, 9.5rem);
    padding: 0.72rem 1rem;
    border: 1px solid rgba(203, 213, 225, 0.82);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-text-soft);
    font-size: 0.92rem;
    font-weight: 800;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .tab-button.is-active {
    border-color: rgba(21, 93, 252, 0.24);
    background: linear-gradient(135deg, rgba(21, 93, 252, 0.14), rgba(8, 145, 178, 0.08));
    color: var(--color-primary-strong);
    box-shadow: 0 10px 24px rgba(21, 93, 252, 0.12);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .empty-state {
    padding: 1.2rem;
    border-radius: var(--radius-card);
    border: 1px solid rgba(203, 213, 225, 0.7);
    background: rgba(248, 250, 252, 0.82);
  }

  @media (min-width: 740px) {
    .tab-shell {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .tab-row {
      justify-content: flex-end;
    }
  }

  @media (min-width: 1120px) {
    .products-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
