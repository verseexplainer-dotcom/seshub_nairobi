---
import Button from '../ui/Button.astro';
import { buildWhatsAppLink, storefrontDetails } from '../../lib/storefront';
import { buildImageOnError, getSiteAssets } from '../../lib/siteAssets';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const whatsappHref = buildWhatsAppLink('Hi SES ICT HUB, I want to confirm cash on delivery, pickup, or delivery options before I order.');

const trustSignals = [
  {
    title: 'Cash on delivery',
    detail: 'Eligible Nairobi orders',
    image: siteAssets.campaigns.cashOnDelivery,
    onError: buildImageOnError(siteAssets.trustIcons.payments.src, siteAssets.hero.fallback),
    featured: true
  },
  {
    title: 'Visa support',
    detail: 'Card transfer options',
    image: siteAssets.paymentMarks.visa,
    onError: buildImageOnError(siteAssets.trustIcons.payments.src, siteAssets.hero.fallback)
  },
  {
    title: 'Mastercard ready',
    detail: 'Secure card payments',
    image: siteAssets.paymentMarks.mastercard,
    onError: buildImageOnError(siteAssets.trustIcons.payments.src, siteAssets.hero.fallback)
  },
  {
    title: 'Pickup and delivery',
    detail: 'Moi Avenue and Nairobi support',
    image: siteAssets.trustIcons.delivery,
    onError: buildImageOnError(siteAssets.trustIcons.security.src, siteAssets.hero.fallback)
  }
];
---

<section class="home-assurance" aria-label="Payment and delivery trust">
  <div class="container">
    <div class="assurance-strip">
      <div class="strip-copy">
        <p class="strip-kicker">Payment and delivery trust</p>
        <p class="strip-title">
          {storefrontDetails.paymentSummary} {storefrontDetails.deliverySummary}
        </p>
      </div>

      <div class="signal-row" aria-label="Trust signals">
        {trustSignals.map((item) => (
          <article class={`signal-card ${item.featured ? 'featured' : ''}`.trim()}>
            <span class="signal-media" aria-hidden="true">
              <img src={item.image.src} alt="" loading="lazy" decoding="async" onerror={item.onError} />
            </span>
            <span class="signal-copy">
              <strong>{item.title}</strong>
              <small>{item.detail}</small>
            </span>
          </article>
        ))}
      </div>

      <div class="strip-actions">
        <Button href={whatsappHref} variant="whatsapp" target="_blank" rel="noreferrer">
          Confirm on WhatsApp
        </Button>
        <a href="/faq" class="strip-link">Delivery and payment FAQ</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-assurance {
    padding: 0 0 clamp(1.3rem, 3.6vw, 2rem);
  }

  .assurance-strip {
    display: grid;
    gap: 1rem;
    padding: clamp(0.95rem, 2vw, 1.2rem);
    border: 1px solid rgba(191, 219, 254, 0.74);
    border-radius: calc(var(--radius-card) + 0.15rem);
    background:
      radial-gradient(circle at top left, rgba(191, 219, 254, 0.32), transparent 32%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
    box-shadow: var(--shadow-md);
  }

  .strip-copy {
    display: grid;
    gap: 0.35rem;
    max-width: 52rem;
  }

  .strip-kicker {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .strip-title {
    color: var(--color-text);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.55;
  }

  .signal-row {
    display: flex;
    gap: 0.7rem;
    overflow-x: auto;
    padding-bottom: 0.1rem;
    scrollbar-width: none;
  }

  .signal-row::-webkit-scrollbar {
    display: none;
  }

  .signal-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 11.2rem;
    padding: 0.78rem 0.88rem;
    border: 1px solid rgba(203, 213, 225, 0.78);
    border-radius: 1.05rem;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-sm);
  }

  .signal-card.featured {
    min-width: 13.4rem;
    border-color: rgba(21, 93, 252, 0.18);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.94)),
      linear-gradient(135deg, rgba(21, 93, 252, 0.06), rgba(8, 145, 178, 0.1));
  }

  .signal-media {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    min-width: 3.2rem;
    height: 2.55rem;
    overflow: hidden;
    border-radius: 0.95rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.96));
    border: 1px solid rgba(219, 234, 254, 0.88);
  }

  .signal-card.featured .signal-media {
    width: 4rem;
    min-width: 4rem;
  }

  .signal-media img {
    width: calc(100% - 0.7rem);
    height: calc(100% - 0.7rem);
    object-fit: contain;
  }

  .signal-copy {
    display: grid;
    gap: 0.15rem;
  }

  .signal-copy strong {
    font-size: 0.9rem;
    letter-spacing: -0.03em;
  }

  .signal-copy small {
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .strip-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  .strip-link {
    color: var(--color-primary-strong);
    font-size: 0.9rem;
    font-weight: 800;
  }

  @media (min-width: 1100px) {
    .assurance-strip {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 1.1rem;
    }

    .signal-row {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
    }

    .signal-card,
    .signal-card.featured {
      min-width: 0;
    }

    .strip-copy {
      grid-column: 1;
      grid-row: 1;
    }

    .strip-actions {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      justify-self: end;
      align-self: center;
    }
  }

  @media (min-width: 1100px) and (max-width: 1320px) {
    .signal-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1321px) {
    .strip-actions {
      min-width: 16rem;
    }
  }
</style>
