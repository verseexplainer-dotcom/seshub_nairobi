---
import SectionHeading from '../ui/SectionHeading.astro';
import TrustCard from '../ui/TrustCard.astro';

const items = [
  {
    icon: 'shield' as const,
    title: 'Warranty on listed products',
    description: 'We only show warranty where it actually exists in the catalog.'
  },
  {
    icon: 'check' as const,
    title: 'Tested and ready to use',
    description: 'We list devices with details we can confirm before you buy.'
  },
  {
    icon: 'price' as const,
    title: 'Clear pricing',
    description: 'Current KES pricing, visible discounts, and no fake countdown tactics.'
  },
  {
    icon: 'map' as const,
    title: 'Nairobi physical location',
    description: 'You can coordinate pickup and support from the Moi Avenue shop.'
  },
  {
    icon: 'chat' as const,
    title: 'WhatsApp support',
    description: 'If you need help before you buy, message us on WhatsApp and one of our team will assist you.'
  },
  {
    icon: 'truck' as const,
    title: 'Delivery options',
    description: 'Pickup and delivery options stay visible before you buy.'
  }
];
---

<section class="trust-highlights section">
  <div class="container">
    <SectionHeading
      eyebrow="Why Shoppers Trust Us"
      title="Built for fast decisions, clear stock checks, and real support."
      description="Everything here is meant to help you compare options, confirm stock, and buy with confidence."
    />

    <div class="grid">
      {items.map((item) => (
        <TrustCard {...item} />
      ))}
    </div>
  </div>
</section>

<style>
  .trust-highlights {
    background: linear-gradient(180deg, rgba(248, 250, 252, 0.86), rgba(255, 255, 255, 1));
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1120px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
