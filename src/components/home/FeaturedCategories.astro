---
import { buildImageOnError, getSiteAssets } from '../../lib/siteAssets';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const fallbackImage = '/product-placeholder.svg';

const categories = [
  {
    title: 'Laptops',
    href: '/category/laptops',
    image: siteAssets.categoryCards.laptops,
    alt: 'Laptop category at SES ICT HUB'
  },
  {
    title: 'Printers',
    href: '/category/printers',
    image: siteAssets.categoryCards.printers,
    alt: 'Printer category at SES ICT HUB'
  },
  {
    title: 'Smartphones',
    href: '/category/smartphones',
    image: siteAssets.categoryCards.smartphones,
    alt: 'Smartphone category at SES ICT HUB'
  },
  {
    title: 'Desktops',
    href: '/category/desktops',
    image: siteAssets.categoryCards.desktops,
    alt: 'Desktop category at SES ICT HUB'
  }
];
---

<section class="category-strip" aria-labelledby="category-strip-title">
  <div class="category-strip__inner">
    <div class="category-strip__head">
      <p>Shop faster</p>
      <h2 id="category-strip-title">Start by category.</h2>
    </div>

    <div class="category-strip__scroller" aria-label="Featured categories">
      {categories.map((category) => (
        <a href={category.href} class="category-strip__item">
          <span class="category-strip__media">
            <img
              src={category.image.src}
              alt={category.alt}
              width="700"
              height="700"
              loading="lazy"
              decoding="async"
              onerror={buildImageOnError(category.image.fallback, fallbackImage)}
            />
          </span>
          <span>{category.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .category-strip {
    background: #f8fafc;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .category-strip__inner {
    display: grid;
    gap: 1rem;
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
  }

  .category-strip__head {
    display: grid;
    gap: 0.25rem;
    text-align: center;
  }

  .category-strip__head p {
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .category-strip__head h2 {
    color: #0b1220;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .category-strip__scroller {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    justify-content: center;
    overflow-x: auto;
    padding: 0.4rem 0.2rem 0.7rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .category-strip__scroller::-webkit-scrollbar {
    display: none;
  }

  .category-strip__item {
    display: grid;
    flex: 0 0 7.5rem;
    justify-items: center;
    gap: 0.65rem;
    color: #0f172a;
    font-weight: 900;
    text-align: center;
    scroll-snap-align: center;
  }

  .category-strip__media {
    display: grid;
    place-items: center;
    width: clamp(5.8rem, 14vw, 7.5rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid #ffffff;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.11);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .category-strip__item:hover .category-strip__media {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(15, 23, 42, 0.15);
  }

  .category-strip__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 680px) {
    .category-strip__head {
      text-align: left;
    }

    .category-strip__scroller {
      justify-content: flex-start;
      margin-inline: -1rem;
      padding-inline: 1rem;
    }
  }
</style>
