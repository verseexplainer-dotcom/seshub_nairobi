---
import type { CatalogProduct } from '../../types/catalog';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import PriceBlock from '../ui/PriceBlock.astro';
import SpecChips from '../ui/SpecChips.astro';
import HeroSearch from './HeroSearch.astro';
import { getConditionLabel } from '../../lib/catalog';
import { getPrimaryImage } from '../../lib/images';
import { buildWhatsAppLink } from '../../lib/storefront';
import { getSiteAssets } from '../../lib/siteAssets';

interface Props {
  products: CatalogProduct[];
  liveCount: number;
  brandCount: number;
  publicSupabaseUrl?: string | undefined;
}

const { products, liveCount, brandCount, publicSupabaseUrl } = Astro.props as Props;
const spotlight = products[0] || null;
const highlights = products.slice(1, 4);
const siteAssets = getSiteAssets(publicSupabaseUrl);
const spotlightImage = spotlight ? getPrimaryImage(spotlight, { publicSupabaseUrl }) : siteAssets.heroMoments.primary.src;
const highlightCards = highlights.map((product) => ({
  product,
  imageSource: getPrimaryImage(product, { publicSupabaseUrl })
}));
const imageOnError = "this.closest('[data-product-media]')?.classList.add('no-image');this.remove();";
const whatsappHref = buildWhatsAppLink('Hi SES ICT HUB, I need help choosing the right laptop, printer, desktop, or phone.');
---

<section class="hero-showcase">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">Exclusive SES ICT HUB picks</p>
      <h1>Affordable tech ready to order in Kenya.</h1>
      <p class="hero-text">
        Shop laptops, printers, phones, desktops, and accessories with clear specs, live stock, and WhatsApp support.
      </p>

      <HeroSearch publicSupabaseUrl={publicSupabaseUrl} />

      <div class="hero-actions">
        <Button href="/shop">Shop Now</Button>
        <Button href={whatsappHref} variant="ghost" target="_blank" rel="noreferrer">WhatsApp Us</Button>
      </div>

      <div class="hero-stats" aria-label="Store highlights">
        <div>
          <strong>{liveCount}</strong>
          <span>Live products</span>
        </div>
        <div>
          <strong>{brandCount}</strong>
          <span>Active brands</span>
        </div>
        <div>
          <strong>30</strong>
          <span>Day support</span>
        </div>
      </div>
    </div>

    <div class="hero-product" aria-label="Featured product">
      <div class="hero-price-badge">
        <span>From</span>
        <strong>KSh</strong>
      </div>

      <a
        href={spotlight ? `/product/${spotlight.slug}` : '/shop'}
        class={`hero-product-media ${spotlightImage ? '' : 'no-image'}`}
        data-product-media
        aria-label={spotlight ? `View ${spotlight.title}` : 'Browse SES ICT HUB products'}
      >
        {spotlightImage && (
          <img
            src={spotlightImage}
            alt={spotlight?.title || 'SES ICT HUB electronics showcase'}
            loading="eager"
            decoding="async"
            onerror={imageOnError}
          />
        )}
      </a>

      {spotlight && (
        <div class="hero-product-copy">
          <div class="spotlight-badges">
            {getConditionLabel(spotlight) && (
              <Badge tone={getConditionLabel(spotlight) === 'Brand New' ? 'primary' : 'warning'}>
                {getConditionLabel(spotlight)}
              </Badge>
            )}
            <Badge tone="success">Live Stock</Badge>
          </div>
          <h2><a href={`/product/${spotlight.slug}`}>{spotlight.title}</a></h2>
          <SpecChips product={spotlight} />
          <PriceBlock product={spotlight} />
        </div>
      )}
    </div>
  </div>

  {highlightCards.length > 0 && (
    <div class="container hero-highlight-row" aria-label="Popular products">
      {highlightCards.map(({ product, imageSource }) => (
        <a href={`/product/${product.slug}`} class="hero-mini-product">
          <span class={`mini-product-media ${imageSource ? '' : 'no-image'}`} data-product-media>
            {imageSource && (
              <img
                src={imageSource}
                alt=""
                loading="lazy"
                decoding="async"
                onerror={imageOnError}
              />
            )}
          </span>
          <span class="mini-product-copy">
            <span>{product.category}</span>
            <strong>{product.title}</strong>
          </span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .hero-showcase {
    overflow: hidden;
    padding: clamp(1.35rem, 3vw, 2rem) 0 clamp(1.75rem, 4vw, 3rem);
    background: #3496e7;
    color: #ffffff;
  }

  .hero-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    min-height: clamp(37rem, 75svh, 48rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1rem;
    max-width: 37rem;
  }

  .hero-kicker {
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 11ch;
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.65rem, 8vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .hero-text {
    max-width: 35rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 2.2vw, 1.18rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-actions :global(.ui-button.primary) {
    background: #ef3f3f;
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(127, 29, 29, 0.2);
  }

  .hero-actions :global(.ui-button.ghost) {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    max-width: 31rem;
  }

  .hero-stats div {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.36);
  }

  .hero-stats strong {
    color: #ffffff;
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1;
  }

  .hero-stats span {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .hero-product {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: center;
  }

  .hero-price-badge {
    position: absolute;
    top: 0;
    right: min(4vw, 1.25rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 5.75rem;
    height: 5.75rem;
    border: 2px solid rgba(255, 255, 255, 0.84);
    border-radius: 50%;
    background: #ffffff;
    color: #ef3f3f;
    box-shadow: 0 18px 40px rgba(29, 78, 216, 0.24);
  }

  .hero-price-badge span {
    color: #64748b;
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-price-badge strong {
    font-size: 1rem;
  }

  .hero-product-media {
    display: grid;
    place-items: center;
    width: min(100%, 33rem);
    aspect-ratio: 1 / 0.88;
  }

  .hero-product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 32px 34px rgba(15, 23, 42, 0.26));
    animation: heroProductIn 720ms ease both;
  }

  .hero-product-media.no-image::after,
  .mini-product-media.no-image::after {
    content: 'Photo unavailable';
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .hero-product-copy {
    display: grid;
    gap: 0.65rem;
    width: min(100%, 28rem);
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0.7rem;
    background: rgba(255, 255, 255, 0.94);
    color: var(--color-text);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.14);
  }

  .spotlight-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hero-product-copy h2 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.15rem, 3vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .hero-highlight-row {
    display: grid;
    gap: 0.9rem;
    margin-top: -0.5rem;
  }

  .hero-mini-product {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    min-height: 6rem;
    padding: 0.75rem;
    border-radius: 0.65rem;
    background: #ffffff;
    color: var(--color-text);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.12);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .hero-mini-product:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px rgba(15, 23, 42, 0.16);
  }

  .mini-product-media {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border-radius: 0.55rem;
    background: #f1f5f9;
  }

  .mini-product-media img {
    width: 100%;
    height: 100%;
    padding: 0.45rem;
    object-fit: contain;
  }

  .mini-product-media.no-image::after {
    color: var(--color-text-muted);
    font-size: 0.62rem;
    text-align: center;
  }

  .mini-product-copy {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .mini-product-copy span {
    color: #ef3f3f;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mini-product-copy strong {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  @keyframes heroProductIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(27rem, 1.05fr);
    }

    .hero-highlight-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: -2rem;
    }
  }

  @media (max-width: 899px) {
    .hero-showcase {
      padding-top: 1rem;
    }

    .hero-grid {
      min-height: auto;
    }

    .hero-copy h1 {
      max-width: 12ch;
    }

    .hero-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-product {
      justify-items: stretch;
    }

    .hero-price-badge {
      width: 4.75rem;
      height: 4.75rem;
    }
  }
</style>
