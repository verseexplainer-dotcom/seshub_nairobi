---
import type { CatalogProduct } from '../../types/catalog';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import PriceBlock from '../ui/PriceBlock.astro';
import SpecChips from '../ui/SpecChips.astro';
import HeroSearch from './HeroSearch.astro';
import { getConditionLabel } from '../../lib/catalog';
import { getPrimaryImage } from '../../lib/images';
import { buildWhatsAppLink } from '../../lib/storefront';
import { getSiteAssets } from '../../lib/siteAssets';

interface Props {
  products: CatalogProduct[];
  liveCount: number;
  brandCount: number;
  publicSupabaseUrl?: string | undefined;
}

const { products, liveCount, brandCount, publicSupabaseUrl } = Astro.props as Props;
const spotlight = products[0] || null;
const supportCards = products.slice(1, 4);
const siteAssets = getSiteAssets(publicSupabaseUrl);
const spotlightImage = spotlight ? getPrimaryImage(spotlight, { publicSupabaseUrl }) : siteAssets.heroMoments.primary.src;
const supportImages = supportCards.map((product, index) => ({
  product,
  imageSource: getPrimaryImage(product, { publicSupabaseUrl }),
  label: index === 0 ? 'Best pick' : index === 1 ? 'New arrival' : 'Customer choice'
}));
const imageOnError = "this.closest('[data-product-media]')?.classList.add('no-image');this.remove();";
const whatsappHref = buildWhatsAppLink('Hi SES ICT HUB, I need help choosing the right laptop, printer, desktop, or phone.');
---

<section class="hero-showcase">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">SES ICT HUB / Nairobi electronics shop</p>
      <h1>Laptops, phones, printers, and desktops ready to order.</h1>
      <p class="hero-text">
        Clear prices, live stock, and help from our team when you need to confirm before you buy.
      </p>

      <HeroSearch />

      <div class="hero-actions">
        <Button href="/shop">Browse Shop</Button>
        <Button href={whatsappHref} variant="ghost" target="_blank" rel="noreferrer">Confirm on WhatsApp</Button>
      </div>

      <div class="hero-metrics" aria-label="Store highlights">
        <div>
          <strong>{liveCount}</strong>
          <span>Live products</span>
        </div>
        <div>
          <strong>{brandCount}</strong>
          <span>Brands listed</span>
        </div>
        <div>
          <strong>Moi Ave</strong>
          <span>Pickup available</span>
        </div>
      </div>
    </div>

    <div class="hero-visual" aria-label="Featured product showcase">
      <div class="hero-panel">
        <div class="hero-panel-top">
          <Badge tone="primary">Featured today</Badge>
          {spotlight && (
            <span class="hero-panel-stock">
              {getConditionLabel(spotlight) || 'Live stock'}
            </span>
          )}
        </div>

        <a
          href={spotlight ? `/product/${spotlight.slug}` : '/shop'}
          class={`hero-product-media ${spotlightImage ? '' : 'no-image'}`}
          data-product-media
          aria-label={spotlight ? `View ${spotlight.title}` : 'Browse SES ICT HUB products'}
        >
          {spotlightImage && (
            <img
              src={spotlightImage}
              alt={spotlight?.title || 'SES ICT HUB electronics showcase'}
              loading="eager"
              decoding="async"
              onerror={imageOnError}
            />
          )}
        </a>

        {spotlight && (
          <div class="hero-product-copy">
            <div class="spotlight-badges">
              {getConditionLabel(spotlight) && (
                <Badge tone={getConditionLabel(spotlight) === 'Brand New' ? 'primary' : 'warning'}>
                  {getConditionLabel(spotlight)}
                </Badge>
              )}
              <Badge tone="success">Live stock</Badge>
            </div>
            <h2><a href={`/product/${spotlight.slug}`}>{spotlight.title}</a></h2>
            <SpecChips product={spotlight} />
            <PriceBlock product={spotlight} />
          </div>
        )}
      </div>

      {supportImages.length > 0 && (
        <div class="hero-support-row" aria-label="Other highlighted products">
          {supportImages.map(({ product, imageSource, label }) => (
            <a href={`/product/${product.slug}`} class="hero-support-card">
              <span class="support-card-media" aria-hidden="true">
                {imageSource ? (
                  <img
                    src={imageSource}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    onerror={imageOnError}
                  />
                ) : (
                  <span class="support-card-empty">Photo unavailable</span>
                )}
              </span>
              <span class="support-card-copy">
                <span>{label}</span>
                <strong>{product.title}</strong>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-showcase {
    overflow: hidden;
    padding: clamp(1rem, 2.5vw, 1.75rem) 0 clamp(1.75rem, 4vw, 3rem);
    background:
      radial-gradient(circle at 10% 10%, rgba(21, 93, 252, 0.08), transparent 28%),
      radial-gradient(circle at 90% 0%, rgba(8, 145, 178, 0.1), transparent 24%),
      linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  }

  .hero-grid {
    display: grid;
    gap: clamp(1.4rem, 3.5vw, 2.4rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }

  .hero-kicker {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    margin: 0;
    color: var(--color-dark);
    font-size: clamp(2.4rem, 6.4vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    max-width: 11ch;
  }

  .hero-text {
    margin: 0;
    max-width: 38rem;
    color: var(--color-text-soft);
    font-size: clamp(1rem, 2vw, 1.1rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 34rem;
  }

  .hero-metrics div {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid rgba(203, 213, 225, 0.85);
  }

  .hero-metrics strong {
    color: var(--color-dark);
    font-size: clamp(1.1rem, 3vw, 1.55rem);
    line-height: 1;
  }

  .hero-metrics span {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .hero-visual {
    display: grid;
    gap: 0.9rem;
  }

  .hero-panel {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(191, 219, 254, 0.76);
    border-radius: calc(var(--radius-card) + 0.15rem);
    background:
      radial-gradient(circle at top right, rgba(21, 93, 252, 0.12), transparent 36%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(243, 247, 255, 0.96));
    box-shadow: 0 20px 48px rgba(15, 23, 42, 0.08);
  }

  .hero-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .hero-panel-stock {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .hero-product-media {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 0.84;
    overflow: hidden;
    border-radius: 1.2rem;
    background:
      radial-gradient(circle at top center, rgba(255, 255, 255, 1), rgba(238, 244, 255, 0.94)),
      linear-gradient(180deg, rgba(248, 250, 252, 1), rgba(241, 245, 249, 0.94));
  }

  .hero-product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    filter: drop-shadow(0 26px 28px rgba(15, 23, 42, 0.18));
    animation: heroProductIn 700ms ease both;
  }

  .hero-product-media.no-image::after {
    content: 'Photo unavailable';
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .support-card-empty {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    text-align: center;
  }

  .hero-product-copy {
    display: grid;
    gap: 0.7rem;
    padding: 0.2rem 0.1rem 0 0.1rem;
  }

  .spotlight-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hero-product-copy h2 {
    margin: 0;
    color: var(--color-dark);
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .hero-support-row {
    display: grid;
    gap: 0.8rem;
  }

  .hero-support-card {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    min-height: 5.6rem;
    padding: 0.7rem;
    border: 1px solid rgba(203, 213, 225, 0.84);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .hero-support-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(21, 93, 252, 0.2);
  }

  .support-card-media {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.85rem;
    background: linear-gradient(180deg, rgba(248, 250, 252, 1), rgba(238, 244, 255, 0.92));
  }

  .support-card-media img {
    width: 100%;
    height: 100%;
    padding: 0.45rem;
    object-fit: contain;
  }

  .support-card-copy {
    display: grid;
    gap: 0.22rem;
    min-width: 0;
  }

  .support-card-copy span {
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .support-card-copy strong {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-dark);
    font-size: 0.95rem;
    line-height: 1.3;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @keyframes heroProductIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(24rem, 1.08fr);
    }
  }

  @media (max-width: 959px) {
    .hero-copy h1 {
      max-width: 13ch;
    }

    .hero-metrics {
      max-width: none;
    }
  }

  @media (max-width: 720px) {
    .hero-copy {
      gap: 0.9rem;
    }

    .hero-copy h1 {
      font-size: clamp(2.15rem, 11vw, 3.4rem);
    }

    .hero-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
