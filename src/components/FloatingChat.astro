---
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  productSlug?: string | null;
}

const { productSlug = null } = Astro.props;
---

<aside class="floating-chat" aria-label="Quick contact options">
  <WhatsAppButton
    label="WhatsApp"
    message="Hi SES ICT HUB, I need help with this product or order."
    productSlug={productSlug}
  />
</aside>

<style>
  .floating-chat {
    position: fixed;
    right: clamp(0.8rem, 2vw, 1.35rem);
    bottom: clamp(5.4rem, 8vw, 6.4rem);
    z-index: 85;
    display: grid;
    gap: 0.55rem;
    justify-items: end;
  }

  @media (max-width: 640px) {
    .floating-chat {
      right: 0.75rem;
      bottom: 1rem;
      gap: 0.45rem;
    }

    :global(body:has(.commerce-hero) .floating-chat) {
      bottom: 4.1rem;
    }

    .floating-chat :global(strong) {
      display: none;
    }
  }
</style>
