---
interface Props {
  brand: string;
  count: number;
  href: string;
}

const { brand, count, href } = Astro.props as Props;
const initials = brand
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() || '')
  .join('');
---

<a href={href} class="brand-card" aria-label={`Browse ${brand} products`}>
  <span class="brand-mark">{initials || brand.slice(0, 1).toUpperCase()}</span>
  <div class="brand-copy">
    <strong>{brand}</strong>
    <span>{count} {count === 1 ? 'product' : 'products'}</span>
  </div>
</a>

<style>
  .brand-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 100%;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(203, 213, 225, 0.72);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .brand-card:hover {
    transform: translateY(-2px);
    border-color: rgba(21, 93, 252, 0.24);
    box-shadow: var(--shadow-md);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(21, 93, 252, 0.12), rgba(8, 145, 178, 0.18));
    color: var(--color-primary-strong);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .brand-copy {
    display: grid;
    gap: 0.2rem;
  }

  .brand-copy strong {
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .brand-copy span {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }
</style>
