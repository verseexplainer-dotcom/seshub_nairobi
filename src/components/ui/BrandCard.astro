---
import { getBrandLogoSource } from '../../lib/siteAssets';

interface Props {
  brand: string;
  count: number;
  href: string;
}

const { brand, count, href } = Astro.props as Props;
const initials = brand
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() || '')
  .join('');
const logo = getBrandLogoSource(brand, import.meta.env.PUBLIC_SUPABASE_URL);
const logoOnError = "const mark=this.closest('.brand-mark'); if(mark){mark.dataset.logoFailed='1';} this.remove();";
---

<a href={href} class="brand-card" aria-label={`Browse ${brand} products`}>
  <span class={`brand-mark ${logo ? 'with-logo' : ''}`.trim()}>
    {logo && (
      <img src={logo.src} alt={`${brand} logo`} loading="lazy" decoding="async" onerror={logoOnError} />
    )}
    <span class="brand-fallback">{initials || brand.slice(0, 1).toUpperCase()}</span>
  </span>
  <div class="brand-copy">
    <strong>{brand}</strong>
    <span>{count} {count === 1 ? 'product' : 'products'}</span>
  </div>
</a>

<style>
  .brand-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 100%;
    padding: 1rem 1.15rem;
    border: 1px solid rgba(203, 213, 225, 0.72);
    border-radius: var(--radius-card);
    background:
      radial-gradient(circle at top left, rgba(219, 234, 254, 0.48), transparent 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.94));
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .brand-card:hover {
    transform: translateY(-2px);
    border-color: rgba(21, 93, 252, 0.24);
    box-shadow: var(--shadow-md);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    min-width: 4.5rem;
    height: 3.2rem;
    overflow: hidden;
    border: 1px solid rgba(191, 219, 254, 0.75);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(239, 246, 255, 0.92)),
      linear-gradient(135deg, rgba(21, 93, 252, 0.08), rgba(8, 145, 178, 0.12));
    color: var(--color-primary-strong);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .brand-mark img {
    width: calc(100% - 1.1rem);
    height: calc(100% - 1.1rem);
    object-fit: contain;
  }

  .brand-mark.with-logo .brand-fallback {
    display: none;
  }

  .brand-mark.with-logo[data-logo-failed='1'] .brand-fallback {
    display: inline-flex;
  }

  .brand-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .brand-copy {
    display: grid;
    gap: 0.2rem;
  }

  .brand-copy strong {
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .brand-copy span {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }
</style>
