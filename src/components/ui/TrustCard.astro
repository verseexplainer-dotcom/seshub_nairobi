---
interface Props {
  icon?: 'shield' | 'check' | 'map' | 'chat' | 'truck' | 'price';
  title: string;
  description: string;
}

const { icon = 'shield', title, description } = Astro.props as Props;

const iconPaths = {
  shield: '<path d="M12 3l7 3v5c0 4.8-2.8 8.6-7 10-4.2-1.4-7-5.2-7-10V6l7-3Z"></path>',
  check: '<path d="m5 12 4 4L19 6"></path>',
  map: '<path d="M9 18 3 20V6l6-2 6 2 6-2v14l-6 2-6-2Z"></path><path d="M9 4v14"></path><path d="M15 6v14"></path>',
  chat: '<path d="M21 12a8 8 0 0 1-8 8H7l-4 2 1.5-4.5A8 8 0 1 1 21 12Z"></path>',
  truck: '<path d="M10 17h4"></path><path d="M1 5h12v10H1z"></path><path d="M13 8h4l3 3v4h-7"></path><circle cx="6" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle>',
  price: '<path d="M12 2v20"></path><path d="M17 6.5c0-1.9-2.2-3.5-5-3.5s-5 1.6-5 3.5 1.7 3 5 3 5 1.4 5 3.5-2.2 3.5-5 3.5-5-1.6-5-3.5"></path>'
} as const;
---

<article class="trust-card">
  <span class="trust-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[icon]} />
  </span>
  <div class="trust-copy">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .trust-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.95rem;
    padding: 1.1rem;
    border: 1px solid rgba(203, 213, 225, 0.7);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-sm);
  }

  .trust-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 1rem;
    background: rgba(21, 93, 252, 0.1);
    color: var(--color-primary-strong);
  }

  .trust-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .trust-copy {
    display: grid;
    gap: 0.35rem;
  }

  .trust-copy h3 {
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .trust-copy p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
</style>
