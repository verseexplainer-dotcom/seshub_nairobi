---
interface Props {
  tone?: 'neutral' | 'primary' | 'success' | 'warning' | 'danger' | 'dark';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props as Props;
---

<span class={`ui-badge ${tone} ${className}`.trim()}>
  <slot />
</span>

<style>
  .ui-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.95rem;
    padding: 0.32rem 0.72rem;
    border-radius: 999px;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .ui-badge.neutral {
    background: rgba(226, 232, 240, 0.7);
    color: #334155;
  }

  .ui-badge.primary {
    background: rgba(21, 93, 252, 0.12);
    color: var(--color-primary-strong);
  }

  .ui-badge.success {
    background: rgba(22, 163, 74, 0.12);
    color: #166534;
  }

  .ui-badge.warning {
    background: rgba(249, 115, 22, 0.14);
    color: #c2410c;
  }

  .ui-badge.danger {
    background: rgba(239, 68, 68, 0.12);
    color: #991b1b;
  }

  .ui-badge.dark {
    background: rgba(15, 23, 42, 0.9);
    color: #f8fafc;
  }
</style>
