---
interface Props {
  title: string;
  description: string;
  count: number;
  href: string;
  accent?: string;
}

const { title, description, count, href, accent = '#155dfc' } = Astro.props as Props;
---

<a href={href} class="category-card" style={`--accent:${accent}`}>
  <div class="category-copy">
    <span class="category-label">{title}</span>
    <p>{description}</p>
  </div>
  <div class="category-meta">
    <strong>{count}</strong>
    <span>{count === 1 ? 'product' : 'products'}</span>
  </div>
</a>

<style>
  .category-card {
    display: grid;
    gap: 1.1rem;
    min-height: 100%;
    padding: 1.2rem;
    border: 1px solid rgba(191, 219, 254, 0.6);
    border-radius: var(--radius-card);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.94)),
      radial-gradient(circle at top right, color-mix(in srgb, var(--accent) 18%, white), transparent 48%);
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .category-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 35%, white);
    box-shadow: var(--shadow-md);
  }

  .category-copy {
    display: grid;
    gap: 0.55rem;
  }

  .category-label {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .category-copy p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .category-meta {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: color-mix(in srgb, var(--accent) 80%, black);
  }

  .category-meta strong {
    font-size: 1.4rem;
    letter-spacing: -0.05em;
  }

  .category-meta span {
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
