---
import type { CatalogProduct } from '../../types/catalog';
import { getStockMeta } from '../../lib/productPresentation';

interface Props {
  product: CatalogProduct;
  showDetail?: boolean;
  badgeLabel?: string;
}

const { product, showDetail = false, badgeLabel = '' } = Astro.props as Props;
const stock = getStockMeta(product);
const visibleLabel = badgeLabel.trim() || stock.badge;
---

<div class="stock-shell">
  <span class={`stock-badge ${stock.tone}`}>{visibleLabel}</span>
  {showDetail && <span class={`stock-detail ${stock.tone}`}>{stock.detail}</span>}
</div>

<style>
  .stock-shell {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .stock-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.95rem;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .stock-badge.in,
  .stock-detail.in {
    background: rgba(34, 197, 94, 0.14);
    color: #166534;
  }

  .stock-badge.low,
  .stock-detail.low {
    background: rgba(250, 204, 21, 0.16);
    color: #854d0e;
  }

  .stock-badge.out,
  .stock-detail.out {
    background: rgba(239, 68, 68, 0.12);
    color: #991b1b;
  }

  .stock-detail {
    padding: 0.26rem 0.6rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
  }
</style>
