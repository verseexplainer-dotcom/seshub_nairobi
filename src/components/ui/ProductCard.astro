---
import type { CatalogProduct } from '../../types/catalog';
import Badge from './Badge.astro';
import Button from './Button.astro';
import PriceBlock from './PriceBlock.astro';
import SpecChips from './SpecChips.astro';
import { getConditionLabel } from '../../lib/catalog';
import { getPrimaryImage } from '../../lib/images';
import { hasDiscount, getSavingsPercent } from '../../lib/pricing';
import { buildWhatsAppLink } from '../../lib/storefront';
import { getRuntimeEnv } from '../../lib/runtime';
import { buildImageOnError, getSiteAssets } from '../../lib/siteAssets';
import { getWarrantyLabel, getCategoryLabel, getStockMeta } from '../../lib/productPresentation';

interface Props {
  product: CatalogProduct;
  publicSupabaseUrl?: string | undefined;
}

const { product, publicSupabaseUrl: providedPublicSupabaseUrl } = Astro.props as Props;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const publicSupabaseUrl = providedPublicSupabaseUrl;
const siteAssets = getSiteAssets(publicSupabaseUrl);
const fallbackImage = (runtimeEnv.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder.src).trim();
const finalFallback = '/product-placeholder.svg';
const imageSource = getPrimaryImage(product, {
  publicSupabaseUrl,
  fallbackImage
});
const imageOnError = buildImageOnError(fallbackImage, finalFallback);
const imageWidth = 640;
const imageHeight = 640;
const productHref = `/product/${product.slug}`;
const conditionLabel = getConditionLabel(product);
const warrantyLabel = getWarrantyLabel(product.warranty_months);
const categoryLabel = getCategoryLabel(product.category);
const stock = getStockMeta(product);
const savingsPercent = getSavingsPercent(product);
const discounted = hasDiscount(product);
const whatsappHref = buildWhatsAppLink(
  `Hi SES ICT HUB, I need help with ${product.title} - https://sesicthub.co.ke${productHref}`
);
const conditionBadge = conditionLabel === 'Brand New' ? 'New' : conditionLabel;
const prioritizedBadges = [
  discounted && savingsPercent > 0 ? { label: `Sale ${savingsPercent}%`, tone: 'success' as const } : null,
  stock.isLowStock ? { label: 'Low Stock', tone: 'warning' as const } : null,
  conditionBadge ? { label: conditionBadge, tone: conditionLabel === 'Brand New' ? 'primary' as const : 'warning' as const } : null
].filter(Boolean).slice(0, 2) as Array<{ label: string; tone: 'primary' | 'success' | 'warning' }>;
---

<article class="product-card">
  <a class="product-card__overlay" href={productHref} aria-label={`View details for ${product.title}`}></a>

  <div class="product-card__media">
    <img
      src={imageSource}
      alt={product.title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      onerror={imageOnError}
    />
    <div class="product-card__badges" aria-label="Product badges">
      {prioritizedBadges.map((badge) => (
        <Badge tone={badge.tone}>{badge.label}</Badge>
      ))}
    </div>
  </div>

  <div class="product-card__body">
    <div class="product-card__copy">
      <p class="product-card__category">{product.brand ? `${product.brand} / ${categoryLabel}` : categoryLabel}</p>
      <h3 class="product-card__title">{product.title}</h3>
      <SpecChips product={product} limit={3} />
    </div>

    <div class="product-card__footer">
      <div class="product-card__meta">
        <span class={`product-card__stock ${stock.tone}`}>
          <span class="product-card__stock-dot"></span>
          {stock.badge}
        </span>
        {warrantyLabel && <Badge tone="neutral">{warrantyLabel}</Badge>}
      </div>

      <PriceBlock product={product} compact />

      <p class={`product-card__stock-detail ${stock.tone}`}>{stock.detail}</p>

      {product.in_stock ? (
        <Button
          type="button"
          fullWidth
          class="product-card__button"
          ariaLabel={`Add ${product.title} to cart`}
          data-add-to-cart={true}
          data-id={product.id}
          data-title={product.title}
          data-price={product.price_kes}
          data-slug={product.slug}
          data-image={imageSource || ''}
          data-image-fallback={fallbackImage}
        >
          Add to Cart
        </Button>
      ) : (
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noreferrer"
          variant="whatsapp"
          fullWidth
          class="product-card__button"
          ariaLabel={`Ask on WhatsApp about ${product.title}`}
        >
          Ask on WhatsApp
        </Button>
      )}
    </div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid rgba(219, 229, 243, 0.95);
    border-radius: var(--radius-card);
    background: var(--white);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(21, 93, 252, 0.26);
  }

  .product-card:focus-within {
    border-color: rgba(21, 93, 252, 0.5);
    box-shadow: var(--focus-ring), var(--shadow-sm);
  }

  .product-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .product-card__overlay:focus-visible {
    box-shadow: inset var(--focus-ring);
  }

  .product-card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    padding: 0.9rem;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(248, 251, 255, 0.98), rgba(238, 244, 255, 0.82));
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-card__media img {
    transform: scale(1.03);
  }

  .product-card__badges {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    pointer-events: none;
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem;
  }

  .product-card__copy {
    display: grid;
    gap: 0.62rem;
  }

  .product-card__category {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card__title {
    min-height: 2.7em;
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.35;
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .product-card__footer {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
  }

  .product-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .product-card__stock {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.95rem;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .product-card__stock.in {
    background: rgba(34, 197, 94, 0.14);
    color: #166534;
  }

  .product-card__stock.low {
    background: rgba(250, 204, 21, 0.16);
    color: #854d0e;
  }

  .product-card__stock.out {
    background: rgba(239, 68, 68, 0.12);
    color: #991b1b;
  }

  .product-card__stock-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: currentColor;
    flex: none;
  }

  .product-card__stock-detail {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .product-card__stock-detail.in {
    color: #166534;
  }

  .product-card__stock-detail.low {
    color: #854d0e;
  }

  .product-card__stock-detail.out {
    color: #991b1b;
  }

  .product-card :global(.product-card__button) {
    position: relative;
    z-index: 3;
    min-height: 44px;
  }

  .product-card :global(.spec-chips) {
    max-height: 4.4rem;
    overflow: hidden;
  }

  .product-card :global(.spec-chips li) {
    min-height: 1.8rem;
    padding: 0.28rem 0.56rem;
    font-size: 0.76rem;
  }

  .product-card :global(.price-block) {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 560px) {
    .product-card__media {
      padding: 0.65rem;
    }

    .product-card__badges {
      left: 0.45rem;
      right: 0.45rem;
      top: 0.45rem;
      gap: 0.3rem;
    }

    .product-card__body {
      padding: 0.85rem;
    }

    .product-card__title {
      font-size: 0.95rem;
    }

    .product-card__badges :global(.ui-badge),
    .product-card__meta :global(.ui-badge),
    .product-card__stock {
      min-height: 1.55rem;
      padding: 0.18rem 0.52rem;
      font-size: 0.62rem;
      letter-spacing: 0.02em;
    }
  }
</style>
