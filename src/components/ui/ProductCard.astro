---
import type { CatalogProduct } from '../../types/catalog';
import Badge from './Badge.astro';
import Button from './Button.astro';
import PriceBlock from './PriceBlock.astro';
import SpecChips from './SpecChips.astro';
import StockBadge from './StockBadge.astro';
import { getConditionLabel } from '../../lib/catalog';
import { getPrimaryImage } from '../../lib/images';
import { buildWhatsAppLink } from '../../lib/storefront';
import { getRuntimeEnv } from '../../lib/runtime';
import { buildImageOnError, getSiteAssets } from '../../lib/siteAssets';
import { getWarrantyLabel, getCategoryLabel, getStockMeta } from '../../lib/productPresentation';

interface Props {
  product: CatalogProduct;
  publicSupabaseUrl?: string | undefined;
}

const { product, publicSupabaseUrl: providedPublicSupabaseUrl } = Astro.props as Props;
const runtimeEnv = getRuntimeEnv(Astro.locals);
const publicSupabaseUrl = providedPublicSupabaseUrl;
const siteAssets = getSiteAssets(publicSupabaseUrl);
const fallbackImage = (runtimeEnv.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder.src).trim();
const finalFallback = '/product-placeholder.svg';
const imageSource = getPrimaryImage(product, {
  publicSupabaseUrl,
  fallbackImage
});
const imageOnError = buildImageOnError(fallbackImage, finalFallback);
const imageWidth = 640;
const imageHeight = 640;
const productHref = `/product/${product.slug}`;
const conditionLabel = getConditionLabel(product);
const warrantyLabel = getWarrantyLabel(product.warranty_months);
const categoryLabel = getCategoryLabel(product.category);
const stock = getStockMeta(product);
const whatsappHref = buildWhatsAppLink(
  `Hi SES ICT HUB, I need help with ${product.title} - https://sesicthub.co.ke${productHref}`
);
const overlayConditionLabel = conditionLabel === 'Brand New'
  ? 'New'
  : conditionLabel;
---

<article class="product-card">
  <a href={productHref} class="media-link" aria-label={`View ${product.title}`}>
    <img
      src={imageSource}
      alt={product.title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      onerror={imageOnError}
    />
    <div class="top-row">
      <Badge tone="neutral">{categoryLabel}</Badge>
      {conditionLabel && (
        <Badge tone={conditionLabel === 'Brand New' ? 'primary' : 'warning'}>
          {overlayConditionLabel}
        </Badge>
      )}
      <StockBadge product={product} />
    </div>
  </a>

  <div class="product-body">
    <div class="copy-stack">
      <p class="eyebrow">{product.brand || 'SES ICT HUB'}</p>
      <p class="category-line">{categoryLabel}</p>
      <h3><a href={productHref}>{product.title}</a></h3>
      <SpecChips product={product} />
    </div>

    <div class="card-footer">
      <div class="detail-row">
        {warrantyLabel && <Badge tone="neutral">{warrantyLabel}</Badge>}
      </div>

      <PriceBlock product={product} compact />

      <p class={`stock-line ${stock.tone}`}>
        <span class="stock-dot"></span>
        {stock.detail}
      </p>

      {product.in_stock ? (
        <Button
          type="button"
          fullWidth
          data-add-to-cart={true}
          data-id={product.id}
          data-title={product.title}
          data-price={product.price_kes}
          data-slug={product.slug}
          data-image={imageSource || ''}
          data-image-fallback={fallbackImage}
        >
          Add to Cart
        </Button>
      ) : (
        <Button href={whatsappHref} target="_blank" rel="noreferrer" variant="whatsapp" fullWidth>
          Ask on WhatsApp
        </Button>
      )}
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid rgba(203, 213, 225, 0.82);
    border-radius: 1.15rem;
    background:
      radial-gradient(circle at top right, rgba(191, 219, 254, 0.54), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96));
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(21, 93, 252, 0.26);
  }

  .media-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    padding: 1rem;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.72), transparent 30%),
      linear-gradient(180deg, rgba(247, 250, 252, 0.98), rgba(241, 245, 249, 0.97));
  }

  .media-link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .media-link.no-image::after {
    content: 'Photo unavailable';
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product-card:hover .media-link img {
    transform: scale(1.03);
  }

  .top-row,
  .deal-chip {
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .top-row {
    top: 0.85rem;
    justify-content: space-between;
  }

  .product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.95rem;
    padding: 1rem;
  }

  .copy-stack {
    display: grid;
    gap: 0.7rem;
  }

  .eyebrow {
    color: var(--color-text-soft);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .category-line {
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .copy-stack h3 {
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .copy-stack h3 a {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .copy-stack h3 a:hover {
    color: var(--color-primary);
  }

  .card-footer {
    display: grid;
    gap: 0.85rem;
    margin-top: auto;
  }

  .detail-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .stock-line {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .stock-line.in {
    color: #166534;
  }

  .stock-line.low {
    color: #854d0e;
  }

  .stock-line.out {
    color: #991b1b;
  }

  .stock-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: currentColor;
    flex: none;
  }

  @media (max-width: 560px) {
    .media-link {
      padding: 0.65rem;
    }

    .top-row,
    .deal-chip {
      left: 0.45rem;
      right: 0.45rem;
    }

    .top-row {
      top: 0.45rem;
      gap: 0.3rem;
    }

    .top-row :global(.ui-badge),
    .deal-chip :global(.ui-badge),
    .top-row :global(.stock-badge) {
      min-height: 1.55rem;
      padding: 0.18rem 0.52rem;
      font-size: 0.62rem;
      letter-spacing: 0.02em;
    }
  }
</style>
