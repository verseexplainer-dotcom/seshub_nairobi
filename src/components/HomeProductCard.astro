---
import { buildImageOnError, getSiteAssets } from '../lib/siteAssets';
import { buildWhatsAppLink } from '../lib/storefront';
import { getPrimaryImage } from '../lib/images';
import {
  formatKES,
  getAvailabilityLabel,
  getProductBadge,
  getProductBadgeTone,
  getProductBrand
} from '../lib/productPresentation';

interface Props {
  product: any;
  context?: 'arrival' | 'seller' | 'default';
  index?: number;
  tone?: 'light' | 'contrast';
}

const { product, context = 'default', index = 0, tone = 'light' } = Astro.props as Props;

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const finalFallbackImage = (import.meta.env.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder.src).trim();
const imageSource = getPrimaryImage(product, {
  publicSupabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL,
  fallbackImage: finalFallbackImage
});
const imageOnError = buildImageOnError(finalFallbackImage, finalFallbackImage);
const badge = getProductBadge(product, context, index);
const badgeTone = badge ? getProductBadgeTone(badge) : '';
const brandLabel = getProductBrand(product);
const availabilityLabel = getAvailabilityLabel(product);
const whatsappHref = buildWhatsAppLink(`Hi SES ICT HUB, I'm interested in: ${product.title} — https://sesicthub.co.ke/product/${product.slug}`);
const productHref = `/product/${product.slug}`;
---

<article class={`home-product-card ${tone === 'contrast' ? 'contrast' : ''}`}>
  <a href={productHref} class="home-product-media" aria-label={`View ${product.title}`}>
    {badge && <span class={`product-badge-chip ${badgeTone}`}>{badge}</span>}
    <img src={imageSource} alt={product.title} loading="lazy" decoding="async" onerror={imageOnError} />
  </a>

  <div class="home-product-body">
    <div class="home-product-copy">
      {brandLabel && <p class="home-product-brand">{brandLabel}</p>}
      <h3><a href={productHref}>{product.title}</a></h3>
      <p class="home-product-specs">{availabilityLabel}</p>
    </div>

    <div class="home-product-price-row">
      <div class="home-product-price-stack">
        <strong>{formatKES(product.price_kes)}</strong>
        {Number(product.compare_at_kes || 0) > Number(product.price_kes || 0) && <span>{formatKES(product.compare_at_kes)}</span>}
      </div>
      <a href={whatsappHref} class="home-product-link" target="_blank" rel="noopener noreferrer">Ask first</a>
    </div>

    <button
      type="button"
      class="pill-button primary home-product-button"
      data-add-to-cart
      data-id={product.id}
      data-title={product.title}
      data-price={product.price_kes}
      data-slug={product.slug}
      data-image={imageSource}
      data-image-fallback={finalFallbackImage}
    >
      Add to cart
    </button>
  </div>
</article>

<style>
  .home-product-card {
    position: relative;
    display: grid;
    gap: 1rem;
    height: 100%;
    padding: 1rem;
    border: 1px solid rgba(229, 231, 235, 0.9);
    border-radius: 1.75rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .home-product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(37, 99, 235, 0.24);
  }

  .home-product-card.contrast {
    border-color: rgba(255, 255, 255, 0.12);
    background: linear-gradient(180deg, rgba(14, 25, 48, 0.96), rgba(10, 18, 36, 0.94));
    box-shadow: 0 22px 48px rgba(0, 0, 0, 0.25);
  }

  .home-product-media {
    position: relative;
    overflow: hidden;
    border-radius: 1.35rem;
    background:
      radial-gradient(circle at top right, rgba(37, 99, 235, 0.12), transparent 42%),
      linear-gradient(180deg, rgba(248, 250, 252, 1), rgba(238, 244, 255, 0.92));
    aspect-ratio: 4 / 3;
  }

  .home-product-card.contrast .home-product-media {
    background:
      radial-gradient(circle at top right, rgba(96, 165, 250, 0.24), transparent 42%),
      linear-gradient(180deg, rgba(18, 31, 58, 1), rgba(12, 21, 40, 0.94));
  }

  .home-product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    transition: transform 0.3s ease;
  }

  .home-product-card:hover .home-product-media img {
    transform: scale(1.04);
  }

  .product-badge-chip {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-badge-chip.new {
    background: rgba(37, 99, 235, 0.12);
    color: var(--color-primary);
  }

  .product-badge-chip.hot {
    background: rgba(245, 158, 11, 0.16);
    color: #b45309;
  }

  .product-badge-chip.sale {
    background: rgba(22, 163, 74, 0.14);
    color: #047857;
  }

  .home-product-card.contrast .product-badge-chip.new {
    background: rgba(96, 165, 250, 0.2);
    color: #bfdbfe;
  }

  .home-product-card.contrast .product-badge-chip.hot {
    background: rgba(245, 158, 11, 0.18);
    color: #fde68a;
  }

  .home-product-card.contrast .product-badge-chip.sale {
    background: rgba(34, 197, 94, 0.18);
    color: #bbf7d0;
  }

  .home-product-body {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .home-product-copy {
    display: grid;
    gap: 0.45rem;
  }

  .home-product-brand {
    color: var(--color-primary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-product-card.contrast .home-product-brand {
    color: #bfdbfe;
  }

  .home-product-copy h3 {
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .home-product-copy a:hover {
    color: var(--color-primary);
  }

  .home-product-card.contrast .home-product-copy h3,
  .home-product-card.contrast .home-product-copy a {
    color: #f8fafc;
  }

  .home-product-specs {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .home-product-card.contrast .home-product-specs {
    color: rgba(226, 232, 240, 0.72);
  }

  .home-product-price-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .home-product-price-stack {
    display: grid;
    gap: 0.15rem;
  }

  .home-product-price-stack strong {
    font-size: 1.38rem;
    letter-spacing: -0.04em;
  }

  .home-product-price-stack span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: line-through;
  }

  .home-product-card.contrast .home-product-price-stack strong {
    color: #ffffff;
  }

  .home-product-card.contrast .home-product-price-stack span {
    color: rgba(226, 232, 240, 0.62);
  }

  .home-product-link {
    color: var(--color-primary);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .home-product-card.contrast .home-product-link {
    color: #bfdbfe;
  }

  .home-product-button {
    width: 100%;
    margin-top: auto;
  }
</style>
