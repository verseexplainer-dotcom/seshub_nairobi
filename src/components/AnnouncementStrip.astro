---
import { storefrontDetails } from '../lib/storefront';
---
 
<aside class="announcement-strip" aria-label="Store value highlights">
  <div class="container">
    <div class="announcement-items">
      {storefrontDetails.topBarItems.map((item) => (
        <span class="announcement-item">{item}</span>
      ))}
    </div>
  </div>
</aside>

<style>
  .announcement-strip {
    border-bottom: 1px solid rgba(229, 231, 235, 0.9);
    background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
    color: var(--color-text);
    position: relative;
    z-index: 1;
  }

  .announcement-items {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.9rem;
    padding: 0.7rem 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }

  .announcement-item:not(:last-child)::after {
    content: "";
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.3);
  }

  @media (min-width: 720px) {
    .announcement-items {
      min-height: 2.75rem;
      font-size: 0.8125rem;
    }
  }
</style>
