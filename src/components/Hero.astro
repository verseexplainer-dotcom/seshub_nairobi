---
import { getSiteAssets } from '../lib/siteAssets';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const heroImage = siteAssets.hero;
const fallbackImage = (import.meta.env.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder).trim();
const imageOnError = `if(this.dataset.fallbackApplied==='1'){this.onerror=null;this.src='/product-placeholder.jpg';}else{this.dataset.fallbackApplied='1';this.src=${JSON.stringify(fallbackImage)};}`;
---

<section class="hero">
  <div class="container hero-content">
    <div class="hero-text">
      <h1 class="hero-title">Achieve Peak Computing Performance Without the High Cost of New Tech</h1>
      <p class="hero-subtitle">Tested devices with clear specs, fair pricing, and fast delivery across Kenya.</p>
      
      <div class="hero-actions">
        <a href="/category/deals" class="pill-button primary">Shop Deals</a>
        <a href="https://wa.me/254720480475" class="pill-button" style="background-color: #25D366; color: white;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.435 5.617 1.436h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          WhatsApp Checkout
        </a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>2-Hour Nairobi Delivery</span>
        </div>
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>M-PESA</span>
        </div>
        <div class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Cash on Delivery</span>
        </div>
      </div>
    </div>
    
    <div class="hero-image">
      <div class="hero-image-placeholder relative h-full w-full rounded-2xl overflow-hidden shadow-2xl">
        <img 
          src={heroImage}
          alt="Premium Refurbished Laptop" 
          class="object-cover w-full h-full"
          onerror={imageOnError}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--white);
    padding: var(--space-xl) 0;
    overflow: hidden;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .hero-content {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-main);
    margin-bottom: var(--space-md);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  .text-accent {
    color: var(--accent);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
    max-width: 600px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hero-trust {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  @media (min-width: 640px) {
    .hero-trust {
      display: flex;
      gap: var(--space-md);
    }
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .hero-image-placeholder {
    background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
    border-radius: var(--radius-lg);
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: var(--shadow-md);
  }

  .placeholder-icon {
    font-size: 5rem;
  }

  @media (min-width: 1024px) {
    .hero-image-placeholder {
      transform: rotate(2deg);
    }
  }
</style>
