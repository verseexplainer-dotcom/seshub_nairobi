---
interface CategoryItem {
  title: string;
  count: number;
  href: string;
  description: string;
  accent: string;
}

interface Props {
  items: CategoryItem[];
}

const { items } = Astro.props as Props;
---

<section class="category-grid-section section" aria-labelledby="main-categories-title">
  <div class="container">
    <div class="section-intro">
      <p class="section-kicker">Shop by category</p>
      <h2 id="main-categories-title" class="section-title">Start with the section that fits what you need</h2>
      <p class="section-copy">
        Pick a category, see what is available, and message us on WhatsApp if you want help choosing.
      </p>
    </div>

    <div class="category-grid">
      {items.map((category, index) => (
        <a href={category.href} class={`category-card ${index < 2 ? 'featured' : ''}`} style={`--card-accent:${category.accent};`}>
          <div class="category-card-topline">
            <span class="category-card-count">{category.count}{category.count > 0 ? '+' : ''} items</span>
            <span class="category-card-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="category-card-copy">
            <h3>{category.title}</h3>
            <p>{category.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .category-grid {
    display: grid;
    gap: 1rem;
  }

  .category-card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    min-height: 12rem;
    padding: 1.35rem;
    border: 1px solid rgba(229, 231, 235, 0.92);
    border-radius: 1.75rem;
    overflow: hidden;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--card-accent) 18%, transparent), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 250, 252, 0.95));
    box-shadow: var(--shadow-sm);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .category-card::after {
    content: "";
    position: absolute;
    inset: auto -10% -28% auto;
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--card-accent) 22%, transparent);
    filter: blur(18px);
    opacity: 0.45;
  }

  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--card-accent) 38%, rgba(229, 231, 235, 0.92));
  }

  .category-card.featured {
    min-height: 14rem;
  }

  .category-card-topline,
  .category-card-copy {
    position: relative;
    z-index: 1;
  }

  .category-card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .category-card-count {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: color-mix(in srgb, var(--card-accent) 78%, #0f172a);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-card-arrow {
    font-size: 1.1rem;
    color: color-mix(in srgb, var(--card-accent) 70%, #0f172a);
  }

  .category-card-copy {
    display: grid;
    gap: 0.55rem;
    margin-top: auto;
  }

  .category-card-copy h3 {
    font-size: 1.35rem;
  }

  .category-card-copy p {
    max-width: 28ch;
    color: var(--color-text-muted);
  }

  @media (min-width: 760px) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1180px) {
    .category-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
