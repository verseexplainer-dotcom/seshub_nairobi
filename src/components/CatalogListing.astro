---
import ProductCard from './ProductCard.astro';
import SearchBar from './SearchBar.astro';
import {
  SHOP_PATH,
  STOREFRONT_CATEGORIES,
  formatCurrencyKes,
  formatScreenSize,
  formatStorageSize,
  formatNumberLabel,
  getStoreCategoryBySlug,
  matchesStoreCategoryValue,
  normalizeText,
  parsePositiveNumber
} from '../lib/productPresentation';
import type { CatalogProduct } from '../types/catalog';
import { getAllProducts } from '../lib/products';

interface Props {
  mode: 'shop' | 'category';
  categorySlug?: 'all' | 'laptops' | 'desktops' | 'smartphones' | 'printers' | 'accessories';
}

const { mode, categorySlug = 'all' } = Astro.props;
const isShopMode = mode === 'shop';
const activeCategory = categorySlug !== 'all' ? getStoreCategoryBySlug(categorySlug) : null;
const searchParams = Astro.url.searchParams;
const pageSize = 24;
const requestedPage = Math.max(1, Number.parseInt(searchParams.get('page') || '1', 10) || 1);
const selectedSort = new Set(['featured', 'newest', 'price_asc', 'price_desc']).has(searchParams.get('sort') || '')
  ? (searchParams.get('sort') as 'featured' | 'newest' | 'price_asc' | 'price_desc')
  : 'featured';
const selectedBrand = normalizeText(searchParams.get('brand'));
const selectedCondition = new Set(['brand_new', 'refurbished']).has(searchParams.get('condition') || '')
  ? normalizeText(searchParams.get('condition'))
  : '';
const selectedCpu = normalizeText(searchParams.get('cpu'));
const selectedRam = normalizeText(searchParams.get('ram_gb'));
const selectedStorage = normalizeText(searchParams.get('storage_gb'));
const selectedScreen = normalizeText(searchParams.get('screen_in'));
const stockFilter = normalizeText(searchParams.get('in_stock'));
const minPrice = parsePositiveNumber(searchParams.get('min_price'));
const maxPrice = parsePositiveNumber(searchParams.get('max_price'));
const selectedRamValue = parsePositiveNumber(selectedRam);
const selectedStorageValue = parsePositiveNumber(selectedStorage);
const selectedScreenValue = parsePositiveNumber(selectedScreen);
const hasFilters =
  Boolean(selectedBrand) ||
  Boolean(selectedCondition) ||
  Boolean(selectedCpu) ||
  Boolean(selectedRam) ||
  Boolean(selectedStorage) ||
  Boolean(selectedScreen) ||
  stockFilter === '1' ||
  stockFilter === '0' ||
  minPrice !== null ||
  maxPrice !== null ||
  selectedSort !== 'featured';

let products: CatalogProduct[] = [];
let totalCount = 0;
let facetRows: CatalogProduct[] = [];
let featuredProducts: CatalogProduct[] = [];
let currentPage = requestedPage;

function sortCatalogRows(rows: CatalogProduct[], sort = selectedSort) {
  const sorted = [...rows];
  switch (sort) {
    case 'price_asc':
      return sorted.sort((left, right) =>
        (left.price_kes || 0) - (right.price_kes || 0) ||
        normalizeText(right.updated_at).localeCompare(normalizeText(left.updated_at)) ||
        normalizeText(left.title).localeCompare(normalizeText(right.title))
      );
    case 'price_desc':
      return sorted.sort((left, right) =>
        (right.price_kes || 0) - (left.price_kes || 0) ||
        normalizeText(right.updated_at).localeCompare(normalizeText(left.updated_at)) ||
        normalizeText(left.title).localeCompare(normalizeText(right.title))
      );
    case 'newest':
      return sorted.sort((left, right) =>
        normalizeText(right.created_at).localeCompare(normalizeText(left.created_at)) ||
        normalizeText(right.updated_at).localeCompare(normalizeText(left.updated_at)) ||
        normalizeText(left.title).localeCompare(normalizeText(right.title))
      );
    default:
      return sorted.sort((left, right) =>
        Number(right.in_stock === true) - Number(left.in_stock === true) ||
        (Number(left.featured_rank || Number.MAX_SAFE_INTEGER) - Number(right.featured_rank || Number.MAX_SAFE_INTEGER)) ||
        normalizeText(right.updated_at).localeCompare(normalizeText(left.updated_at)) ||
        normalizeText(left.title).localeCompare(normalizeText(right.title))
      );
  }
}

const allCatalogRows = getAllProducts();
facetRows = activeCategory
  ? allCatalogRows.filter((product) => matchesStoreCategoryValue(product.category, activeCategory))
  : allCatalogRows;

const filteredRows = facetRows.filter((product) => {
  if (selectedBrand && normalizeText(product.brand) !== selectedBrand) return false;
  if (selectedCondition && product.condition !== selectedCondition) return false;
  if (!isShopMode && selectedCpu && normalizeText(product.cpu) !== selectedCpu) return false;
  if (!isShopMode && selectedRamValue !== null && Number(product.ram_gb) !== selectedRamValue) return false;
  if (!isShopMode && selectedStorageValue !== null && Number(product.storage_gb) !== selectedStorageValue) return false;
  if (!isShopMode && selectedScreenValue !== null && Number(product.screen_in) !== selectedScreenValue) return false;
  if (stockFilter === '1' && product.in_stock !== true) return false;
  if (stockFilter === '0' && product.in_stock === true) return false;
  if (minPrice !== null && Number(product.price_kes) < minPrice) return false;
  if (maxPrice !== null && Number(product.price_kes) > maxPrice) return false;
  return true;
});

totalCount = filteredRows.length;
const calculatedTotalPages = Math.max(1, Math.ceil(totalCount / pageSize));
currentPage = Math.min(requestedPage, calculatedTotalPages);
const pageFrom = (currentPage - 1) * pageSize;
products = sortCatalogRows(filteredRows).slice(pageFrom, pageFrom + pageSize);

if (isShopMode && !hasFilters) {
  featuredProducts = sortCatalogRows(
    facetRows.filter((product) => product.in_stock === true && product.featured_home),
    'featured'
  ).slice(0, 4);

  if (featuredProducts.length === 0) {
    featuredProducts = sortCatalogRows(
      facetRows.filter((product) => product.in_stock === true),
      'featured'
    ).slice(0, 4);
  }
}

const collectStringFacet = (key: keyof CatalogProduct) =>
  Array.from(
    new Set(
      facetRows
        .map((row) => normalizeText(row[key]))
        .filter(Boolean)
    )
  ).sort((a, b) => a.localeCompare(b));

const collectNumericFacet = (key: keyof CatalogProduct) =>
  Array.from(
    new Set(
      facetRows
        .map((row) => formatNumberLabel(row[key]))
        .filter(Boolean)
    )
  ).sort((a, b) => Number(a) - Number(b));

const availableBrands = collectStringFacet('brand');
const availableCpus = collectStringFacet('cpu');
const availableRam = collectNumericFacet('ram_gb');
const availableStorage = collectNumericFacet('storage_gb');
const availableScreens = collectNumericFacet('screen_in');
const inStockCount = facetRows.filter((row) => row.in_stock === true).length;
const priceValues = facetRows
  .map((row) => Number(row.price_kes))
  .filter((value) => Number.isFinite(value) && value > 0);
const minFacetPrice = priceValues.length ? Math.min(...priceValues) : null;
const maxFacetPrice = priceValues.length ? Math.max(...priceValues) : null;

const sortLabels = {
  featured: 'Featured',
  newest: 'Newest',
  price_asc: 'Price: Low to High',
  price_desc: 'Price: High to Low'
};

const basePath = Astro.url.pathname;
const buildHref = (overrides: Record<string, string | number | null | undefined>) => {
  const params = new URLSearchParams(searchParams);

  for (const [key, value] of Object.entries(overrides)) {
    if (value === null || value === undefined || value === '') {
      params.delete(key);
      continue;
    }

    params.set(key, String(value));
  }

  const query = params.toString();
  return query ? `${basePath}?${query}` : basePath;
};

const clearFiltersHref = basePath;
const buildPageHref = (page: number) => buildHref({ page: page <= 1 ? null : page });
const activeFilterChips = [
  selectedBrand ? { label: `Brand: ${selectedBrand}`, href: buildHref({ brand: null, page: null }) } : null,
  selectedCondition
    ? {
        label: `Condition: ${selectedCondition === 'brand_new' ? 'Brand New' : 'Refurbished'}`,
        href: buildHref({ condition: null, page: null })
      }
    : null,
  !isShopMode && selectedCpu ? { label: `CPU: ${selectedCpu}`, href: buildHref({ cpu: null, page: null }) } : null,
  !isShopMode && selectedRam ? { label: `RAM: ${selectedRam}GB`, href: buildHref({ ram_gb: null, page: null }) } : null,
  !isShopMode && selectedStorage ? { label: `Storage: ${formatStorageSize(selectedStorage)}`, href: buildHref({ storage_gb: null, page: null }) } : null,
  !isShopMode && selectedScreen ? { label: `Screen: ${formatScreenSize(selectedScreen)}`, href: buildHref({ screen_in: null, page: null }) } : null,
  stockFilter === '1' ? { label: 'Availability: In stock', href: buildHref({ in_stock: null, page: null }) } : null,
  stockFilter === '0' ? { label: 'Availability: Out of stock', href: buildHref({ in_stock: null, page: null }) } : null,
  minPrice !== null ? { label: `Min: ${formatCurrencyKes(minPrice)}`, href: buildHref({ min_price: null, page: null }) } : null,
  maxPrice !== null ? { label: `Max: ${formatCurrencyKes(maxPrice)}`, href: buildHref({ max_price: null, page: null }) } : null,
  selectedSort !== 'featured' ? { label: `Sort: ${sortLabels[selectedSort]}`, href: buildHref({ sort: null, page: null }) } : null
].filter(Boolean) as Array<{ label: string; href: string }>;

const from = (currentPage - 1) * pageSize;
const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
const resultStart = totalCount > 0 ? from + 1 : 0;
const resultEnd = totalCount > 0 ? from + products.length : 0;
const paginationNumbers = Array.from({ length: Math.min(totalPages, 5) }, (_, index) => {
  const start = Math.max(1, Math.min(totalPages - 4, currentPage - 2));
  return start + index;
}).filter((page, index, list) => page >= 1 && page <= totalPages && list.indexOf(page) === index);

const categoryCounts = STOREFRONT_CATEGORIES.map((category) => ({
  ...category,
  count: facetRows.filter((row) => matchesStoreCategoryValue(row.category, category)).length
}));

const priceBand = minFacetPrice && maxFacetPrice
  ? `${formatCurrencyKes(minFacetPrice)} - ${formatCurrencyKes(maxFacetPrice)}`
  : 'Live pricing';

const breadcrumbData = isShopMode
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://sesicthub.co.ke/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Shop',
          item: `https://sesicthub.co.ke${SHOP_PATH}`
        }
      ]
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://sesicthub.co.ke/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Shop',
          item: `https://sesicthub.co.ke${SHOP_PATH}`
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: activeCategory?.label || 'Category',
          item: `https://sesicthub.co.ke/category/${activeCategory?.slug || ''}`
        }
      ]
    };
---

<div class={`catalog-shell ${isShopMode ? 'shop-mode' : 'category-mode'}`}>
  {isShopMode ? (
    <section class="shop-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span aria-current="page">Shop</span>
        </nav>

        <div class="shop-hero-grid">
          <div>
            <p class="eyebrow">Find what you need</p>
            <h1>Shop laptops, desktops, smartphones, printers, and accessories.</h1>
            <p class="hero-copy">
              See what is available, compare prices, and message us on WhatsApp if you want help choosing.
            </p>
            <div class="shortcut-row" aria-label="Category shortcuts">
              {categoryCounts.map((category) => (
                <a class="shortcut-chip" href={`/category/${category.slug}`}>
                  <span>{category.label}</span>
                  <strong>{category.count}</strong>
                </a>
              ))}
            </div>
          </div>

          <div class="shop-stats-card">
            <p class="eyebrow">At a glance</p>
            <div class="shop-stats-grid">
              <div>
                <strong>{totalCount.toLocaleString('en-KE')}</strong>
                <span>Products</span>
              </div>
              <div>
                <strong>{availableBrands.length}</strong>
                <span>Brands</span>
              </div>
              <div>
                <strong>{inStockCount}</strong>
                <span>In stock</span>
              </div>
              <div>
                <strong>{priceBand}</strong>
                <span>Price band</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="category-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/shop">Shop</a>
          <span>/</span>
          <span aria-current="page">{activeCategory?.label}</span>
        </nav>

        <div class="category-hero-grid">
          <div>
            <p class="eyebrow">{activeCategory?.heroEyebrow}</p>
            <h1>{activeCategory?.label}</h1>
            <p class="hero-copy">{activeCategory?.heroDescription}</p>
            <div class="shortcut-row" aria-label={`${activeCategory?.label} highlights`}>
              {activeCategory?.highlights.map((highlight) => <span class="shortcut-chip static-chip">{highlight}</span>)}
            </div>
          </div>

          <div class="shop-stats-card">
            <p class="eyebrow">At a glance</p>
            <div class="shop-stats-grid">
              <div>
                <strong>{totalCount.toLocaleString('en-KE')}</strong>
                <span>Products</span>
              </div>
              <div>
                <strong>{availableBrands.length}</strong>
                <span>Brands</span>
              </div>
              <div>
                <strong>{inStockCount}</strong>
                <span>In stock</span>
              </div>
              <div>
                <strong>{priceBand}</strong>
                <span>Price band</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="catalog-search">
    <div class="container">
      <SearchBar />
    </div>
  </section>

  {isShopMode && !hasFilters && featuredProducts.length > 0 && (
    <section class="featured-row">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Featured picks</p>
            <h2>Start with highlighted products</h2>
          </div>
          <a href="/shop" class="text-link">See full catalog</a>
        </div>
        <div class="product-grid featured-grid">
          {featuredProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>
  )}

  <section class="catalog-section">
    <div class="container">
      {isShopMode ? (
        <form class="shop-filters" method="get">
          <div class="filter-block">
            <label for="shop-brand">Brand</label>
            <select id="shop-brand" name="brand">
              <option value="">All brands</option>
              {availableBrands.map((brand) => <option value={brand} selected={selectedBrand === brand}>{brand}</option>)}
            </select>
          </div>
          <div class="filter-block">
            <label for="shop-condition">Condition</label>
            <select id="shop-condition" name="condition">
              <option value="">All conditions</option>
              <option value="brand_new" selected={selectedCondition === 'brand_new'}>Brand New</option>
              <option value="refurbished" selected={selectedCondition === 'refurbished'}>Refurbished</option>
            </select>
          </div>
          <div class="filter-block">
            <label for="shop-stock">Availability</label>
            <select id="shop-stock" name="in_stock">
              <option value="">All stock</option>
              <option value="1" selected={stockFilter === '1'}>In stock</option>
              <option value="0" selected={stockFilter === '0'}>Out of stock</option>
            </select>
          </div>
          <div class="filter-block price-block">
            <label for="shop-min">Min KES</label>
            <input id="shop-min" type="number" min="1" step="1" name="min_price" value={minPrice !== null ? String(minPrice) : ''} />
          </div>
          <div class="filter-block price-block">
            <label for="shop-max">Max KES</label>
            <input id="shop-max" type="number" min="1" step="1" name="max_price" value={maxPrice !== null ? String(maxPrice) : ''} />
          </div>
          <div class="filter-block sort-block">
            <label for="shop-sort">Sort by</label>
            <select id="shop-sort" name="sort">
              <option value="featured" selected={selectedSort === 'featured'}>Featured</option>
              <option value="newest" selected={selectedSort === 'newest'}>Newest</option>
              <option value="price_asc" selected={selectedSort === 'price_asc'}>Price: Low to High</option>
              <option value="price_desc" selected={selectedSort === 'price_desc'}>Price: High to Low</option>
            </select>
          </div>
          <div class="shop-filter-actions">
            <button class="pill-button primary" type="submit">Apply</button>
            {hasFilters && <a class="pill-button" href={clearFiltersHref}>Reset</a>}
          </div>
        </form>
      ) : (
        <div class="catalog-layout">
          <aside class="catalog-sidebar">
            <form class="sidebar-filters" method="get">
              <input type="hidden" name="sort" value={selectedSort} />

              <div class="filter-block">
                <label for="brand-filter">Brand</label>
                <select id="brand-filter" name="brand">
                  <option value="">All brands</option>
                  {availableBrands.map((brand) => <option value={brand} selected={selectedBrand === brand}>{brand}</option>)}
                </select>
              </div>

              <div class="filter-block">
                <label for="condition-filter">Condition</label>
                <select id="condition-filter" name="condition">
                  <option value="">All conditions</option>
                  <option value="brand_new" selected={selectedCondition === 'brand_new'}>Brand New</option>
                  <option value="refurbished" selected={selectedCondition === 'refurbished'}>Refurbished</option>
                </select>
              </div>

              {availableCpus.length > 0 && (
                <div class="filter-block">
                  <label for="cpu-filter">CPU</label>
                  <select id="cpu-filter" name="cpu">
                    <option value="">Any CPU</option>
                    {availableCpus.map((cpu) => <option value={cpu} selected={selectedCpu === cpu}>{cpu}</option>)}
                  </select>
                </div>
              )}

              {availableRam.length > 0 && (
                <div class="filter-block">
                  <fieldset class="choice-group">
                    <legend>RAM</legend>
                    <div class="filter-chip-list">
                      <label class={`filter-chip ${selectedRam === '' ? 'selected' : ''}`}>
                        <input type="radio" name="ram_gb" value="" checked={selectedRam === ''} />
                        <span>Any</span>
                      </label>
                      {availableRam.map((value) => (
                        <label class={`filter-chip ${selectedRam === value ? 'selected' : ''}`}>
                          <input type="radio" name="ram_gb" value={value} checked={selectedRam === value} />
                          <span>{value}GB</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                </div>
              )}

              {availableStorage.length > 0 && (
                <div class="filter-block">
                  <fieldset class="choice-group">
                    <legend>Storage</legend>
                    <div class="filter-chip-list">
                      <label class={`filter-chip ${selectedStorage === '' ? 'selected' : ''}`}>
                        <input type="radio" name="storage_gb" value="" checked={selectedStorage === ''} />
                        <span>Any</span>
                      </label>
                      {availableStorage.map((value) => (
                        <label class={`filter-chip ${selectedStorage === value ? 'selected' : ''}`}>
                          <input type="radio" name="storage_gb" value={value} checked={selectedStorage === value} />
                          <span>{formatStorageSize(value)}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                </div>
              )}

              {availableScreens.length > 0 && (
                <div class="filter-block">
                  <fieldset class="choice-group">
                    <legend>Screen size</legend>
                    <div class="filter-chip-list">
                      <label class={`filter-chip ${selectedScreen === '' ? 'selected' : ''}`}>
                        <input type="radio" name="screen_in" value="" checked={selectedScreen === ''} />
                        <span>Any</span>
                      </label>
                      {availableScreens.map((value) => (
                        <label class={`filter-chip ${selectedScreen === value ? 'selected' : ''}`}>
                          <input type="radio" name="screen_in" value={value} checked={selectedScreen === value} />
                          <span>{formatScreenSize(value)}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                </div>
              )}

              <div class="filter-block">
                <label for="min-price">Min KES</label>
                <input id="min-price" type="number" min="1" step="1" name="min_price" value={minPrice !== null ? String(minPrice) : ''} />
              </div>

              <div class="filter-block">
                <label for="max-price">Max KES</label>
                <input id="max-price" type="number" min="1" step="1" name="max_price" value={maxPrice !== null ? String(maxPrice) : ''} />
              </div>

              <div class="filter-block">
                <label for="stock-filter">Availability</label>
                <select id="stock-filter" name="in_stock">
                  <option value="">All stock</option>
                  <option value="1" selected={stockFilter === '1'}>In stock</option>
                  <option value="0" selected={stockFilter === '0'}>Out of stock</option>
                </select>
              </div>

              <div class="shop-filter-actions">
                <button class="pill-button primary" type="submit">Apply filters</button>
                {hasFilters && <a class="pill-button" href={clearFiltersHref}>Reset</a>}
              </div>
            </form>
          </aside>

          <div class="catalog-main">
            <div class="catalog-toolbar">
              <div>
                <p class="results-summary">
                  {totalCount > 0 ? `Showing ${resultStart}-${resultEnd} of ${totalCount.toLocaleString('en-KE')} products` : '0 matching products'}
                </p>
                <h2>{activeCategory?.label}</h2>
                <p class="results-note">{activeCategory?.intro}</p>
              </div>

              <form class="catalog-sort-form" method="get">
                {selectedBrand && <input type="hidden" name="brand" value={selectedBrand} />}
                {selectedCondition && <input type="hidden" name="condition" value={selectedCondition} />}
                {selectedCpu && <input type="hidden" name="cpu" value={selectedCpu} />}
                {selectedRam && <input type="hidden" name="ram_gb" value={selectedRam} />}
                {selectedStorage && <input type="hidden" name="storage_gb" value={selectedStorage} />}
                {selectedScreen && <input type="hidden" name="screen_in" value={selectedScreen} />}
                {stockFilter && <input type="hidden" name="in_stock" value={stockFilter} />}
                {minPrice !== null && <input type="hidden" name="min_price" value={String(minPrice)} />}
                {maxPrice !== null && <input type="hidden" name="max_price" value={String(maxPrice)} />}
                <label for="sort-select">Sort by</label>
                <select id="sort-select" name="sort" onchange="this.form?.requestSubmit()">
                  <option value="featured" selected={selectedSort === 'featured'}>Featured</option>
                  <option value="newest" selected={selectedSort === 'newest'}>Newest</option>
                  <option value="price_asc" selected={selectedSort === 'price_asc'}>Price: Low to High</option>
                  <option value="price_desc" selected={selectedSort === 'price_desc'}>Price: High to Low</option>
                </select>
              </form>
            </div>

            {activeFilterChips.length > 0 && (
              <div class="active-filters" aria-label="Active filters">
                {activeFilterChips.map((chip) => (
                  <a class="active-filter-chip" href={chip.href}>
                    <span>{chip.label}</span>
                    <span aria-hidden="true">×</span>
                  </a>
                ))}
                <a class="active-filter-clear" href={clearFiltersHref}>Clear all</a>
              </div>
            )}

            {products.length > 0 ? (
              <div class="product-grid">
                {products.map((product) => <ProductCard product={product} />)}
              </div>
            ) : (
              <div class="empty-state">
                <div class="empty-illustration">0</div>
                <h3>No products match this view right now.</h3>
                <p>Try removing one or two filters, widening the price range, or browsing the main shop page.</p>
                <div class="empty-actions">
                  <a href={clearFiltersHref} class="pill-button primary">Clear filters</a>
                  <a href="/shop" class="pill-button">Browse shop</a>
                </div>
              </div>
            )}

            {products.length > 0 && totalPages > 1 && (
              <nav class="pagination" aria-label="Pagination">
                <a class={`pill-button pagination-button ${currentPage <= 1 ? 'disabled' : ''}`} href={currentPage <= 1 ? '#' : buildPageHref(currentPage - 1)} aria-disabled={currentPage <= 1}>
                  Previous
                </a>
                <div class="pagination-pages">
                  {paginationNumbers.map((page) => (
                    <a class={`pagination-page ${page === currentPage ? 'current' : ''}`} href={buildPageHref(page)} aria-current={page === currentPage ? 'page' : undefined}>
                      {page}
                    </a>
                  ))}
                </div>
                <a class={`pill-button pagination-button ${currentPage >= totalPages ? 'disabled' : ''}`} href={currentPage >= totalPages ? '#' : buildPageHref(currentPage + 1)} aria-disabled={currentPage >= totalPages}>
                  Next
                </a>
              </nav>
            )}
          </div>
        </div>
      )}

      {isShopMode && (
        <div class="catalog-toolbar shop-toolbar">
          <div>
            <p class="results-summary">
              {totalCount > 0 ? `Showing ${resultStart}-${resultEnd} of ${totalCount.toLocaleString('en-KE')} products` : '0 matching products'}
            </p>
            <h2>All products</h2>
            <p class="results-note">
              All products are listed here. Open a category page if you want fewer items to compare.
            </p>
          </div>
        </div>
      )}

      {isShopMode && activeFilterChips.length > 0 && (
        <div class="active-filters" aria-label="Active filters">
          {activeFilterChips.map((chip) => (
            <a class="active-filter-chip" href={chip.href}>
              <span>{chip.label}</span>
              <span aria-hidden="true">×</span>
            </a>
          ))}
          <a class="active-filter-clear" href={clearFiltersHref}>Clear all</a>
        </div>
      )}

      {isShopMode && (products.length > 0 ? (
        <div class="product-grid">
          {products.map((product) => <ProductCard product={product} />)}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-illustration">0</div>
          <h3>No products match this view right now.</h3>
          <p>Try removing one or two filters, widening the price range, or browsing the main shop page.</p>
          <div class="empty-actions">
            <a href={clearFiltersHref} class="pill-button primary">Clear filters</a>
            {basePath !== '/shop' && <a href="/shop" class="pill-button">Browse shop</a>}
          </div>
        </div>
      ))}

      {isShopMode && products.length > 0 && totalPages > 1 && (
        <nav class="pagination" aria-label="Pagination">
          <a class={`pill-button pagination-button ${currentPage <= 1 ? 'disabled' : ''}`} href={currentPage <= 1 ? '#' : buildPageHref(currentPage - 1)} aria-disabled={currentPage <= 1}>
            Previous
          </a>
          <div class="pagination-pages">
            {paginationNumbers.map((page) => (
              <a class={`pagination-page ${page === currentPage ? 'current' : ''}`} href={buildPageHref(page)} aria-current={page === currentPage ? 'page' : undefined}>
                {page}
              </a>
            ))}
          </div>
          <a class={`pill-button pagination-button ${currentPage >= totalPages ? 'disabled' : ''}`} href={currentPage >= totalPages ? '#' : buildPageHref(currentPage + 1)} aria-disabled={currentPage >= totalPages}>
            Next
          </a>
        </nav>
      )}
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbData)} />
</div>

