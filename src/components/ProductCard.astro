---
import { getSiteAssets } from '../lib/siteAssets';
import { getProductPresentation, normalizeText } from '../lib/productPresentation';

interface Props {
  product: Record<string, any>;
}

const { product } = Astro.props;
const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const finalFallbackImage = '/product-placeholder.svg';
const fallbackImage = (
  import.meta.env.PUBLIC_FALLBACK_IMAGE_URL ||
  siteAssets.productPlaceholder.src ||
  finalFallbackImage
).trim();
const imageOnError = `if(this.dataset.fallbackApplied==='1'){this.onerror=null;this.src=${JSON.stringify(finalFallbackImage)};}else{this.dataset.fallbackApplied='1';this.src=${JSON.stringify(fallbackImage)};}`;
const presentation = getProductPresentation(product, {
  publicSupabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL,
  fallbackImage
});
const whatsAppUrl = `https://wa.me/254720480475?text=${encodeURIComponent(
  `Hi SES ICT HUB, I need help with: ${presentation.rawTitle} - https://sesicthub.co.ke/product/${product.slug}`
)}`;
const hasSpecs = presentation.summarySpecs.length > 0;
const fallbackSpecsCopy = normalizeText(product.short_specs) || 'More product details are available on the product page.';
const escapeHtml = (value: unknown) =>
  String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
const specMarkup = hasSpecs
  ? presentation.summarySpecs
      .map(
        (spec) => `
          <div class="spec-item">
            <span class="spec-label">${escapeHtml(spec.label)}</span>
            <strong class="spec-value">${escapeHtml(spec.value)}</strong>
          </div>
        `
      )
      .join('')
  : `<p class="product-spec-fallback">${escapeHtml(fallbackSpecsCopy)}</p>`;
const detailMarkup = [
  presentation.grade ? `<span class="detail-chip grade-chip">${escapeHtml(presentation.grade.label)}</span>` : '',
  presentation.warranty ? `<span class="detail-chip">${escapeHtml(presentation.warranty)}</span>` : '',
  presentation.stock.isLowStock && presentation.stock.stockQty
    ? `<span class="detail-chip detail-chip-warn">Only ${escapeHtml(Math.round(presentation.stock.stockQty))} left</span>`
    : ''
]
  .filter(Boolean)
  .join('');
const conditionBadgeMarkup = presentation.condition.label
  ? `<span class="status-badge condition ${escapeHtml(presentation.condition.tone)}">${escapeHtml(presentation.condition.label)}</span>`
  : '';
const priceSupportText =
  presentation.pricing.hasDiscount && presentation.pricing.savingsText
    ? `You save ${presentation.pricing.savingsText}`
    : presentation.stock.detail;
const viewLabel = `View ${presentation.displayTitle}`;
const addToCartLabel = `Add ${presentation.displayTitle} to cart`;
const inquireLabel = `Inquire about ${presentation.displayTitle} on WhatsApp`;
const actionMarkup = presentation.stock.isInStock
  ? `
    <button
      class="pill-button primary add-to-cart-btn"
      type="button"
      data-id="${escapeHtml(product.id)}"
      data-title="${escapeHtml(presentation.rawTitle)}"
      data-price="${escapeHtml(presentation.pricing.price)}"
      data-slug="${escapeHtml(product.slug)}"
      data-image="${escapeHtml(presentation.primaryImageUrl)}"
      aria-label="${escapeHtml(addToCartLabel)}"
    >
      Add to Cart
    </button>
  `
  : `
    <a
      href="${escapeHtml(whatsAppUrl)}"
      class="pill-button whatsapp-btn"
      target="_blank"
      rel="noreferrer"
      aria-label="${escapeHtml(inquireLabel)}"
    >
      WhatsApp Inquiry
    </a>
  `;
const compareMarkup = presentation.pricing.compareAtText
  ? `<span class="compare-price">${escapeHtml(presentation.pricing.compareAtText)}</span>`
  : '';
const dealBadgeMarkup = presentation.pricing.hasDiscount && presentation.pricing.savingsText
  ? `
    <div class="deal-badge-row">
      <span class="discount-chip">Save ${escapeHtml(presentation.pricing.savingsText)}</span>
      ${presentation.pricing.percent > 0 ? `<span class="percent-chip">-${escapeHtml(String(presentation.pricing.percent))}%</span>` : ''}
    </div>
  `
  : '';
const specSectionMarkup = hasSpecs
  ? `<div class="product-spec-list" aria-label="Key specs">${specMarkup}</div>`
  : specMarkup;
const cardHtml = `
  <article class="product-card">
    <a href="${escapeHtml(presentation.productPath)}" class="product-media" aria-label="${escapeHtml(viewLabel)}">
      <img
        src="${escapeHtml(presentation.primaryImageUrl)}"
        alt="${escapeHtml(presentation.displayTitle)}"
        loading="lazy"
        class="product-image"
        onerror="${escapeHtml(imageOnError)}"
      />
      <div class="product-badge-row">
        ${conditionBadgeMarkup}
        <span class="status-badge stock ${escapeHtml(presentation.stock.tone)}">${escapeHtml(presentation.stock.badge)}</span>
      </div>
      ${dealBadgeMarkup}
    </a>

    <div class="product-body">
      <p class="product-eyebrow">${escapeHtml(presentation.eyebrow)}</p>
      <h3 class="product-title">
        <a href="${escapeHtml(presentation.productPath)}">${escapeHtml(presentation.displayTitle)}</a>
      </h3>
      ${specSectionMarkup}
      <div class="product-detail-row">${detailMarkup}</div>
      <div class="product-price-block">
        <div class="product-price-row">
          <span class="price-kes">${escapeHtml(presentation.pricing.priceText)}</span>
          ${compareMarkup}
        </div>
        <p class="savings-note ${escapeHtml(presentation.pricing.hasDiscount ? 'discount' : 'neutral')}">${escapeHtml(priceSupportText)}</p>
      </div>
      <p class="stock-line ${escapeHtml(presentation.stock.tone)}">
        <span class="stock-dot"></span>
        ${escapeHtml(presentation.stock.detail)}
      </p>
      <div class="product-actions">${actionMarkup}</div>
    </div>
  </article>
`;
---

<div class="product-card-shell" set:html={cardHtml}></div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at top right, rgb(219 234 254 / 0.7), transparent 24%),
      linear-gradient(180deg, rgb(255 255 255 / 0.98), rgb(248 250 252 / 0.98));
    box-shadow: 0 16px 36px rgb(15 23 42 / 0.06);
    transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
  }

  .product-card-shell {
    display: contents;
  }

  .product-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    padding: 0.8rem;
    background:
      radial-gradient(circle at top, rgb(219 234 254 / 0.7), transparent 42%),
      linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .product-badge-row,
  .deal-badge-row {
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    gap: 0.5rem;
    pointer-events: none;
  }

  .product-badge-row {
    top: 0.85rem;
  }

  .deal-badge-row {
    bottom: 0.85rem;
  }

  .status-badge,
  .detail-chip,
  .discount-chip,
  .percent-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.9rem;
    padding: 0.36rem 0.72rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .condition {
    border: 1px solid rgb(203 213 225 / 0.82);
    background: rgb(241 245 249 / 0.96);
    color: #334155;
  }

  .condition.new {
    border-color: rgb(147 197 253 / 0.72);
    background: rgb(219 234 254 / 0.9);
    color: #1d4ed8;
  }

  .condition.refurbished {
    border-color: rgb(253 186 116 / 0.72);
    background: rgb(255 247 237 / 0.96);
    color: #c2410c;
  }

  .stock {
    margin-left: auto;
  }

  .stock.in {
    background: rgb(220 252 231 / 0.95);
    color: #166534;
  }

  .stock.low {
    background: rgb(254 249 195 / 0.96);
    color: #854d0e;
  }

  .stock.out {
    background: rgb(254 226 226 / 0.95);
    color: #991b1b;
  }

  .discount-chip {
    background: rgb(249 115 22 / 0.14);
    color: var(--accent-hover);
  }

  .percent-chip {
    margin-left: auto;
    background: var(--primary);
    color: var(--white);
  }

  .product-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1rem;
  }

  .product-eyebrow {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .product-title {
    margin: 0;
    min-height: 4.1em;
    font-size: 1.05rem;
    line-height: 1.36;
    color: #0f172a;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    text-wrap: pretty;
  }

  .product-title a {
    color: inherit;
    text-decoration: none;
  }

  .product-spec-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .spec-item {
    display: grid;
    gap: 0.14rem;
    padding: 0.6rem 0.68rem;
    border: 1px solid rgb(226 232 240 / 0.92);
    border-radius: 0.9rem;
    background: rgb(248 250 252 / 0.96);
  }

  .spec-label {
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .spec-value {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.35;
    color: #0f172a;
  }

  .product-spec-fallback {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .product-detail-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-height: 1.9rem;
  }

  .detail-chip {
    border: 1px solid rgb(203 213 225 / 0.82);
    background: rgb(241 245 249 / 0.95);
    color: #334155;
  }

  .grade-chip {
    border-color: rgb(29 78 216 / 0.15);
    background: rgb(29 78 216 / 0.08);
    color: var(--primary);
  }

  .detail-chip-warn {
    border-color: rgb(253 224 71 / 0.72);
    background: rgb(254 249 195 / 0.92);
    color: #854d0e;
  }

  .product-price-block {
    margin-top: auto;
  }

  .product-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
  }

  .price-kes {
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1.1;
    color: var(--primary);
  }

  .compare-price {
    font-size: 0.92rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .savings-note {
    margin: 0.28rem 0 0;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .savings-note.discount {
    color: var(--accent-hover);
  }

  .savings-note.neutral {
    color: var(--text-muted);
  }

  .stock-line {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .stock-line.in {
    color: #166534;
  }

  .stock-line.low {
    color: #854d0e;
  }

  .stock-line.out {
    color: #991b1b;
  }

  .stock-dot {
    width: 0.55rem;
    height: 0.55rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: currentColor;
  }

  .product-actions {
    display: grid;
  }

  .product-actions .pill-button {
    min-height: 2.9rem;
    justify-content: center;
    padding: 0.7rem 0.9rem;
    border: 1px solid transparent;
    font-size: 0.88rem;
  }

  .whatsapp-btn {
    background: #25d366;
    color: var(--white);
  }

  .whatsapp-btn:hover {
    background: #1faa53;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover {
      transform: translateY(-4px);
      border-color: rgb(29 78 216 / 0.2);
      box-shadow: 0 20px 42px rgb(15 23 42 / 0.1);
    }

    .product-card:hover .product-image {
      transform: scale(1.05);
    }
  }

  @media (max-width: 639px) {
    .product-media {
      padding: 0.68rem;
    }

    .product-body {
      padding: 0.9rem;
    }

    .product-spec-list {
      grid-template-columns: 1fr;
    }

    .product-title {
      min-height: 4.35em;
      font-size: 1rem;
    }

    .price-kes {
      font-size: 1.24rem;
    }
  }
</style>

<script>
  import { addCartItem } from '../lib/cartClient';

  const appWindow = window as typeof window & { __sesProductCardBound?: boolean };

  if (!appWindow.__sesProductCardBound) {
    appWindow.__sesProductCardBound = true;

    document.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement | null)?.closest('.add-to-cart-btn');
      if (!(target instanceof HTMLButtonElement) || target.disabled) {
        return;
      }

      const id = (target.dataset.id || '').trim();
      if (!id) {
        return;
      }

      addCartItem({
        id,
        title: target.dataset.title || '',
        price_kes: Math.round(Number(target.dataset.price || '0')),
        slug: target.dataset.slug || null,
        image: target.dataset.image || '',
        qty: 1
      });

      const originalText = target.textContent;
      target.textContent = 'Added';
      target.style.backgroundColor = '#059669';

      setTimeout(() => {
        target.textContent = originalText;
        target.style.backgroundColor = '';
      }, 1800);
    });
  }
</script>
