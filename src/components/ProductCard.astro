---
interface Props {
  product: any;
}

const { product } = Astro.props;
const hasDiscount = product.compare_at_kes && product.compare_at_kes > product.price_kes;
const discountPercent = hasDiscount 
  ? Math.round(((product.compare_at_kes - product.price_kes) / product.compare_at_kes) * 100) 
  : 0;
---

<article class="product-card">
  <div class="product-image-wrapper">
    <a href={`/product/${product.slug}`}>
      <img src={product.images[0] || '/product-placeholder.jpg'} alt={product.title} loading="lazy" class="product-image" />
    </a>
    {hasDiscount && <span class="badge sale">-{discountPercent}% OFF</span>}
    <span class={`badge ${product.in_stock ? 'stock' : 'out-of-stock'}`}>
      {product.in_stock ? 'In Stock' : 'Out of Stock'}
    </span>
    {product.condition === 'refurbished' && <span class="badge condition">Refurbished</span>}
  </div>

  <div class="product-info">
    <p class="product-category">{product.category}</p>
    <h3 class="product-title">
      <a href={`/product/${product.slug}`}>{product.title}</a>
    </h3>
    <p class="product-specs">{product.short_specs}</p>
    
    <div class="product-price-row">
      <div class="prices">
        <span class="price-kes">KSh {product.price_kes.toLocaleString()}</span>
        {hasDiscount && <span class="compare-price">KSh {product.compare_at_kes.toLocaleString()}</span>}
      </div>
    </div>

    <div class="product-actions">
      <button 
        class="pill-button primary add-to-cart-btn" 
        data-id={product.id} 
        data-title={product.title} 
        data-price={product.price_kes}
        data-slug={product.slug}
        data-image={product.images[0]}
      >
        Add to Cart
      </button>
      <a 
        href={`https://wa.me/254720480475?text=${encodeURIComponent(`Hi SES ICT HUB, I need help with: ${product.title} — https://sesicthub.co.ke/product/${product.slug}`)}`} 
        class="whatsapp-icon-btn" 
        aria-label="Inquire on WhatsApp"
        target="_blank"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.435 5.617 1.436h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    background-color: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .product-image-wrapper {
    position: relative;
    aspect-ratio: 1/1;
    background-color: #f1f5f9;
    overflow: hidden;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .badge {
    position: absolute;
    top: 10px;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .badge.sale {
    left: 10px;
    background-color: var(--accent);
    color: var(--white);
  }

  .badge.stock {
    right: 10px;
    background-color: #DEF7EC;
    color: #03543F;
  }

  .badge.out-of-stock {
    right: 10px;
    background-color: #FDE8E8;
    color: #9B1C1C;
  }

  .badge.condition {
    bottom: 10px;
    left: 10px;
    background-color: #E1EFFE;
    color: #1E429F;
  }

  .product-info {
    padding: var(--space-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .product-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .product-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.8em;
  }

  .product-specs {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .product-price-row {
    margin-top: auto;
    margin-bottom: var(--space-md);
  }

  .price-kes {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--primary);
  }

  .compare-price {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: line-through;
    margin-left: 0.5rem;
  }

  .product-actions {
    display: flex;
    gap: 0.5rem;
  }

  .add-to-cart-btn {
    flex: 1;
    justify-content: center;
    font-size: 0.875rem;
  }

  .whatsapp-icon-btn {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #25D366;
    color: var(--white);
    transition: transform 0.2s ease;
  }

  .whatsapp-icon-btn:hover {
    transform: scale(1.1);
  }
</style>

<script>
  // Add to Cart Logic
  const addButtons = document.querySelectorAll('.add-to-cart-btn');
  addButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const item = {
        id: target.dataset.id,
        title: target.dataset.title,
        price_kes: parseInt(target.dataset.price || '0'),
        slug: target.dataset.slug,
        image: target.dataset.image,
        qty: 1
      };
      
      let cart = JSON.parse(localStorage.getItem('ses_cart') || '[]');
      const existing = cart.find((i: any) => i.id === item.id);
      
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push(item);
      }
      
      localStorage.setItem('ses_cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-updated'));
      
      // Feedback
      const originalText = target.textContent;
      target.textContent = 'Added! ✓';
      target.style.backgroundColor = '#059669';
      setTimeout(() => {
        target.textContent = originalText;
        target.style.backgroundColor = '';
      }, 2000);
    });
  });
</script>
