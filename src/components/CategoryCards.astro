---
import { buildImageOnError, getSiteAssets } from '../lib/siteAssets';
import { STOREFRONT_CATEGORIES } from '../lib/productPresentation';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const printersCardOnError = buildImageOnError(siteAssets.categoryCards.printersLegacy.fallback);

const categories = STOREFRONT_CATEGORIES.map((category) => ({
  name: category.label,
  slug: category.slug,
  image:
    category.slug === 'laptops'
      ? siteAssets.categoryCards.laptops.src
      : category.slug === 'desktops'
        ? siteAssets.categoryCards.desktops.src
      : category.slug === 'printers'
        ? siteAssets.categoryCards.printers.src
        : category.slug === 'accessories'
          ? siteAssets.categoryCards.accessories.src
          : siteAssets.categoryCards.smartphones.src,
  alt: `${category.label} collection`,
  onerror: category.slug === 'printers' ? printersCardOnError : undefined
}));
---

<section class="categories">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Shop by Category</h2>
      <a href="/shop" class="text-link">Browse full shop &rarr;</a>
    </div>
    
    <div class="category-grid">
      {categories.map(cat => (
        <a href={`/category/${cat.slug}`} class="category-card">
          <div class="category-media">
            <img src={cat.image} alt={cat.alt} class="category-image" loading="lazy" onerror={cat.onerror} />
          </div>
          <div class="category-body">
            <h3 class="category-name">{cat.name}</h3>
            <p class="category-count">Shop now</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categories {
    padding: var(--space-xl) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
  }

  .text-link {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .category-card {
    background-color: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-sm);
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 35px rgb(15 23 42 / 0.15);
    border-color: var(--primary);
  }

  .category-media {
    aspect-ratio: 16/10;
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
  }

  .category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .category-card:hover .category-image {
    transform: scale(1.04);
  }

  .category-body {
    text-align: center;
    padding: var(--space-md);
  }

  .category-name {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .category-count {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
