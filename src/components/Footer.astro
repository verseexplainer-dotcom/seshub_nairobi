---
import { buildImageOnError, getSiteAssets } from '../lib/siteAssets';
import { footerContactLinks, mainShopLinks, paymentMethods, storefrontDetails, supportLinks } from '../lib/storefront';

const year = new Date().getFullYear();
const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const logoImage = siteAssets.logo;
const logoOnError = buildImageOnError(logoImage.fallback);
const companyLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
  { label: 'Track Order', href: '/track' },
  { label: 'FAQ', href: '/faq' }
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <section class="footer-brand">
      <a href="/" class="footer-logo" aria-label="SES ICT HUB home">
        <img src={logoImage.src} alt="SES ICT HUB logo" class="footer-logo-image" loading="lazy" decoding="async" onerror={logoOnError} />
      </a>

      <div class="footer-brand-copy">
        <h2>{storefrontDetails.brandName}</h2>
        <p>
          A modern Nairobi electronics storefront focused on clear specs, faster stock confirmation, and premium support from first click to final delivery.
        </p>
      </div>

      <div class="footer-socials" aria-label="Contact and social actions">
        {footerContactLinks.map((link) => (
          <a href={link.href} class={`footer-social-link ${link.tone || 'neutral'}`}>{link.label}</a>
        ))}
      </div>

      <div class="footer-payments" aria-label="Payment methods">
        {paymentMethods.map((method) => (
          <span class="footer-payment-pill">{method}</span>
        ))}
      </div>
    </section>

    <div class="footer-links-grid">
      <nav class="footer-column" aria-labelledby="footer-shop-title">
        <h3 id="footer-shop-title">Shop</h3>
        <ul role="list">
          {mainShopLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><a href="/shop">Browse Shop</a></li>
          <li><a href="/shop?sort=featured">Featured</a></li>
        </ul>
      </nav>

      <nav class="footer-column" aria-labelledby="footer-support-title">
        <h3 id="footer-support-title">Support</h3>
        <ul role="list">
          {supportLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li><a href="/cart">Cart</a></li>
          <li><a href="/auth/login">Sign In</a></li>
        </ul>
      </nav>

      <nav class="footer-column" aria-labelledby="footer-company-title">
        <h3 id="footer-company-title">Company</h3>
        <ul role="list">
          {companyLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="container footer-bottom">
    <div class="footer-contact-stack">
      <p>{storefrontDetails.fullLocation}</p>
      <div class="footer-contact-inline">
        <a href={`tel:${storefrontDetails.phone.replace(/\s+/g, '')}`}>{storefrontDetails.phone}</a>
        <a href={`mailto:${storefrontDetails.email}`}>{storefrontDetails.email}</a>
      </div>
    </div>

    <div class="footer-legal">
      <p>&copy; {year} {storefrontDetails.brandName}. All rights reserved.</p>
      <p>{storefrontDetails.deliverySummary}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: clamp(2.6rem, 5vw, 4rem);
    border-top: 1px solid rgba(229, 231, 235, 0.92);
    background:
      radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 24%),
      linear-gradient(180deg, rgba(248, 250, 252, 0.94), rgba(255, 255, 255, 1));
  }

  .footer-top {
    display: grid;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
  }

  .footer-logo {
    display: inline-flex;
    width: fit-content;
  }

  .footer-logo-image {
    width: clamp(4.4rem, 8vw, 5.4rem);
    height: clamp(4.4rem, 8vw, 5.4rem);
    padding: 0.45rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-sm);
  }

  .footer-brand-copy {
    display: grid;
    gap: 0.7rem;
    max-width: 34rem;
  }

  .footer-brand-copy h2 {
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    letter-spacing: -0.04em;
  }

  .footer-brand-copy p {
    color: var(--color-text-muted);
  }

  .footer-socials,
  .footer-payments,
  .footer-contact-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .footer-social-link,
  .footer-payment-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 800;
  }

  .footer-social-link {
    border: 1px solid rgba(226, 232, 240, 0.92);
    background: rgba(255, 255, 255, 0.92);
    color: #334155;
  }

  .footer-social-link.whatsapp {
    border-color: rgba(37, 211, 102, 0.28);
    color: #0f7d44;
  }

  .footer-payment-pill {
    background: rgba(37, 99, 235, 0.08);
    color: var(--color-primary);
  }

  .footer-links-grid {
    display: grid;
    gap: 1.5rem;
  }

  .footer-column {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .footer-column h3 {
    font-size: 0.96rem;
  }

  .footer-column ul {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    list-style: none;
  }

  .footer-column a,
  .footer-contact-stack p,
  .footer-contact-inline a,
  .footer-legal p {
    color: var(--color-text-muted);
  }

  .footer-column a:hover,
  .footer-contact-inline a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    display: grid;
    gap: 1rem;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid rgba(229, 231, 235, 0.92);
  }

  .footer-contact-stack {
    display: grid;
    gap: 0.6rem;
  }

  .footer-legal {
    display: grid;
    gap: 0.35rem;
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }

    .footer-links-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .footer-bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      justify-content: space-between;
    }

    .footer-legal {
      text-align: right;
    }
  }
</style>
