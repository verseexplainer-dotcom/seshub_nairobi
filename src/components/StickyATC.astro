---
import { getProductPresentation } from '../lib/productPresentation';
import { getSiteAssets } from '../lib/siteAssets';
import { buildWhatsAppLink } from '../lib/storefront';

interface Props {
  product: Record<string, any>;
}

const { product } = Astro.props;
const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const finalFallbackImage = '/product-placeholder.svg';
const fallbackImage = (import.meta.env.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder.src || finalFallbackImage).trim();
const imageOnError = `if(this.dataset.fallbackApplied==='1'){this.onerror=null;this.src=${JSON.stringify(finalFallbackImage)};}else{this.dataset.fallbackApplied='1';this.src=${JSON.stringify(fallbackImage)};}`;
const presentation = getProductPresentation(product, {
  publicSupabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL,
  fallbackImage
});
const whatsAppUrl = buildWhatsAppLink(
  `Hi SES ICT HUB, I'm interested in: ${presentation.rawTitle} — https://sesicthub.co.ke/product/${product.slug}`
);
const escapeHtml = (value: unknown) =>
  String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
const addToCartLabel = `Add ${presentation.displayTitle} to cart`;
const thumbMarkup = presentation.primaryImageUrl
  ? `<div class="sticky-thumb-shell" data-product-media><img src="${escapeHtml(presentation.primaryImageUrl)}" alt="" class="sticky-thumb" onerror="${escapeHtml(imageOnError)}" /></div>`
  : '<div class="sticky-thumb-shell no-image" data-product-media aria-hidden="true"></div>';
const actionMarkup = presentation.stock.isInStock
  ? `
    <button
      class="pill-button primary add-to-cart-btn sticky-action"
      data-add-to-cart
      data-id="${escapeHtml(product.id)}"
      data-title="${escapeHtml(presentation.rawTitle)}"
      data-price="${escapeHtml(presentation.pricing.price)}"
      data-slug="${escapeHtml(product.slug)}"
      data-image="${escapeHtml(presentation.primaryImageUrl || '')}"
      aria-label="${escapeHtml(addToCartLabel)}"
    >
      Add to Cart
    </button>
  `
  : `
    <button class="pill-button sticky-action" type="button" disabled aria-disabled="true">
      Out of Stock
    </button>
  `;
const compareMarkup = presentation.pricing.compareAtText
  ? `<p class="sticky-compare">${escapeHtml(presentation.pricing.compareAtText)}</p>`
  : '';
const stickyHtml = `
  <div class="sticky-atc" id="sticky-atc">
    <div class="container sticky-atc-content">
      <div class="sticky-info">
        ${thumbMarkup}
        <div class="sticky-text">
          <h3 class="sticky-title">${escapeHtml(presentation.displayTitle)}</h3>
          <div class="sticky-price-row">
            <p class="sticky-price">${escapeHtml(presentation.pricing.priceText)}</p>
            ${compareMarkup}
          </div>
          <p class="sticky-stock ${escapeHtml(presentation.stock.tone)}">${escapeHtml(presentation.stock.detail)}</p>
        </div>
      </div>

      <div class="sticky-actions">
        <a href="${escapeHtml(whatsAppUrl)}" class="pill-button accent sticky-action" target="_blank" rel="noreferrer">
          WhatsApp
        </a>
        ${actionMarkup}
      </div>
    </div>
  </div>
`;
---

<div class="sticky-atc-shell" set:html={stickyHtml}></div>

<style>
  .sticky-atc-shell {
    display: contents;
  }

  .sticky-atc {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 100;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    border-top: 1px solid var(--border);
    background: rgb(255 255 255 / 0.98);
    box-shadow: 0 -10px 30px rgb(15 23 42 / 0.08);
    backdrop-filter: blur(14px);
  }

  .sticky-atc.visible {
    transform: translateY(0);
  }

  .sticky-atc-content {
    display: grid;
    gap: 0.85rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .sticky-info {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
  }

  .sticky-thumb-shell {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 0.9rem;
    background: #f8fafc;
    border: 1px solid var(--border);
  }

  .sticky-thumb {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }

  .sticky-thumb-shell.no-image::after {
    content: 'Photo unavailable';
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .sticky-text {
    min-width: 0;
  }

  .sticky-title {
    margin: 0 0 0.2rem;
    font-size: 0.95rem;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
  }

  .sticky-price,
  .sticky-compare,
  .sticky-stock {
    margin: 0;
  }

  .sticky-price {
    font-weight: 900;
    color: var(--primary);
  }

  .sticky-compare {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .sticky-stock {
    font-size: 0.82rem;
    font-weight: 700;
  }

  .sticky-stock.in {
    color: #166534;
  }

  .sticky-stock.low {
    color: #854d0e;
  }

  .sticky-stock.out {
    color: #991b1b;
  }

  .sticky-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .sticky-action {
    width: 100%;
    min-height: 3rem;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .sticky-atc-content {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .sticky-actions {
      width: min(28rem, 100%);
    }
  }
</style>

<script>
  const sticky = document.getElementById('sticky-atc');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 420) {
      sticky?.classList.add('visible');
    } else {
      sticky?.classList.remove('visible');
    }
  });
</script>
