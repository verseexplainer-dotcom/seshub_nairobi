---
import '../styles/home.css';
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeaturedCategories from '../components/home/FeaturedCategories.astro';
import DealStrip from '../components/home/DealStrip.astro';
import ProductShowcase from '../components/home/ProductShowcase.astro';
import TrustBar from '../components/home/TrustBar.astro';
import WhyBuyFromSES from '../components/home/WhyBuyFromSES.astro';
---

<Layout
  title="Quality laptops, printers, and tech deals in Kenya"
  description="Shop laptops, printers, desktops, accessories, and tech deals from SES ICT HUB with clear prices, warranty support, and delivery in Kenya."
  canonical="/"
  hideAnnouncementStrip
>
  <div class="home-page">
    <HomeHero />
    <FeaturedCategories />
    <DealStrip />
    <ProductShowcase />
    <TrustBar />
    <WhyBuyFromSES />
  </div>
</Layout>
