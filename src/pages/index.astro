---
import '../styles/home.css';
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeaturedCategories from '../components/home/FeaturedCategories.astro';
import FeaturedDeals from '../components/home/FeaturedDeals.astro';
import WhyBuyFromSES from '../components/home/WhyBuyFromSES.astro';
import BrandStrip from '../components/home/BrandStrip.astro';
import SplitPromoBanners from '../components/home/SplitPromoBanners.astro';
import Testimonials from '../components/Testimonials.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCatalogCategoryKey, getHomepageProducts } from '../lib/catalog';
import { homepageTestimonials } from '../lib/homepageContent';
import { selectBestValueProducts, selectDealsProducts, selectFeaturedProducts } from '../lib/homepage';
import type { CatalogProduct } from '../types/catalog';

const publicSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const catalogProducts = await getHomepageProducts(Astro.locals);
const laptopProducts = catalogProducts.filter((product) => getCatalogCategoryKey(product) === 'laptops');
const smartphoneProducts = catalogProducts.filter((product) => getCatalogCategoryKey(product) === 'smartphones');
const printerProducts = catalogProducts.filter((product) => getCatalogCategoryKey(product) === 'printers');
const featuredDealSeeds = [
  ...selectDealsProducts(catalogProducts, 12),
  ...selectBestValueProducts(laptopProducts, 6),
  ...selectBestValueProducts(smartphoneProducts, 3),
  ...selectBestValueProducts(printerProducts, 3)
];
const fallbackFeaturedDeals = [
  ...selectFeaturedProducts(catalogProducts, 16)
];
const featuredDeals = pickUniqueProducts([...featuredDealSeeds, ...fallbackFeaturedDeals], 12);

function pickUniqueProducts(products: CatalogProduct[], limit: number) {
  const seen = new Set<string>();
  const picked: CatalogProduct[] = [];

  for (const product of products) {
    const key = product.slug || product.id || product.title;
    if (!key || seen.has(key)) {
      continue;
    }

    seen.add(key);
    picked.push(product);
    if (picked.length === limit) {
      break;
    }
  }

  return picked;
}
---

<Layout
  title="Laptops, desktops, printers, and tech deals in Kenya"
  description="Shop current laptops, printers, desktops, smartphones, and office tech from SES ICT HUB with clear prices, support, and delivery across Kenya."
  canonical="/"
  hideAnnouncementStrip
>
  <div class="home-page">
    <HomeHero />
    <FeaturedCategories />
    <WhyBuyFromSES />
    <FeaturedDeals products={featuredDeals} publicSupabaseUrl={publicSupabaseUrl} />
    <BrandStrip />
    <SplitPromoBanners />
    <Testimonials items={homepageTestimonials} />
    <Newsletter />
  </div>
</Layout>
