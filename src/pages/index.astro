---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BrandCarousel from '../components/BrandCarousel.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import ProductShowcaseSection from '../components/ProductShowcaseSection.astro';
import DealOfDay from '../components/DealOfDay.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Testimonials from '../components/Testimonials.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Newsletter from '../components/Newsletter.astro';
import { supabase } from '../lib/supabase';
import { getProductBrand } from '../lib/productPresentation';
import { homeTestimonials, type HomeTestimonial } from '../lib/homepageContent';

const { data: catalogData } = await supabase
  .from('products')
  .select('id,title,slug,category,price_kes,compare_at_kes,images,short_specs,description,in_stock,stock_qty,condition,refurb_grade,warranty_months,featured_home,featured_rank,brand,updated_at')
  .order('updated_at', { ascending: false });

const { data: testimonialData } = await supabase
  .from('testimonials')
  .select('id,name,persona,rating,quote,created_at')
  .eq('approved', true)
  .order('created_at', { ascending: false })
  .order('name', { ascending: true })
  .limit(12);

const catalog = catalogData ?? [];
const testimonials: HomeTestimonial[] = [];
const seenTestimonials = new Set<string>();

for (const item of testimonialData ?? []) {
  const testimonial = {
    id: String(item.id ?? ''),
    name: String(item.name ?? '').trim(),
    persona: String(item.persona ?? '').trim(),
    rating: Math.max(1, Math.min(5, Number(item.rating || 5))),
    quote: String(item.quote ?? '').trim()
  };

  const testimonialKey = `${testimonial.name.toLowerCase()}::${testimonial.persona.toLowerCase()}`;
  if (!testimonial.name || !testimonial.quote || seenTestimonials.has(testimonialKey)) {
    continue;
  }

  seenTestimonials.add(testimonialKey);
  testimonials.push(testimonial);

  if (testimonials.length === 6) {
    break;
  }
}

const homepageTestimonials = testimonials.length ? testimonials : homeTestimonials;
const inStockProducts = catalog.filter((product) => product.in_stock);
const discountedProducts = inStockProducts.filter((product) => Number(product.compare_at_kes || 0) > Number(product.price_kes || 0));

const newArrivals = inStockProducts.slice(0, 4);
const bestSellerCandidates = [...inStockProducts].sort((left, right) => {
  const featuredDelta = Number(right.featured_home) - Number(left.featured_home);
  if (featuredDelta !== 0) return featuredDelta;

  const featuredRankDelta = Number(left.featured_rank || 999) - Number(right.featured_rank || 999);
  if (featuredRankDelta !== 0) return featuredRankDelta;

  return Number(right.stock_qty || 0) - Number(left.stock_qty || 0);
});

const bestSellers = bestSellerCandidates
  .filter((product) => !newArrivals.some((entry) => entry.id === product.id))
  .slice(0, 4);

const fallbackBestSellers = bestSellers.length >= 4 ? bestSellers : bestSellerCandidates.slice(0, 4);
const spotlightProduct = newArrivals[0] || fallbackBestSellers[0] || discountedProducts[0] || null;
const dealProduct = discountedProducts[0] || spotlightProduct;
const brandCount = new Set(inStockProducts.map((product) => getProductBrand(product))).size;
const dealCount = discountedProducts.length;

const categoryCounts = {
  laptops: inStockProducts.filter((product) => String(product.category || '').toLowerCase() === 'laptops').length,
  smartphones: inStockProducts.filter((product) => String(product.category || '').toLowerCase() === 'smartphones').length,
  printers: inStockProducts.filter((product) => String(product.category || '').toLowerCase() === 'printers').length,
  shop: inStockProducts.length,
  inStock: inStockProducts.length,
  newest: newArrivals.length,
  featured: fallbackBestSellers.length,
  budget: inStockProducts.length
};

const categoryCards = [
  {
    title: 'Laptops',
    count: categoryCounts.laptops || 0,
    href: '/category/laptops',
    description: 'Portable business, study, and creative work machines.',
    accent: '#2563eb'
  },
  {
    title: 'Smartphones',
    count: categoryCounts.smartphones || 0,
    href: '/category/smartphones',
    description: 'Daily drivers, premium upgrades, and reliable resale stock.',
    accent: '#0f766e'
  },
  {
    title: 'Printers',
    count: categoryCounts.printers || 0,
    href: '/category/printers',
    description: 'Home and office printers with practical setup guidance.',
    accent: '#7c3aed'
  },
  {
    title: 'Shop All',
    count: categoryCounts.shop || 0,
    href: '/shop',
    description: 'Browse the full live catalog with search, sorting, and stock-aware product cards.',
    accent: '#ea580c'
  },
  {
    title: 'In Stock',
    count: categoryCounts.inStock || 0,
    href: '/shop?in_stock=1',
    description: 'Focus on products currently marked available for faster checkout decisions.',
    accent: '#2563eb'
  },
  {
    title: 'Newest',
    count: categoryCounts.newest || 0,
    href: '/shop?sort=newest',
    description: 'Jump to the latest additions from the current catalog sync.',
    accent: '#16a34a'
  },
  {
    title: 'Featured',
    count: categoryCounts.featured || 0,
    href: '/shop?sort=featured',
    description: 'See featured products and high-priority stock from the live storefront.',
    accent: '#1d4ed8'
  },
  {
    title: 'Budget Picks',
    count: categoryCounts.budget || 0,
    href: '/shop?sort=price_asc',
    description: 'Start with lower prices first, then refine by brand, stock, and category.',
    accent: '#d97706'
  }
];

const dealDeadline = new Date(Date.now() + 1000 * 60 * 60 * 18).toISOString();
---

<Layout
  title="Premium electronics for Nairobi buyers"
  description="Shop laptops, smartphones, printers, desktops, and accessories from SES ICT HUB with a premium homepage experience, live deals, and faster WhatsApp-assisted checkout."
>
  <Hero spotlightProduct={spotlightProduct} totalProducts={inStockProducts.length} brandCount={brandCount} dealCount={dealCount} />
  <BrandCarousel />
  <CategoryGrid items={categoryCards} />
  <ProductShowcaseSection
    id="new-arrivals-title"
    kicker="New arrivals"
    title="Fresh additions from the live catalog"
    description="Latest in-stock products surfaced from the current inventory, designed to feel premium without disconnecting from the actual Supabase catalog."
    products={newArrivals}
    context="arrival"
    ctaHref="/shop?sort=newest"
    ctaLabel="See new arrivals"
  />
  <DealOfDay product={dealProduct} deadlineISO={dealDeadline} />
  <WhyChooseUs />
  <ProductShowcaseSection
    id="best-sellers-title"
    kicker="Best sellers"
    title="Popular products with stronger buyer momentum"
    description="This section uses featured ranking and stock weight as a clean fallback until true order-volume based best-seller signals are available."
    products={fallbackBestSellers}
    context="seller"
    variant="contrast"
    ctaHref="/shop?sort=featured"
    ctaLabel="Explore featured stock"
  />
  <Testimonials items={homepageTestimonials} />
  <BlogPreview />
  <Newsletter />
</Layout>
