---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryCards from '../components/CategoryCards.astro';
import SearchBar from '../components/SearchBar.astro';
import TrustBar from '../components/TrustBar.astro';
import { STOREFRONT_CATEGORIES } from '../lib/productPresentation';
import { isSupabaseConfigured, supabase } from '../lib/supabase';
import { getSiteAssets } from '../lib/siteAssets';

let featuredProducts: Array<Record<string, unknown>> = [];
let testimonials: Array<Record<string, unknown>> = [];

if (isSupabaseConfigured) {
  const { data: featuredData } = await supabase
    .from('products')
    .select('*')
    .eq('featured_home', true)
    .eq('in_stock', true)
    .order('featured_rank', { ascending: true, nullsFirst: false })
    .order('updated_at', { ascending: false })
    .limit(12);

  const { data: testimonialData } = await supabase
    .from('testimonials')
    .select('id, name, quote, approved')
    .eq('approved', true)
    .limit(6);

  featuredProducts = featuredData || [];
  testimonials = testimonialData || [];
}

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const heroImage = siteAssets.hero;
const logoImage = siteAssets.logo;
const logoFallback = siteAssets.logoFallback;
const fallbackImage = (import.meta.env.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder || '/product-placeholder.svg').trim();
const imageOnError = `if(this.dataset.fallbackApplied==='1'){this.onerror=null;this.src='/product-placeholder.svg';}else{this.dataset.fallbackApplied='1';this.src=${JSON.stringify(fallbackImage)};}`;
const logoOnError = `if(this.dataset.fallbackApplied==='1'){this.onerror=null;}else{this.dataset.fallbackApplied='1';this.src=${JSON.stringify(logoFallback)};}`;
---

<Layout
  title="Shop Laptops, Smartphones, and Printers in Nairobi"
  description="Brand-new and refurbished electronics in Nairobi with live pricing, clear specs, and trusted pickup or delivery from SES ICT HUB."
>
  <section class="hero reveal">
    <div class="container">
      <div class="hero-shell">
        <div class="hero-copy">
          <div class="hero-brand">
            <img src={logoImage} alt="SES ICT HUB logo" class="hero-logo" loading="eager" decoding="async" onerror={logoOnError} />
            <div>
              <p class="hero-eyebrow">SES ICT HUB</p>
              <span class="hero-brand-note">Electronics for work, study, and business</span>
            </div>
          </div>

          <div class="hero-chip-row" aria-label="Primary shopping categories">
            {STOREFRONT_CATEGORIES.map((category) => (
              <a href={`/category/${category.slug}`} class="hero-chip">{category.label}</a>
            ))}
          </div>

          <h1>Shop laptops, smartphones, and printers with fast Nairobi support.</h1>
          <p class="hero-subtitle">
            Brand-new and refurbished devices with live pricing, clear specs, and trusted pickup or delivery
            from our Moi Avenue store.
          </p>

          <div class="hero-actions">
            <a class="pill-button cta-orange" href="/shop">Browse Shop</a>
            <a
              class="pill-button hero-secondary"
              href="https://wa.me/254720480475?text=Hi%20SES%20ICT%20HUB%2C%20I%20need%20help%20choosing%20a%20device."
              target="_blank"
              rel="noreferrer"
            >
              Get a Quote on WhatsApp
            </a>
          </div>

          <div class="hero-proof-grid" aria-label="Store trust highlights">
            <article class="hero-proof-card">
              <strong>2-hour Nairobi delivery</strong>
              <span>Quick dispatch for urgent work, school, and business needs.</span>
            </article>
            <article class="hero-proof-card">
              <strong>M-PESA and pay on delivery</strong>
              <span>Flexible checkout options for local orders and store pickup.</span>
            </article>
            <article class="hero-proof-card">
              <strong>Live catalog pricing</strong>
              <span>Browse the same stock, pricing, and categories that are in the database now.</span>
            </article>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-visual-frame">
            <img
              src={heroImage}
              alt="SES ICT HUB hero lineup showing desktop, laptop, smartphone, and headphones"
              class="hero-banner-image"
              loading="eager"
              onerror={imageOnError}
            />
            <div class="hero-floating-card top">
              <span class="hero-floating-label">Fast support</span>
              <strong>WhatsApp replies with real product help</strong>
            </div>
            <div class="hero-floating-card bottom">
              <span class="hero-floating-label">Shop focus</span>
              <strong>Laptops, smartphones, and printers only</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-search reveal">
    <div class="container">
      <div class="home-search-card">
        <div>
          <p class="home-search-eyebrow">Search the live catalog</p>
          <h2>Find a model or brand faster</h2>
          <p class="home-search-copy">Use quick search for product names and brands, then narrow down with category filters if you need more detail.</p>
        </div>
        <SearchBar variant="inline" placeholder="Search laptops, smartphones, printers, or brands..." />
      </div>
    </div>
  </section>

  <CategoryCards />
  <TrustBar />

  {testimonials && testimonials.length > 0 && (
    <section class="social-proof reveal">
      <div class="container">
        <h2>Trusted by Nairobi Buyers</h2>
        <div class="testimonial-grid">
          {testimonials.map((item) => (
            <article class="testimonial-card">
              <p class="quote">"{item.quote}"</p>
              <p class="author">{item.name}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="compare reveal">
    <div class="container">
      <h2>Why Buyers Are Switching to SES ICT HUB</h2>
      <div class="compare-grid">
        <article class="compare-card old-way">
          <h3>The Old Way</h3>
          <ul>
            <li>Unreliable grading and hidden defects</li>
            <li>No clear testing report before purchase</li>
            <li>Little or no warranty support</li>
          </ul>
        </article>
        <article class="compare-card ses-way">
          <h3>The SES Way</h3>
          <ul>
            <li>Grade A/B/C certified refurbishment process</li>
            <li>Verified specs and tested performance</li>
            <li>Up to 12-month warranty cover</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="benefits reveal">
    <div class="container">
      <h2>Built for Speed, Power, and Trust</h2>
      <div class="benefit-grid">
        <article class="benefit-card">
          <h3>Speed</h3>
          <p>2-hour delivery within Nairobi for urgent work and school needs.</p>
        </article>
        <article class="benefit-card">
          <h3>Power</h3>
          <p>Core i5/i7 performance tiers for students, creators, and business teams.</p>
        </article>
        <article class="benefit-card">
          <h3>Trust</h3>
          <p>Visit our physical shop at Tembo Cooperative House before you buy.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="how-it-works reveal">
    <div class="container">
      <h2>How It Works</h2>
      <ol>
        <li><strong>1. Browse Specs</strong> and shortlist devices that match your workload.</li>
        <li><strong>2. Inquire via WhatsApp</strong> for live stock confirmation and expert help.</li>
        <li><strong>3. Inspect & Pay on Delivery</strong> via M-PESA or Cash on Delivery.</li>
      </ol>
    </div>
  </section>

  <section class="featured reveal">
    <div class="container">
      <div class="section-head">
        <h2>Featured Products</h2>
        <a href="/shop" class="view-all">View All Products</a>
      </div>
      <div class="visual-grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {featuredProducts && featuredProducts.length > 0 ? (
          featuredProducts.map((product) => <ProductCard product={product} />)
        ) : (
          <p class="empty-msg">Featured inventory is currently being refreshed.</p>
        )}
      </div>
    </div>
  </section>

  <section class="tiers reveal">
    <div class="container">
      <h2>Pricing Tiers</h2>
      <div class="tier-grid">
        <article class="tier-card">
          <h3>Student Essentials</h3>
          <p>Affordable laptops for assignments, browsing, and online classes.</p>
        </article>
        <article class="tier-card">
          <h3>Business Pro</h3>
          <p>Reliable laptops and printers optimized for office productivity and daily business tasks.</p>
        </article>
        <article class="tier-card">
          <h3>Mobile Essentials</h3>
          <p>Browse smartphones and practical tech picks for everyday communication and on-the-go work.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="faq reveal" id="faq">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <details>
        <summary>What is Grade A?</summary>
        <p>Grade A devices are the cleanest refurbished units with minimal cosmetic wear and excellent performance.</p>
      </details>
      <details>
        <summary>Is there a warranty?</summary>
        <p>Yes. Most units come with 6-12 months warranty depending on model and condition.</p>
      </details>
      <details>
        <summary>Do you deliver today?</summary>
        <p>Yes. Nairobi orders placed during business hours are eligible for same-day delivery, often within 2 hours.</p>
      </details>
    </div>
  </section>

  <section class="final-cta reveal">
    <div class="container final-cta-inner">
      <h2>Ready to Upgrade Your Workspace?</h2>
      <a class="pill-button cta-orange" href="/shop">Browse the Shop</a>
    </div>
  </section>
</Layout>

<style>
  section {
    padding: clamp(2.5rem, 6vw, 5rem) 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  h2 {
    font-size: clamp(1.6rem, 3.1vw, 2.3rem);
    margin-bottom: 1.25rem;
  }

  .hero {
    background: radial-gradient(circle at 10% 10%, rgba(29, 78, 216, 0.12), transparent 42%),
      radial-gradient(circle at 95% 0%, rgba(249, 115, 22, 0.15), transparent 35%),
      var(--background);
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .hero-shell {
    position: relative;
    display: grid;
    gap: 1.35rem;
    align-items: stretch;
    min-height: clamp(28rem, 56vw, 40rem);
    border-radius: 2rem;
    padding: clamp(1.1rem, 2.4vw, 1.5rem);
    background:
      radial-gradient(circle at top left, rgba(56, 189, 248, 0.18), transparent 28%),
      radial-gradient(circle at bottom right, rgba(249, 115, 22, 0.16), transparent 26%),
      linear-gradient(135deg, #081222 0%, #10213d 48%, #153158 100%);
    box-shadow: 0 28px 70px rgb(15 23 42 / 0.22);
    isolation: isolate;
    overflow: hidden;
  }

  .hero-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.08), transparent 28%),
      linear-gradient(90deg, rgba(15, 23, 42, 0.02) 0%, rgba(255, 255, 255, 0.04) 100%);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .hero-shell {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    }
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .hero-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    margin-bottom: 1rem;
    padding: 0.55rem 0.8rem;
    border-radius: 1.25rem;
    border: 1px solid rgb(125 211 252 / 0.18);
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(12px);
  }

  .hero-logo {
    width: 3.7rem;
    height: 3.7rem;
    object-fit: contain;
    padding: 0.35rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.98);
    box-shadow: 0 14px 24px rgb(15 23 42 / 0.2);
  }

  .hero-eyebrow {
    margin: 0 0 0.18rem;
    color: #93c5fd;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-brand-note {
    color: rgb(226 232 240 / 0.82);
    font-size: 0.9rem;
  }

  .hero-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.05rem;
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(96 165 250 / 0.22);
    background: rgb(29 78 216 / 0.16);
    color: #dbeafe;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .hero h1 {
    max-width: 11ch;
    font-size: clamp(2.35rem, 6vw, 4.65rem);
    line-height: 0.97;
    margin-bottom: 1rem;
    color: #f8fafc;
  }

  .hero-subtitle {
    color: rgb(226 232 240 / 0.84);
    font-size: 1.06rem;
    max-width: 52ch;
  }

  .hero-actions {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-secondary {
    color: #f8fafc;
    border: 1px solid rgb(148 163 184 / 0.34);
    background: rgb(255 255 255 / 0.08);
  }

  .hero-secondary:hover {
    background: rgb(255 255 255 / 0.14);
    transform: translateY(-2px);
  }

  .cta-orange {
    background-color: var(--accent);
    color: var(--white);
    font-weight: 700;
    box-shadow: 0 12px 30px rgba(249, 115, 22, 0.25);
  }

  .cta-orange:hover {
    background-color: var(--accent-hover);
    transform: translateY(-2px);
  }

  .hero-proof-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    margin-top: 1.55rem;
  }

  .hero-proof-card {
    padding: 0.95rem 1rem;
    border-radius: 1.1rem;
    border: 1px solid rgb(148 163 184 / 0.22);
    background: rgb(255 255 255 / 0.07);
    backdrop-filter: blur(14px);
  }

  .hero-proof-card strong {
    display: block;
    color: #f8fafc;
    font-size: 0.95rem;
  }

  .hero-proof-card span {
    display: block;
    margin-top: 0.28rem;
    color: rgb(203 213 225 / 0.84);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .hero-visual {
    position: relative;
    min-height: 21rem;
  }

  .hero-visual-frame {
    position: relative;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border-radius: 1.6rem;
    border: 1px solid rgb(148 163 184 / 0.18);
    background: #020817;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  .hero-banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-visual-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 15 31 / 0.18), rgb(8 15 31 / 0.22)),
      linear-gradient(135deg, rgb(8 15 31 / 0.08) 0%, rgb(8 15 31 / 0.42) 100%);
    pointer-events: none;
  }

  .hero-floating-card {
    position: absolute;
    z-index: 1;
    width: min(16rem, calc(100% - 2rem));
    padding: 0.95rem 1rem;
    border-radius: 1.1rem;
    border: 1px solid rgb(125 211 252 / 0.18);
    background: rgb(8 15 31 / 0.72);
    box-shadow: 0 18px 30px rgb(15 23 42 / 0.18);
    backdrop-filter: blur(14px);
  }

  .hero-floating-card.top {
    top: 1rem;
    right: 1rem;
  }

  .hero-floating-card.bottom {
    bottom: 1rem;
    left: 1rem;
  }

  .hero-floating-label {
    display: block;
    margin-bottom: 0.28rem;
    color: #7dd3fc;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-floating-card strong {
    color: #f8fafc;
    font-size: 0.94rem;
    line-height: 1.35;
  }

  .social-proof {
    background-color: #ffffff;
  }

  .home-search {
    padding-top: 1.1rem;
  }

  .home-search-card {
    display: grid;
    gap: 1rem;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: 1.4rem;
    background: rgb(255 255 255 / 0.96);
    box-shadow: 0 18px 40px rgb(15 23 42 / 0.07);
  }

  .home-search-eyebrow {
    margin: 0 0 0.45rem;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .home-search-copy {
    margin: 0.45rem 0 0;
    max-width: 56ch;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .testimonial-card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.1rem;
  }

  .quote {
    margin-bottom: 0.8rem;
    color: #0f172a;
  }

  .author {
    color: #1d4ed8;
    font-weight: 700;
  }

  .compare-grid,
  .benefit-grid,
  .tier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .compare-card,
  .benefit-card,
  .tier-card {
    border-radius: 1rem;
    border: 1px solid var(--border);
    padding: 1.2rem;
    background-color: var(--white);
  }

  .old-way {
    background: #fff7ed;
    border-color: #fdba74;
  }

  .ses-way {
    background: #eff6ff;
    border-color: #93c5fd;
  }

  ul,
  ol {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.15rem;
    color: var(--text-muted);
  }

  .how-it-works {
    background: linear-gradient(120deg, #eff6ff, #f8fafc);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .view-all {
    color: var(--primary);
    font-weight: 700;
  }

  .visual-grid {
    display: grid;
    gap: 1rem;
  }

  .grid-cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .md\:grid-cols-3 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .lg\:grid-cols-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .empty-msg {
    grid-column: 1 / -1;
    text-align: center;
    background: #ffffff;
    border: 1px dashed var(--border);
    border-radius: 1rem;
    padding: 2rem;
    color: var(--text-muted);
  }

  .faq {
    background: #ffffff;
  }

  details {
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0;
  }

  summary {
    font-weight: 700;
    cursor: pointer;
  }

  details p {
    color: var(--text-muted);
    margin-top: 0.6rem;
  }

  .final-cta {
    background: radial-gradient(circle at 0% 0%, rgba(249, 115, 22, 0.15), transparent 35%),
      radial-gradient(circle at 100% 100%, rgba(29, 78, 216, 0.15), transparent 35%),
      #ffffff;
  }

  .final-cta-inner {
    text-align: center;
    max-width: 700px;
  }

  .final-cta-inner .pill-button {
    margin-top: 1rem;
    font-size: 1.03rem;
    padding: 0.8rem 1.9rem;
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 500ms ease, transform 500ms ease;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .home-search-card {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 36rem);
      align-items: center;
    }

    .hero-proof-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .testimonial-grid,
    .benefit-grid,
    .tier-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .compare-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .md\:grid-cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .lg\:grid-cols-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .hero-copy {
      width: 100%;
      padding: 0.4rem;
    }

    .hero h1 {
      max-width: 14ch;
    }

    .hero-floating-card {
      width: calc(100% - 1.5rem);
    }

    .hero-floating-card.top {
      top: 0.75rem;
      right: 0.75rem;
    }

    .hero-floating-card.bottom {
      bottom: 0.75rem;
      left: 0.75rem;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
