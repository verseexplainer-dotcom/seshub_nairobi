---
import Layout from '../layouts/Layout.astro';
import { getSiteAssets } from '../lib/siteAssets';

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const cartFallbackImage = (import.meta.env.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder).trim();
---

<Layout title="Your Cart">
  <section class="cart-page">
    <div class="container">
      <div id="cart-config" data-fallback-image={cartFallbackImage} hidden></div>
      <h1 class="page-title">Shopping Cart</h1>
      
      <div id="cart-container" class="cart-grid">
        <div class="cart-items" id="cart-items-list">
          <!-- Cart items will be rendered here by JS -->
          <div class="loading">Loading your cart...</div>
        </div>

        <div class="cart-summary-wrapper">
          <div class="cart-summary">
            <h3>Order Summary</h3>
            <div class="summary-row">
              <span>Subtotal</span>
              <span id="cart-subtotal">KSh 0</span>
            </div>
            <div class="summary-row">
              <span>Delivery</span>
              <span class="free">Calculated at checkout</span>
            </div>
            <div class="summary-row total">
              <span>Total</span>
              <span id="cart-total">KSh 0</span>
            </div>

            <form id="checkout-form" class="checkout-form">
              <h3>Delivery Details</h3>
              <p class="form-hint">Enter your details for WhatsApp checkout</p>
              
              <div class="form-group">
                <label for="customer_name">Full Name</label>
                <input type="text" id="customer_name" name="customer_name" required placeholder="e.g. John Doe" />
              </div>
              
              <div class="form-group">
                <label for="phone">Phone Number (M-PESA)</label>
                <input type="tel" id="phone" name="phone" required placeholder="e.g. 0712345678" />
              </div>
              
              <div class="form-group">
                <label for="location">Delivery Location</label>
                <input type="text" id="location" name="location" required placeholder="e.g. Westlands, Nairobi" />
              </div>

              <label class="consent-checkbox">
                <input type="checkbox" name="consent" required />
                <span>I agree to be contacted via WhatsApp for this order.</span>
              </label>

              <button type="submit" class="pill-button primary checkout-btn" id="checkout-btn">
                Checkout via WhatsApp
              </button>
              
              <p class="form-disclaimer">No payment is required now. We will contact you to finalize the order.</p>
            </form>
          </div>
        </div>
      </div>

      <div id="empty-cart" class="empty-cart hidden">
        <div class="empty-icon">🛒</div>
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added anything yet. Browse the shop or jump straight into a category.</p>
        <div class="empty-actions">
          <a href="/shop" class="pill-button primary">Browse Shop</a>
          <a href="/category/laptops" class="pill-button">Shop Laptops</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cart-page {
    padding: var(--space-xl) 0;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: var(--space-xl);
  }

  .cart-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .cart-grid {
      grid-template-columns: 1fr 400px;
    }
  }

  .cart-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cart-item {
    display: flex;
    gap: var(--space-md);
    background-color: var(--white);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    position: relative;
  }

  .item-img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    background-color: #f1f5f9;
    border-radius: var(--radius-sm);
  }

  .item-details {
    flex: 1;
  }

  .item-title {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.25rem;
    display: block;
  }

  .item-price {
    font-weight: 600;
    color: var(--primary);
  }

  .item-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .qty-control {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .qty-btn {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8fafc;
    font-weight: 800;
  }

  .qty-btn:hover { background-color: #f1f5f9; }

  .qty-val {
    width: 40px;
    text-align: center;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .remove-btn {
    color: #ef4444;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  /* Summary */
  .cart-summary {
    background-color: var(--white);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 130px;
  }

  .cart-summary h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: var(--space-md);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .summary-row.total {
    border-top: 1px solid var(--border);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .free { color: #059669; font-weight: 600; }

  /* Form */
  .checkout-form {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 2px dashed var(--border);
  }

  .form-hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .form-group {
    margin-bottom: var(--space-sm);
  }

  .form-group label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .form-group input {
    width: 100%;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    font-family: inherit;
    font-size: 0.9375rem;
  }

  .consent-checkbox {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    margin: var(--space-md) 0;
    color: var(--text-muted);
    cursor: pointer;
  }

  .checkout-btn {
    width: 100%;
    justify-content: center;
    font-size: 1.125rem;
    padding: 1rem;
    background-color: #1a73e8; /* Specific blue */
  }

  .form-disclaimer {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: var(--space-sm);
    text-align: center;
  }

  .hidden { display: none !important; }

  .empty-cart {
    text-align: center;
    padding: var(--space-xl);
    background-color: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .empty-icon { font-size: 4rem; margin-bottom: 1rem; }

  .empty-actions {
    margin-top: var(--space-md);
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
</style>

<script>
  import { MAX_ITEM_QTY, loadCartFromStorage, saveCartToStorage, safeCartImageSrc, type CartItem } from '../lib/cartClient';

  const cartConfig = document.getElementById('cart-config');
  const fallbackImage = cartConfig?.getAttribute('data-fallback-image') || '/product-placeholder.svg';
  const finalFallbackImage = '/product-placeholder.svg';
  const loadCart = () => loadCartFromStorage();

  function attachFallback(img: HTMLImageElement) {
    img.addEventListener('error', () => {
      const currentSrc = img.getAttribute('src') || '';
      if (img.dataset.fallbackApplied === '1' || currentSrc === fallbackImage) {
        img.onerror = null;
        img.src = finalFallbackImage;
        return;
      }
      img.dataset.fallbackApplied = '1';
      img.src = fallbackImage;
    });
  }

  function createCartItemElement(item: CartItem, idx: number) {
    const itemEl = document.createElement('div');
    itemEl.className = 'cart-item';

    const imageEl = document.createElement('img');
    imageEl.className = 'item-img';
    imageEl.alt = item.title;
    imageEl.src = safeCartImageSrc(item.image, fallbackImage);
    attachFallback(imageEl);

    const detailsEl = document.createElement('div');
    detailsEl.className = 'item-details';

    const titleEl = document.createElement('a');
    titleEl.className = 'item-title';
    titleEl.textContent = item.title;
    titleEl.href = item.slug ? `/product/${encodeURIComponent(item.slug)}` : '#';

    const priceEl = document.createElement('p');
    priceEl.className = 'item-price';
    priceEl.textContent = `KSh ${item.price_kes.toLocaleString()}`;

    const actionsEl = document.createElement('div');
    actionsEl.className = 'item-actions';

    const qtyControlEl = document.createElement('div');
    qtyControlEl.className = 'qty-control';

    const minusBtn = document.createElement('button');
    minusBtn.className = 'qty-btn minus';
    minusBtn.type = 'button';
    minusBtn.textContent = '-';
    minusBtn.addEventListener('click', () => updateQty(idx, -1));

    const qtyValue = document.createElement('span');
    qtyValue.className = 'qty-val';
    qtyValue.textContent = String(item.qty);

    const plusBtn = document.createElement('button');
    plusBtn.className = 'qty-btn plus';
    plusBtn.type = 'button';
    plusBtn.textContent = '+';
    plusBtn.addEventListener('click', () => updateQty(idx, 1));

    qtyControlEl.append(minusBtn, qtyValue, plusBtn);

    const removeBtn = document.createElement('button');
    removeBtn.className = 'remove-btn';
    removeBtn.type = 'button';
    removeBtn.textContent = 'Remove';
    removeBtn.addEventListener('click', () => removeItem(idx));

    actionsEl.append(qtyControlEl, removeBtn);
    detailsEl.append(titleEl, priceEl, actionsEl);
    itemEl.append(imageEl, detailsEl);

    return itemEl;
  }

  function renderCart() {
    const cart = loadCart();
    const container = document.getElementById('cart-container');
    const emptyState = document.getElementById('empty-cart');
    const itemsList = document.getElementById('cart-items-list');
    const subtotalEl = document.getElementById('cart-subtotal');
    const totalEl = document.getElementById('cart-total');

    if (cart.length === 0) {
      container?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      return;
    }

    container?.classList.remove('hidden');
    emptyState?.classList.add('hidden');

    if (itemsList) {
      itemsList.replaceChildren(...cart.map((item, idx) => createCartItemElement(item, idx)));
    }

    const total = cart.reduce((acc, item) => acc + item.price_kes * item.qty, 0);
    if (subtotalEl) subtotalEl.textContent = `KSh ${total.toLocaleString()}`;
    if (totalEl) totalEl.textContent = `KSh ${total.toLocaleString()}`;
  }

  function updateQty(idx: number, delta: number) {
    const cart = loadCart();
    if (!cart[idx]) return;
    cart[idx].qty = Math.max(1, Math.min(MAX_ITEM_QTY, cart[idx].qty + delta));
    saveCartToStorage(cart);
    renderCart();
  }

  function removeItem(idx: number) {
    const cart = loadCart();
    if (!cart[idx]) return;
    cart.splice(idx, 1);
    saveCartToStorage(cart);
    renderCart();
  }

  // Checkout Logic
  const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement;
  const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;

  checkoutForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const cart = loadCart();
    const formData = new FormData(checkoutForm);
    
    const payload = {
      cart: cart.map((item) => ({
        id: item.id,
        qty: item.qty,
        slug: item.slug
      })),
      total_kes: cart.reduce((acc, item) => acc + (item.price_kes * item.qty), 0),
      customer_name: formData.get('customer_name'),
      phone: formData.get('phone'),
      location: formData.get('location'),
      consent: formData.get('consent') === 'on',
      source_page: 'cart'
    };

    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Processing...';

    try {
      const response = await fetch('/api/checkout/whatsapp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await response.json();
      
      if (data.ok) {
        // Track the event
        await fetch('/api/events', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            session_id: localStorage.getItem('ses_session_id'),
            event_type: 'whatsapp_checkout_redirect',
            payload: { order_id: data.order_id }
          })
        });

        // Redirect to WhatsApp
        window.location.href = data.whatsapp_url;
        
        // Optionally clear cart after a delay or based on user confirmation
        // For now, let's keep it until they return or we can clear on successful return to a "thank you" page
      } else {
        throw new Error(data?.error?.message || 'Checkout failed');
      }
    } catch (err) {
      const message = err instanceof Error && err.message ? err.message : 'Checkout error. Please try again or contact us directly on WhatsApp.';
      alert(message);
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = 'Checkout via WhatsApp';
    }
  });

  // Initial render
  renderCart();
</script>
