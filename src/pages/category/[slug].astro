---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import SearchBar from '../../components/SearchBar.astro';
import { supabase } from '../../lib/supabase';
import { getSiteAssets } from '../../lib/siteAssets';

export const prerender = true;

export async function getStaticPaths() {
  const categories = ['laptops', 'desktops', 'printers', 'smartphones', 'accessories', 'deals', 'all'];
  return categories.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

// Map route slugs to acceptable DB category values (case/data tolerant)
const slugToCategory: Record<string, string[]> = {
  laptops: ['laptops', 'Laptops'],
  desktops: ['desktops', 'Desktops'],
  printers: ['printers', 'Printers'],
  smartphones: ['smartphones', 'Smartphones'],
  accessories: ['accessories', 'Accessories']
};

let query = supabase.from('products').select('*');

if (slug === 'deals') {
  query = query.not('compare_at_kes', 'is', null);
} else if (slug !== 'all') {
  const dbCategories = slugToCategory[slug as string] || [slug as string];
  query = query.in('category', dbCategories);
}

const { data: products } = await query;

const categoryNames: Record<string, string> = {
  laptops: 'Laptops',
  desktops: 'Desktops',
  printers: 'Printers',
  smartphones: 'Smartphones',
  accessories: 'Accessories',
  deals: 'Special Deals',
  all: 'All Products'
};

const title = categoryNames[slug as string] || 'Products';
const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const categoryHeroImages: Record<string, string> = {
  laptops: siteAssets.categoryCards.laptops,
  desktops: siteAssets.categoryCards.desktops,
  printers: siteAssets.categoryCards.printers,
  smartphones: siteAssets.categoryCards.smartphones,
  accessories: siteAssets.categoryCards.accessories
};
const categoryHeroImage = categoryHeroImages[slug as string] || siteAssets.hero;
const printersHeroOnError = `this.onerror=null;this.src=${JSON.stringify(siteAssets.categoryCards.printersLegacy)}`;
const categoryHeroOnError = slug === 'printers' ? printersHeroOnError : undefined;
---

<Layout title={title}>
  <div class="category-hero">
    <img src={categoryHeroImage} alt={`${title} category banner`} class="category-hero-bg" loading="eager" onerror={categoryHeroOnError} />
    <div class="category-hero-overlay"></div>
    <div class="container text-center category-hero-content">
      <h1 class="category-title">{title}</h1>
      <p class="category-subtitle">Showing {products?.length || 0} items in Kenya</p>
    </div>
  </div>

  <SearchBar />

  <section class="products-section">
    <div class="container">
      <div class="product-grid">
        {products && products.length > 0 ? (
          products.map(product => <ProductCard product={product} />)
        ) : (
          <div class="empty-state">
            <h3>No products found in this category.</h3>
            <p>Try searching for something else or check back soon!</p>
            <a href="/" class="pill-button primary">Back to Home</a>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .category-hero {
    position: relative;
    color: var(--white);
    padding: var(--space-xl) 0 clamp(3rem, 8vw, 5rem);
    margin-bottom: 0;
    overflow: hidden;
  }

  .category-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: -2;
  }

  .category-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, rgb(15 23 42 / 0.84) 0%, rgb(30 64 175 / 0.74) 45%, rgb(15 23 42 / 0.28) 100%);
    z-index: -1;
  }

  .category-hero-content {
    position: relative;
  }

  .category-title {
    font-size: 2.5rem;
    font-weight: 800;
  }

  .category-subtitle {
    font-size: 1.125rem;
    opacity: 0.9;
  }

  .text-center {
    text-align: center;
  }

  .products-section {
    padding: var(--space-xl) 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-xl);
    background-color: var(--white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .empty-state h3 {
    margin-bottom: 1rem;
  }

  .empty-state p {
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
  }
</style>
