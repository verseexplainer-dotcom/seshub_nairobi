---
import CatalogListing from '../../components/CatalogListing.astro';
import Layout from '../../layouts/Layout.astro';
import { getStoreCategoryBySlug } from '../../lib/productPresentation';

export const prerender = false;

const { slug = '' } = Astro.params;
const category = slug === 'all' ? null : getStoreCategoryBySlug(slug);

if (slug !== 'all' && !category) {
  return Astro.redirect('/404');
}

const canonical = slug === 'all'
  ? Astro.url.searchParams.toString() ? '/category/all' : '/shop'
  : `/category/${slug}`;

const title = slug === 'all' ? 'Shop Electronics' : category?.label || 'Shop';
const description = slug === 'all'
  ? 'Legacy all-products catalog view for SES ICT HUB. Browse the main shop page for the primary discovery experience.'
  : `${category?.label} at SES ICT HUB with live pricing, spec filters, and stock-aware product cards.`;
---

<Layout title={title} description={description} canonical={canonical}>
  <CatalogListing mode={slug === 'all' ? 'shop' : 'category'} categorySlug={slug === 'all' ? 'all' : category!.slug} />
</Layout>
