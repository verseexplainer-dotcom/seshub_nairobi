---
import Layout from '../layouts/Layout.astro';
import CatalogListing from '../components/CatalogListing.astro';
import { getHomepageProducts } from '../lib/catalog';
import { getRuntimeEnv } from '../lib/runtime';

const runtimeEnv = getRuntimeEnv(Astro.locals);
const query = Astro.url.searchParams.get('q')?.toLowerCase().trim() || '';
const category = Astro.url.searchParams.get('category')?.toLowerCase().trim() || '';
const condition = Astro.url.searchParams.get('condition')?.toLowerCase().trim() || '';
const priceRange = Astro.url.searchParams.get('price')?.trim() || '';

let products = await getHomepageProducts(Astro.locals);

// Filter by search query
if (query) {
  products = products.filter(product => {
    const searchFields = [
      product.title?.toLowerCase() || '',
      product.description?.toLowerCase() || '',
      product.brand?.toLowerCase() || '',
      product.short_specs?.toLowerCase() || ''
    ].join(' ');
    
    return query.split(' ').some(term => searchFields.includes(term));
  });
}

// Filter by category
if (category) {
  products = products.filter(product => {
    return product.category?.toLowerCase() === category;
  });
}

// Filter by condition
if (condition) {
  const conditionMap: Record<string, string> = {
    'brand_new': 'Brand New',
    'refurbished': 'Refurbished'
  };
  const conditionFilter = conditionMap[condition];
  
  products = products.filter(product => {
    const productCondition = product.condition?.toLowerCase() === 'new' ? 'Brand New' : 
                             product.refurb_grade ? 'Refurbished' : '';
    return productCondition === conditionFilter;
  });
}

// Filter by price range
if (priceRange) {
  const [minStr, maxStr] = priceRange.split('-');
  const min = parseInt(minStr, 10);
  const max = parseInt(maxStr, 10);
  
  products = products.filter(product => {
    const price = product.price_kes || 0;
    return price >= min && price <= max;
  });
}

// Sort by featured then price
products = products.sort((a, b) => {
  if (a.featured_home && !b.featured_home) return -1;
  if (!a.featured_home && b.featured_home) return 1;
  return (a.price_kes || 0) - (b.price_kes || 0);
});

const hasFilters = query || category || condition || priceRange;
const pageTitle = hasFilters 
  ? `Search Results${query ? ` for "${query}"` : ''}${category ? ` in ${category}` : ''}`
  : 'Search Products';
---

<Layout
  title={pageTitle}
  description="Search through our catalog of laptops, smartphones, printers, desktops, and accessories in Kenya."
  canonical="/search"
>
  <div class="search-results-page">
    <div class="container">
      <div class="search-header">
        <h1>{pageTitle}</h1>
        {hasFilters && (
          <p class="search-meta">
            Found {products.length} {products.length === 1 ? 'product' : 'products'}
          </p>
        )}
      </div>

      {products.length > 0 ? (
        <CatalogListing
          products={products}
          publicSupabaseUrl={runtimeEnv.PUBLIC_SUPABASE_URL}
        />
      ) : (
        <div class="no-results">
          <p>No products found matching your search.</p>
          {hasFilters && (
            <p>Try adjusting your filters or search terms.</p>
          )}
          <a href="/" class="btn-link">← Back to home</a>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .search-results-page {
    padding: 3rem 0;
  }

  .search-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .search-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .search-meta {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 2rem;
    background: rgba(248, 250, 252, 0.8);
    border-radius: var(--radius-lg);
  }

  .no-results p {
    margin: 0.5rem 0;
    color: var(--color-text-muted);
  }

  .btn-link {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    transition: background var(--transition-fast);
  }

  .btn-link:hover {
    background: var(--color-primary-dark);
  }
</style>
