---
import CatalogListing from '../components/CatalogListing.astro';
import { setPublicCacheHeaders } from '../lib/http-cache';
import Layout from '../layouts/Layout.astro';

setPublicCacheHeaders(Astro.response.headers, Astro.request);
---

<Layout
  title="Shop Electronics"
  description="Browse laptops, desktops, smartphones, printers, and accessories at SES ICT HUB with current prices, stock updates, and help on WhatsApp."
  canonical="/shop"
>
  <CatalogListing mode="shop" categorySlug="all" />
</Layout>
