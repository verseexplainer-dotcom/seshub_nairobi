---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;

const categoryLinks = [
  { href: '/category/laptops', label: 'Laptops' },
  { href: '/category/smartphones', label: 'Smartphones' },
  { href: '/category/printers', label: 'Printers' },
  { href: '/category/accessories', label: 'Accessories' }
];
---

<Layout
  title="Page Not Found"
  description="The page you requested could not be found. Browse SES ICT HUB electronics, search available products, or contact support for help."
  canonical="/404"
>
  <section class="not-found-page" aria-labelledby="not-found-title">
    <div class="not-found-page__inner container">
      <div class="not-found-page__content">
        <p class="not-found-page__eyebrow">404</p>
        <h1 id="not-found-title">Page not found</h1>
        <p class="not-found-page__copy">
          The link may have moved, expired, or been typed incorrectly. You can search available products,
          continue shopping, or contact SES ICT HUB for help.
        </p>

        <form class="not-found-page__search" action="/search" method="get">
          <label class="sr-only" for="not-found-search">Search products</label>
          <input
            id="not-found-search"
            name="q"
            type="search"
            placeholder="Search laptops, printers, phones..."
            autocomplete="off"
          />
          <button type="submit">Search</button>
        </form>

        <div class="not-found-page__actions" aria-label="Next steps">
          <a class="pill-button primary" href="/shop">Shop products</a>
          <a class="pill-button ghost" href="/">Go home</a>
          <a class="pill-button ghost" href="/contact">Contact us</a>
        </div>
      </div>

      <aside class="not-found-page__panel" aria-labelledby="popular-categories-title">
        <span class="not-found-page__panel-kicker">Popular categories</span>
        <h2 id="popular-categories-title">Find what you need faster</h2>
        <nav class="not-found-page__categories" aria-label="Popular categories">
          {categoryLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .not-found-page {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background:
      linear-gradient(180deg, rgba(248, 251, 255, 0.94), rgba(255, 255, 255, 0.98)),
      linear-gradient(135deg, rgba(21, 93, 252, 0.1), rgba(22, 101, 52, 0.06));
  }

  .not-found-page__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: stretch;
  }

  .not-found-page__content,
  .not-found-page__panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: var(--shadow-sm);
  }

  .not-found-page__content {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .not-found-page__eyebrow,
  .not-found-page__panel-kicker {
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .not-found-page h1 {
    max-width: 11ch;
    font-size: clamp(2.2rem, 9vw, 4.8rem);
    letter-spacing: 0;
  }

  .not-found-page__copy {
    max-width: 62ch;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.08rem);
  }

  .not-found-page__search {
    display: grid;
    gap: 0.7rem;
    width: min(100%, 42rem);
  }

  .not-found-page__search input,
  .not-found-page__search button {
    min-height: 3rem;
    border-radius: var(--radius-full);
  }

  .not-found-page__search input {
    width: 100%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    padding: 0.85rem 1rem;
  }

  .not-found-page__search input:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .not-found-page__search button {
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 800;
    padding-inline: 1.25rem;
  }

  .not-found-page__search button:hover {
    background: var(--color-primary-hover);
  }

  .not-found-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .not-found-page__panel {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.5rem);
  }

  .not-found-page__panel h2 {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    letter-spacing: 0;
  }

  .not-found-page__categories {
    display: grid;
    gap: 0.7rem;
  }

  .not-found-page__categories a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 800;
    padding: 0.8rem 0.95rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .not-found-page__categories a::after {
    content: ">";
    color: var(--color-primary);
  }

  .not-found-page__categories a:hover {
    border-color: rgba(21, 93, 252, 0.24);
    background: #ffffff;
    color: var(--color-primary);
    transform: translateY(-1px);
  }

  @media (min-width: 700px) {
    .not-found-page__search {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .not-found-page__search button {
      min-width: 8rem;
    }
  }

  @media (min-width: 900px) {
    .not-found-page__inner {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.38fr);
    }
  }
</style>
