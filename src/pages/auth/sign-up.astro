---
import AlertBanner from '../../components/AlertBanner.astro';
import Layout from '../../layouts/Layout.astro';
import { getSafeRedirectPath } from '../../lib/auth-utils';

const error = Astro.url.searchParams.get('error');
const message = Astro.url.searchParams.get('message');
const next = getSafeRedirectPath(Astro.url.searchParams.get('next'), '/account');
---

<Layout title="Create Account">
  <section class="auth-section">
    <div class="container auth-grid">
      <div class="auth-copy">
        <span class="portal-badge">Secure Signup</span>
        <h1>Create a customer account without changing the guest checkout flow.</h1>
        <p>
          Customer accounts are optional. Staff accounts are not public self-signup and
          must be promoted by an admin after invite or manual creation.
        </p>
      </div>

      <div class="app-card auth-card">
        <div class="stack sm">
          <AlertBanner tone="danger" message={error} />
          <AlertBanner tone="success" message={message} />
        </div>

        <form method="POST" action="/api/auth/sign-up" class="app-form">
          <input type="hidden" name="next" value={next} />

          <div class="app-form-grid cols-2">
            <div class="form-field">
              <label for="full_name">Full name</label>
              <input id="full_name" name="full_name" type="text" autocomplete="name" required />
            </div>

            <div class="form-field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <div class="form-field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="form-field">
            <label for="default_location">Default delivery location</label>
            <input id="default_location" name="default_location" type="text" autocomplete="address-level2" />
          </div>

          <div class="form-field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              minlength="8"
              autocomplete="new-password"
              required
            />
            <small>Use at least 8 characters.</small>
          </div>

          <button type="submit" class="pill-button primary">Create Account</button>
        </form>

        <div class="auth-links">
          <a class="text-link" href={`/auth/login?next=${encodeURIComponent(next)}`}>Already have an account?</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .auth-section {
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }

  .auth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 980px) {
    .auth-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .auth-copy {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .auth-copy h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .auth-copy p {
    color: var(--text-muted);
    max-width: 56ch;
  }

  .auth-card {
    display: grid;
    gap: 1rem;
  }

  .auth-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
</style>
