---
import AlertBanner from '../../components/AlertBanner.astro';
import Layout from '../../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error');
const message = Astro.url.searchParams.get('message');
const user = Astro.locals.user;
---

<Layout title="Reset Password">
  <section class="auth-section">
    <div class="container auth-grid single">
      <div class="app-card auth-card">
        <div class="auth-card-header">
          <span class="auth-card-kicker">{user ? 'Update Password' : 'Password Recovery'}</span>
          <div>
            <h1>{user ? 'Choose a new password.' : 'Request a password reset email.'}</h1>
            <p class="muted">
              {user
                ? 'This session came from your password recovery link. Set a new password to finish the reset.'
                : 'We will send a secure recovery link to your email address.'}
            </p>
          </div>
        </div>

        <div class="stack sm">
          <AlertBanner tone="danger" message={error} />
          <AlertBanner tone="success" message={message} />
        </div>

        {user ? (
          <form method="POST" action="/api/auth/update-password" class="app-form">
            <div class="form-field">
              <label for="new_password">New password</label>
              <input
                id="new_password"
                name="new_password"
                type="password"
                minlength="8"
                autocomplete="new-password"
                required
              />
            </div>

            <div class="form-field">
              <label for="confirm_password">Confirm new password</label>
              <input
                id="confirm_password"
                name="confirm_password"
                type="password"
                minlength="8"
                autocomplete="new-password"
                required
              />
            </div>

            <button type="submit" class="pill-button primary">Update Password</button>
          </form>
        ) : (
          <form method="POST" action="/api/auth/reset-password" class="app-form">
            <div class="form-field">
              <label for="email">Email address</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>

            <button type="submit" class="pill-button primary">Send Recovery Link</button>
          </form>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .auth-section {
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }

  .auth-grid.single {
    max-width: 680px;
    margin: 0 auto;
  }

  .auth-card {
    display: grid;
    gap: 1rem;
  }
</style>
