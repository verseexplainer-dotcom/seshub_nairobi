---
import AlertBanner from '../../components/AlertBanner.astro';
import AuthShell from '../../components/AuthShell.astro';
import Layout from '../../layouts/Layout.astro';
import { getSafeRedirectPath } from '../../lib/auth-utils';

const error = Astro.url.searchParams.get('error');
const message = Astro.url.searchParams.get('message');
const next = getSafeRedirectPath(Astro.url.searchParams.get('next'), '/account');

const features = [
  {
    title: 'See your saved orders',
    description: 'Check past orders and recent updates in one place.'
  },
  {
    title: 'Keep your details ready',
    description: 'Your name, phone number, and delivery area stay ready for next time.'
  },
  {
    title: 'Need help signing in?',
    description: 'Reach out on WhatsApp if you need help and one of our team will assist you.'
  }
];
---

<Layout title="Sign In">
  <AuthShell
    badge="Welcome back"
    spotlight="Need help? Message us"
    title="Sign in and pick up where you left off."
    intro="See your saved orders, keep your details ready, and message us on WhatsApp if you need help."
    features={features}
    noteEyebrow="Need Help?"
    noteTitle="You can still order as a guest."
    noteCopy="If you'd rather not sign in, that's okay. Message us on WhatsApp and we'll help you."
  >
    <div class="app-card auth-card">
      <div class="auth-card-header">
        <span class="auth-card-kicker">Welcome back</span>
        <div>
          <h2>Sign in to your account</h2>
          <p>Use the email address you signed up with.</p>
        </div>
      </div>

      <div class="stack sm">
        <AlertBanner tone="danger" message={error} />
        <AlertBanner tone="success" message={message} />
      </div>

      <form method="POST" action="/api/auth/login" class="app-form">
        <input type="hidden" name="next" value={next} />

        <div class="form-field">
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            required
          />
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="Enter your password"
            required
          />
        </div>

        <button type="submit" class="pill-button primary auth-submit">Sign In</button>
      </form>

      <div class="auth-card-footer">
        <div class="auth-inline-note">
          <strong>Need an account first?</strong>
          <span>Create one to save your details for next time.</span>
        </div>

        <div class="auth-links">
          <a class="text-link" href={`/auth/sign-up?next=${encodeURIComponent(next)}`}>Create an account</a>
          <a class="text-link" href="/auth/reset-password">Forgot password?</a>
        </div>
      </div>
    </div>
  </AuthShell>
</Layout>
