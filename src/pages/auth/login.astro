---
import AlertBanner from '../../components/AlertBanner.astro';
import Layout from '../../layouts/Layout.astro';
import { getSafeRedirectPath } from '../../lib/auth-utils';

const error = Astro.url.searchParams.get('error');
const message = Astro.url.searchParams.get('message');
const next = getSafeRedirectPath(Astro.url.searchParams.get('next'), '/account');
---

<Layout title="Sign In">
  <section class="auth-section">
    <div class="container auth-grid">
      <div class="auth-copy">
        <span class="portal-badge">Customer Access</span>
        <h1>Sign in to track orders and manage your profile.</h1>
        <p>
          Logged-in checkout links orders to your account. Staff members also use the
          same sign-in flow to access `/admin`.
        </p>
      </div>

      <div class="app-card auth-card">
        <div class="stack sm">
          <AlertBanner tone="danger" message={error} />
          <AlertBanner tone="success" message={message} />
        </div>

        <form method="POST" action="/api/auth/login" class="app-form">
          <input type="hidden" name="next" value={next} />

          <div class="form-field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="form-field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit" class="pill-button primary">Sign In</button>
        </form>

        <div class="auth-links">
          <a class="text-link" href={`/auth/sign-up?next=${encodeURIComponent(next)}`}>Create an account</a>
          <a class="text-link" href="/auth/reset-password">Forgot password?</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .auth-section {
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }

  .auth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 980px) {
    .auth-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .auth-copy {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .auth-copy h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .auth-copy p {
    color: var(--text-muted);
    max-width: 56ch;
  }

  .auth-card {
    display: grid;
    gap: 1rem;
  }

  .auth-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
</style>
