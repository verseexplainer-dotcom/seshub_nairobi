---
import AlertBanner from '../../components/AlertBanner.astro';
import PortalShell from '../../components/PortalShell.astro';
import StatusPill from '../../components/StatusPill.astro';
import type { SessionLocals } from '../../lib/app-types';
import { accountNavItems } from '../../lib/navigation';
import { ACTIVE_FULFILLMENT_STATUSES, formatDateTime, formatKes, getFulfillmentStatusTone, getPaymentStatusTone, titleCaseStatus } from '../../lib/order-utils';
import { createServerSupabaseClient } from '../../lib/supabase-server';

const locals = Astro.locals as SessionLocals;
const supabase = createServerSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals
});
const profile = locals.profile;
const user = locals.user;
const message = Astro.url.searchParams.get('message');
const error = Astro.url.searchParams.get('error');

const { data } = await supabase
  .from('orders')
  .select('id, order_number, total_kes, payment_status, fulfillment_status, created_at')
  .order('created_at', { ascending: false })
  .limit(8);
const orders = data ?? [];

const activeOrders = orders.filter((order) =>
  ACTIVE_FULFILLMENT_STATUSES.includes(order.fulfillment_status)
).length;
const latestOrder = orders[0] ?? null;
---

<PortalShell
  title="Your Account"
  intro="Keep delivery details current and track orders that were placed while you were signed in."
  navItems={accountNavItems}
  currentPath={Astro.url.pathname}
  badge="Account"
>
  <div class="stack">
    <AlertBanner tone="danger" message={error} />
    <AlertBanner tone="success" message={message} />

    <section class="metrics-grid">
      <article class="app-card metric-card">
        <span>Linked Orders</span>
        <strong>{orders.length}</strong>
        <p>Orders placed while you were signed in.</p>
      </article>

      <article class="app-card metric-card">
        <span>Active Orders</span>
        <strong>{activeOrders}</strong>
        <p>Orders still in progress or awaiting delivery.</p>
      </article>

      <article class="app-card metric-card">
        <span>Profile Status</span>
        <strong>{profile?.is_active ? 'Active' : 'Pending'}</strong>
        <p>{user?.email || 'No email address available.'}</p>
      </article>
    </section>

    <section class="app-grid cols-2">
      <article class="app-card">
        <div class="section-heading">
          <div>
            <h2>Latest Order</h2>
            <p>Your newest linked order appears here immediately after checkout.</p>
          </div>
          <a class="text-link" href="/account/orders">View all orders</a>
        </div>

        {latestOrder ? (
          <div class="stack sm">
            <div class="detail-list">
              <div class="detail-row">
                <span>Order number</span>
                <strong>{latestOrder.order_number}</strong>
              </div>
              <div class="detail-row">
                <span>Placed</span>
                <strong>{formatDateTime(latestOrder.created_at)}</strong>
              </div>
              <div class="detail-row">
                <span>Total</span>
                <strong>{formatKes(latestOrder.total_kes)}</strong>
              </div>
            </div>

            <div class="app-actions">
              <StatusPill
                label={titleCaseStatus(latestOrder.payment_status)}
                tone={getPaymentStatusTone(latestOrder.payment_status)}
              />
              <StatusPill
                label={titleCaseStatus(latestOrder.fulfillment_status)}
                tone={getFulfillmentStatusTone(latestOrder.fulfillment_status)}
              />
            </div>

            <a class="pill-button primary" href={`/account/orders/${latestOrder.order_number}`}>
              View Order Details
            </a>
          </div>
        ) : (
          <div class="stack sm">
            <p>
              No linked orders yet. Guest checkout still works, but only signed-in orders
              appear in this dashboard.
            </p>
            <a class="pill-button primary" href="/cart">Go to cart</a>
          </div>
        )}
      </article>

      <article class="app-card">
        <div class="section-heading">
          <div>
            <h2>Saved Profile</h2>
            <p>Used to prefill checkout and support faster follow-up.</p>
          </div>
          <a class="text-link" href="/account/profile">Edit profile</a>
        </div>

        <div class="detail-list">
          <div class="detail-row">
            <span>Full name</span>
            <strong>{profile?.full_name || 'Add your name'}</strong>
          </div>
          <div class="detail-row">
            <span>Phone</span>
            <strong>{profile?.phone || 'Add your phone number'}</strong>
          </div>
          <div class="detail-row">
            <span>Default location</span>
            <strong>{profile?.default_location || 'Add a delivery location'}</strong>
          </div>
          <div class="detail-row">
            <span>Email</span>
            <strong>{user?.email || 'Unknown'}</strong>
          </div>
        </div>
      </article>
    </section>
  </div>
</PortalShell>
