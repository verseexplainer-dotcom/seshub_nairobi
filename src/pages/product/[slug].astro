---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import SearchBar from '../../components/SearchBar.astro';
import StickyATC from '../../components/StickyATC.astro';
import { hasCatalogImage, normalizeCatalogProduct } from '../../lib/catalog';
import { setPublicCacheHeaders } from '../../lib/http-cache';
import { isSupabaseConfigured, supabase } from '../../lib/supabase';
import { getSiteAssets } from '../../lib/siteAssets';
import { sanitizeProductDescription } from '../../lib/sanitize';
import { getProductPresentation, getWarrantyLabel, normalizeText } from '../../lib/productPresentation';
import { buildWhatsAppLink } from '../../lib/storefront';

export const prerender = false;
const { slug } = Astro.params;
setPublicCacheHeaders(Astro.response.headers, Astro.request);
const PRODUCT_PAGE_SELECT = [
  'id',
  'slug',
  'title',
  'category',
  'brand',
  'price_kes',
  'compare_at_kes',
  'in_stock',
  'stock_qty',
  'condition',
  'refurb_grade',
  'short_specs',
  'description',
  'warranty_months',
  'images',
  'featured_home',
  'featured_rank',
  'sku',
  'cpu',
  'ram_gb',
  'storage_gb',
  'storage_type',
  'screen_in',
  'seo_title',
  'meta_description'
].join(', ');
const RELATED_PRODUCT_SELECT = [
  'id',
  'slug',
  'title',
  'category',
  'brand',
  'price_kes',
  'compare_at_kes',
  'in_stock',
  'stock_qty',
  'condition',
  'refurb_grade',
  'short_specs',
  'warranty_months',
  'images',
  'cpu',
  'ram_gb',
  'storage_gb',
  'storage_type',
  'screen_in'
].join(', ');

let product: Record<string, any> | null = null;
let related: Array<Record<string, any>> = [];
const canShowProduct = (item: Record<string, any> | null | undefined) => Boolean(item) && hasCatalogImage(normalizeCatalogProduct(item || {}));

if (isSupabaseConfigured) {
  const { data: productData } = await supabase.from('products').select(PRODUCT_PAGE_SELECT).eq('slug', slug).single();
  product = canShowProduct(productData || null) ? (productData || null) : null;

  if (product) {
    const relatedIds = new Set<string | number>([product.id]);

    if (normalizeText(product.brand)) {
      const { data: sameBrandData } = await supabase
        .from('products')
        .select(RELATED_PRODUCT_SELECT)
        .eq('category', product.category)
        .eq('brand', product.brand)
        .neq('id', product.id)
        .limit(4);
      const sameBrand = (sameBrandData || []) as Array<Record<string, any>>;

      for (const item of sameBrand) {
        if (canShowProduct(item) && !relatedIds.has(item.id)) {
          related.push(item);
          relatedIds.add(item.id);
        }
      }
    }

    if (related.length < 4) {
      const { data: sameCategoryData } = await supabase
        .from('products')
        .select(RELATED_PRODUCT_SELECT)
        .eq('category', product.category)
        .neq('id', product.id)
        .limit(8);
      const sameCategory = (sameCategoryData || []) as Array<Record<string, any>>;

      for (const item of sameCategory) {
        if (related.length >= 4) {
          break;
        }

        if (canShowProduct(item) && !relatedIds.has(item.id)) {
          related.push(item);
          relatedIds.add(item.id);
        }
      }
    }

    if (related.length < 4) {
      const { data: featuredFallbackData } = await supabase
        .from('products')
        .select(RELATED_PRODUCT_SELECT)
        .eq('featured_home', true)
        .neq('id', product.id)
        .limit(8);
      const featuredFallback = (featuredFallbackData || []) as Array<Record<string, any>>;

      for (const item of featuredFallback) {
        if (related.length >= 4) {
          break;
        }

        if (canShowProduct(item) && !relatedIds.has(item.id)) {
          related.push(item);
          relatedIds.add(item.id);
        }
      }
    }
  }
}

if (!product) {
  return Astro.redirect('/404');
}

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);
const localPlaceholder = '/product-placeholder.svg';
const fallbackImage = (import.meta.env.PUBLIC_FALLBACK_IMAGE_URL || siteAssets.productPlaceholder.src || localPlaceholder).trim();
const imageOnError = `if(this.dataset.fallbackApplied==='1'){this.onerror=null;this.src=${JSON.stringify(localPlaceholder)};}else{this.dataset.fallbackApplied='1';this.src=${JSON.stringify(fallbackImage)};}`;
const presentation = getProductPresentation(product, {
  publicSupabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL,
  fallbackImage
});
const productWhatsappHref = buildWhatsAppLink(
  `Hi SES ICT HUB, I'm interested in: ${presentation.rawTitle} — https://sesicthub.co.ke/product/${product.slug}`
);
const safeDescriptionHtml = sanitizeProductDescription(product.description || '');
const productSeoTitle = normalizeText(product.seo_title) || normalizeText(product.title) || 'Product';
const plainMetaDescription = String(product.meta_description || product.short_specs || product.description || '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 300);
const siteBase = String(Astro.site || 'https://sesicthub.co.ke').replace(/\/$/, '');
const canonicalPath = `/product/${product.slug}`;
const productUrl = `${siteBase}${canonicalPath}`;
const warrantyLongLabel = getWarrantyLabel(product.warranty_months, 'long');
const reassuranceCards = [
  {
    title: 'Delivery and pickup',
    body: '2-hour Nairobi delivery where available, plus in-store pickup from Moi Avenue.',
    icon: siteAssets.trustIcons.delivery.src
  },
  {
    title: 'Payment options',
    body: 'M-PESA and pay-on-delivery options are available for many local orders.',
    icon: siteAssets.trustIcons.payments.src
  },
  {
    title: 'See it before you buy',
    body: 'Message us on WhatsApp if you want to see it before you buy, or visit the shop.',
    icon: siteAssets.trustIcons.security.src
  }
];
const trustChips = [
  warrantyLongLabel ? { label: warrantyLongLabel } : null,
  presentation.condition.label ? { label: presentation.condition.label } : null,
  presentation.grade ? { label: presentation.grade.label } : null,
  presentation.chargerIncluded ? { label: 'Charger included' } : null,
  { label: 'Store pickup available' }
].filter(Boolean) as Array<{ label: string }>;
const buyingHighlights = [
  warrantyLongLabel ? { title: warrantyLongLabel, body: 'We will confirm the warranty with you before you buy.' } : null,
  { title: '7-day defect return window', body: 'Applies to undisclosed functional defects, as outlined in the FAQ.' },
  { title: 'Nairobi CBD delivery from KSh 200', body: 'We will confirm delivery cost with you before you buy.' }
].filter(Boolean) as Array<{ title: string; body: string }>;
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: `${siteBase}/shop` },
    {
      '@type': 'ListItem',
      position: 3,
      name: presentation.categoryLabel,
      item: `${siteBase}${presentation.categoryPath}`
    },
    { '@type': 'ListItem', position: 4, name: presentation.displayTitle, item: productUrl }
  ]
};
const structuredItemCondition =
  product.condition === 'brand_new'
    ? 'https://schema.org/NewCondition'
    : product.condition === 'refurbished'
      ? 'https://schema.org/RefurbishedCondition'
      : undefined;
const productStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: plainMetaDescription,
  image: presentation.imageUrls,
  sku: product.sku || undefined,
  brand: product.brand ? { '@type': 'Brand', name: product.brand } : undefined,
  itemCondition: structuredItemCondition,
  offers: {
    '@type': 'Offer',
    url: productUrl,
    priceCurrency: 'KES',
    price: presentation.pricing.price,
    availability: presentation.stock.isInStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock'
  }
};
---

<Layout
  title={productSeoTitle}
  description={plainMetaDescription}
  image={presentation.primaryImageUrl}
  canonical={canonicalPath}
>
  <div class="product-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/shop">Shop</a>
        <span>/</span>
        <a href={presentation.categoryPath}>{presentation.categoryLabel}</a>
        <span>/</span>
        <span aria-current="page">{presentation.displayTitle}</span>
      </nav>

      <section class="product-search-card" aria-label="Search the catalog">
        <div>
          <p class="eyebrow">Need another option?</p>
          <h2>Search the shop without leaving this page.</h2>
          <p class="product-search-copy">Search for another product or brand, or message us on WhatsApp if you want help comparing.</p>
        </div>
        <SearchBar variant="inline" placeholder="Search products or brands..." />
      </section>

      <div class="product-layout">
        <section class="gallery-panel" aria-label="Product image gallery">
          <div class="main-image-shell">
            <img
              src={presentation.primaryImageUrl}
              alt={presentation.displayTitle}
              id="main-product-image"
              class="main-image"
              onerror={imageOnError}
            />
          </div>

          {presentation.imageUrls.length > 1 && (
            <div class="thumbnail-row" role="list" aria-label="Product images">
              {presentation.imageUrls.map((imageUrl, index) => (
                <button
                  type="button"
                  class={`thumbnail-button ${index === 0 ? 'active' : ''}`}
                  data-product-thumb
                  data-image-src={imageUrl}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <img src={imageUrl} alt="" loading="lazy" onerror={imageOnError} />
                </button>
              ))}
            </div>
          )}
        </section>

        <section class="buy-panel">
          <div class="title-block">
            <div class="badge-row">
              {presentation.condition.label && <span class={`meta-badge ${presentation.condition.tone}`}>{presentation.condition.label}</span>}
              {presentation.grade && <span class="meta-badge grade">{presentation.grade.label}</span>}
            </div>
            <h1>{presentation.rawTitle}</h1>
            {normalizeText(product.short_specs) && <p class="short-specs">{product.short_specs}</p>}
          </div>

          <div class="price-card">
            <div class="price-row">
              <span class="current-price">{presentation.pricing.priceText}</span>
              {presentation.pricing.compareAtText && <span class="compare-price">{presentation.pricing.compareAtText}</span>}
            </div>
            {presentation.pricing.hasDiscount && presentation.pricing.savingsText && (
              <p class="savings-line">
                Save {presentation.pricing.savingsText}
                {presentation.pricing.percent > 0 && ` (${presentation.pricing.percent}%)`}
              </p>
            )}
            <p class={`stock-line ${presentation.stock.tone}`}>
              <span class="stock-dot"></span>
              {presentation.stock.detail}
            </p>
          </div>

          {presentation.summarySpecs.length > 0 && (
            <div class="summary-specs" aria-label="Key specs summary">
              {presentation.summarySpecs.map((spec) => (
                <div class="summary-spec">
                  <span>{spec.label}</span>
                  <strong>{spec.value}</strong>
                </div>
              ))}
            </div>
          )}

          <div class="cta-stack">
            {presentation.stock.isInStock ? (
              <button
                class="pill-button primary add-to-cart-btn cta-button"
                data-id={product.id}
                data-title={presentation.rawTitle}
                data-price={presentation.pricing.price}
                data-slug={product.slug}
                data-image={presentation.primaryImageUrl}
                aria-label={`Add ${presentation.displayTitle} to cart`}
              >
                Add to Cart
              </button>
            ) : (
              <button class="pill-button primary cta-button" disabled aria-disabled="true">
                Out of Stock
              </button>
            )}
            <a
              href={productWhatsappHref}
              class="pill-button whatsapp-button cta-button"
              target="_blank"
              rel="noreferrer"
            >
              Ask on WhatsApp
            </a>
          </div>

          <section class="policy-grid" aria-label="Store policies">
            {buyingHighlights.map((item) => (
              <article class="policy-card">
                <strong>{item.title}</strong>
                <p>{item.body}</p>
              </article>
            ))}
          </section>

          <div class="trust-chip-row" aria-label="Trust information">
            {trustChips.map((chip) => <span class="trust-chip">{chip.label}</span>)}
          </div>

          <section class="reassurance-grid" aria-label="Delivery, pickup, and payment reassurance">
            {reassuranceCards.map((card) => (
              <article class="reassurance-card">
                <img src={card.icon} alt="" loading="lazy" class="reassurance-icon" />
                <div>
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                </div>
              </article>
            ))}
          </section>
        </section>
      </div>

      <div class="detail-layout">
        {presentation.specRows.length > 0 && (
          <section class="detail-card">
            <div class="section-head">
              <p class="eyebrow">Specifications</p>
              <h2>Product details</h2>
            </div>
            <dl class="spec-table">
              {presentation.specRows.map((row) => (
                <div class="spec-row">
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <section class="detail-card">
          <div class="section-head">
            <p class="eyebrow">Overview</p>
            <h2>What you’re getting</h2>
          </div>
          {normalizeText(product.short_specs) && <p class="summary-copy">{product.short_specs}</p>}
          {safeDescriptionHtml ? (
            <div class="description-copy" set:html={safeDescriptionHtml} />
          ) : (
            <p class="summary-copy">Message us on WhatsApp and we'll confirm the details for you.</p>
          )}
        </section>
      </div>

      <section class="support-section detail-card">
        <div class="section-head">
          <p class="eyebrow">Support</p>
          <h2>Questions buyers usually ask</h2>
        </div>
        <div class="faq-list">
          <details>
            <summary>Can I inspect the item before paying?</summary>
            <p>Yes. You can visit the shop, request a WhatsApp walk-through, or ask us how inspection works before you buy.</p>
          </details>
          <details>
            <summary>How do delivery and pickup work?</summary>
            <p>We offer Nairobi delivery where available and in-store pickup from Moi Avenue. If you are outside Nairobi, message us and we will help arrange delivery.</p>
          </details>
          <details>
            <summary>What payment methods are available?</summary>
            <p>You can pay by M-PESA, and some local orders can be paid on delivery. You can confirm with us before buying.</p>
          </details>
        </div>
      </section>

      {related.length > 0 && (
        <section class="related-section">
          <div class="section-head">
            <div>
              <p class="eyebrow">Related products</p>
              <h2>More from this category</h2>
            </div>
            <a href={presentation.categoryPath} class="text-link">View {presentation.categoryLabel}</a>
          </div>
          <div class="product-grid">
            {related.map((item) => <ProductCard product={item} />)}
          </div>
        </section>
      )}
    </div>
  </div>

  <StickyATC product={product} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbData)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(productStructuredData)} />

  <script>
    const mainImage = document.getElementById('main-product-image');
    const thumbButtons = Array.from(document.querySelectorAll('[data-product-thumb]'));

    thumbButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement) || !(mainImage instanceof HTMLImageElement)) {
          return;
        }

        const nextSrc = button.dataset.imageSrc;
        if (!nextSrc) {
          return;
        }

        mainImage.src = nextSrc;
        thumbButtons.forEach((thumb) => {
          thumb.classList.remove('active');
          thumb.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');
      });
    });
  </script>
</Layout>

<style>
  .product-page {
    padding: 1.4rem 0 7rem;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .product-layout,
  .detail-layout {
    display: grid;
    gap: 1.4rem;
  }

  .product-search-card {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.4rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--white);
    box-shadow: 0 18px 44px rgb(15 23 42 / 0.06);
  }

  .gallery-panel,
  .buy-panel,
  .detail-card {
    border: 1px solid var(--border);
    border-radius: 1.5rem;
    background: var(--white);
    box-shadow: 0 18px 44px rgb(15 23 42 / 0.06);
  }

  .gallery-panel,
  .buy-panel {
    padding: 1.1rem;
  }

  .main-image-shell {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    padding: 1rem;
    border-radius: 1.2rem;
    background:
      radial-gradient(circle at top, rgb(219 234 254 / 0.72), transparent 42%),
      linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    border: 1px solid rgb(226 232 240 / 0.9);
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .thumbnail-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.95rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
  }

  .thumbnail-button {
    width: 4.5rem;
    height: 4.5rem;
    flex-shrink: 0;
    padding: 0.35rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: #f8fafc;
  }

  .thumbnail-button.active {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgb(29 78 216 / 0.12);
  }

  .thumbnail-button img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .buy-panel {
    display: grid;
    gap: 1rem;
  }

  .badge-row,
  .trust-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .meta-badge,
  .trust-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .meta-badge {
    border: 1px solid rgb(203 213 225 / 0.9);
    background: rgb(241 245 249 / 0.95);
    color: #334155;
  }

  .meta-badge.new {
    border-color: rgb(147 197 253 / 0.72);
    background: rgb(219 234 254 / 0.9);
    color: #1d4ed8;
  }

  .meta-badge.refurbished {
    border-color: rgb(253 186 116 / 0.72);
    background: rgb(255 247 237 / 0.96);
    color: #c2410c;
  }

  .meta-badge.grade,
  .trust-chip {
    border: 1px solid rgb(29 78 216 / 0.15);
    background: rgb(239 246 255);
    color: var(--primary);
  }

  .title-block h1,
  .section-head h2 {
    margin: 0;
  }

  .title-block h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.08;
    margin-top: 0.4rem;
  }

  .short-specs,
  .summary-copy {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .product-search-copy {
    margin: 0.45rem 0 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .price-card {
    padding: 1rem;
    border-radius: 1.2rem;
    border: 1px solid rgb(226 232 240 / 0.92);
    background: linear-gradient(180deg, rgb(248 250 252 / 0.96), rgb(255 255 255 / 0.98));
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
  }

  .current-price {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    color: var(--primary);
  }

  .compare-price {
    font-size: 1rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .savings-line,
  .stock-line {
    margin: 0.45rem 0 0;
    font-weight: 700;
  }

  .savings-line {
    color: var(--accent-hover);
  }

  .stock-line {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .stock-line.in {
    color: #166534;
  }

  .stock-line.low {
    color: #854d0e;
  }

  .stock-line.out {
    color: #991b1b;
  }

  .stock-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: currentColor;
  }

  .summary-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .summary-spec {
    padding: 0.85rem;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240 / 0.92);
    background: #f8fafc;
  }

  .summary-spec span {
    display: block;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }

  .summary-spec strong {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .cta-stack {
    display: grid;
    gap: 0.75rem;
  }

  .policy-grid {
    display: grid;
    gap: 0.75rem;
  }

  .policy-card {
    padding: 0.95rem 1rem;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240 / 0.92);
    background: #f8fafc;
  }

  .policy-card strong,
  .policy-card p {
    margin: 0;
  }

  .policy-card strong {
    display: block;
    font-size: 0.94rem;
    line-height: 1.35;
    color: #0f172a;
  }

  .policy-card p {
    margin-top: 0.35rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .cta-button {
    width: 100%;
    min-height: 3.2rem;
    justify-content: center;
  }

  .whatsapp-button {
    background: #25d366;
    color: var(--white);
  }

  .reassurance-grid {
    display: grid;
    gap: 0.85rem;
  }

  .reassurance-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 0.9rem;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240 / 0.92);
    background: #f8fafc;
  }

  .reassurance-icon {
    width: 2.2rem;
    height: 2.2rem;
    object-fit: contain;
  }

  .reassurance-card h3,
  .reassurance-card p {
    margin: 0;
