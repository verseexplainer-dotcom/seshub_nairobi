---
import PortalShell from '../../components/PortalShell.astro';
import StatusPill from '../../components/StatusPill.astro';
import { adminNavItems } from '../../lib/navigation';
import { FULFILLMENT_STATUS_OPTIONS, PAYMENT_STATUS_OPTIONS, formatDateTime, formatKes, getFulfillmentStatusTone, getPaymentStatusTone, titleCaseStatus } from '../../lib/order-utils';
import { createAdminSupabaseClient } from '../../lib/supabase-admin';
import { normalizePhoneForWhatsApp } from '../../lib/auth-utils';

const adminSupabase = createAdminSupabaseClient(Astro.locals);
const searchParams = Astro.url.searchParams;
const q = searchParams.get('q')?.trim() || '';
const payment = searchParams.get('payment') || '';
const fulfillment = searchParams.get('fulfillment') || '';
const dateFrom = searchParams.get('date_from') || '';
const dateTo = searchParams.get('date_to') || '';
const message = searchParams.get('message');
const error = searchParams.get('error');

let query = adminSupabase
  .from('orders')
  .select('id, order_number, customer_name, customer_phone, total_kes, payment_status, fulfillment_status, created_at')
  .order('created_at', { ascending: false })
  .limit(100);

if (q) {
  query = query.or(
    `order_number.ilike.%${q}%,customer_name.ilike.%${q}%,customer_phone.ilike.%${q}%`
  );
}

if (payment) {
  query = query.eq('payment_status', payment);
}

if (fulfillment) {
  query = query.eq('fulfillment_status', fulfillment);
}

if (dateFrom) {
  query = query.gte('created_at', `${dateFrom}T00:00:00`);
}

if (dateTo) {
  query = query.lte('created_at', `${dateTo}T23:59:59`);
}

const { data } = await query;
const orders = data ?? [];
---

<PortalShell
  title="Orders"
  intro="Search and filter real orders created from checkout, then open each one and follow it up."
  navItems={adminNavItems}
  currentPath={Astro.url.pathname}
  badge="Admin"
>
  <div class="stack">
    {error && <div class="app-alert danger">{error}</div>}
    {message && <div class="app-alert success">{message}</div>}

    <section class="app-card">
      <div class="section-heading">
        <div>
          <h2>Filters</h2>
          <p>Search by order number, customer name, or phone.</p>
        </div>
      </div>

      <form class="app-form">
        <div class="app-form-grid cols-2">
          <div class="form-field">
            <label for="q">Search</label>
            <input id="q" name="q" value={q} placeholder="SES-20260310-0001 or John" />
          </div>

          <div class="form-field">
            <label for="payment">Payment status</label>
            <select id="payment" name="payment">
              <option value="">All payment states</option>
              {PAYMENT_STATUS_OPTIONS.map((option) => (
                <option value={option} selected={payment === option}>{titleCaseStatus(option)}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="app-form-grid cols-2">
          <div class="form-field">
            <label for="fulfillment">Fulfillment status</label>
            <select id="fulfillment" name="fulfillment">
              <option value="">All fulfillment states</option>
              {FULFILLMENT_STATUS_OPTIONS.map((option) => (
                <option value={option} selected={fulfillment === option}>{titleCaseStatus(option)}</option>
              ))}
            </select>
          </div>

          <div class="app-form-grid cols-2">
            <div class="form-field">
              <label for="date_from">From</label>
              <input id="date_from" name="date_from" type="date" value={dateFrom} />
            </div>

            <div class="form-field">
              <label for="date_to">To</label>
              <input id="date_to" name="date_to" type="date" value={dateTo} />
            </div>
          </div>
        </div>

        <div class="app-actions">
          <button type="submit" class="pill-button primary">Apply Filters</button>
          <a class="pill-button" href="/admin/orders">Reset</a>
        </div>
      </form>
    </section>

    <section class="app-card">
      <div class="section-heading">
        <div>
          <h2>Orders List</h2>
          <p>{orders.length} orders returned.</p>
        </div>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th>Total</th>
              <th>Payment</th>
              <th>Fulfillment</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {orders.map((order) => {
              const waPhone = normalizePhoneForWhatsApp(order.customer_phone);
              const waHref = waPhone
                ? `https://wa.me/${waPhone}?text=${encodeURIComponent(`Hello ${order.customer_name}, this is SES ICT HUB following up on order ${order.order_number}.`)}`
                : null;

              return (
                <tr>
                  <td>
                    <strong>{order.order_number}</strong>
                  </td>
                  <td>
                    <div class="detail-row compact">
                      <strong>{order.customer_name}</strong>
                      <span>{order.customer_phone}</span>
                    </div>
                  </td>
                  <td>{formatKes(order.total_kes)}</td>
                  <td>
                    <StatusPill
                      label={titleCaseStatus(order.payment_status)}
                      tone={getPaymentStatusTone(order.payment_status)}
                    />
                  </td>
                  <td>
                    <StatusPill
                      label={titleCaseStatus(order.fulfillment_status)}
                      tone={getFulfillmentStatusTone(order.fulfillment_status)}
                    />
                  </td>
                  <td>{formatDateTime(order.created_at)}</td>
                  <td>
                    <div class="table-actions">
                      <a class="text-link" href={`/admin/orders/${order.id}`}>Details</a>
                      {waHref && (
                        <a class="text-link" href={waHref} target="_blank">WhatsApp</a>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</PortalShell>

<style>
  .table-wrap {
    overflow-x: auto;
  }

  .detail-row.compact {
    gap: 0.1rem;
  }

  .table-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
</style>
