---
import '../styles/global.css';
import AnnouncementStrip from '../components/AnnouncementStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingChat from '../components/FloatingChat.astro';

interface Props {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
  imageAlt?: string | undefined;
  ogType?: 'website' | 'product' | 'article' | undefined;
  canonical?: string | undefined;
  hideAnnouncementStrip?: boolean | undefined;
  structuredData?: Record<string, unknown> | undefined;
}

const {
  title,
  description = "SES ICT HUB - Brand-new and Ex-uk Grade A refurb electronics in Kenya. Laptops, desktops, printers, smartphones, and accessories with clear pricing and stock status.",
  image,
  imageAlt,
  ogType = 'website',
  canonical,
  hideAnnouncementStrip = false,
  structuredData
} = Astro.props;

const canonicalURL = new URL(canonical || Astro.url.pathname, Astro.site || 'https://sesicthub.co.ke');
const defaultSocialImage = '/site-assets/og-default.jpg';
const socialImage = String(image || '').trim() || defaultSocialImage;
const plainDescription = String(description || '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 320);
const safeDescription =
  plainDescription ||
  'SES ICT HUB - Brand-new and Ex-uk Grade A refurb electronics in Kenya. Laptops, desktops, printers, smartphones, and accessories with clear pricing and stock status.';
const canonicalImage = new URL(socialImage, Astro.site || canonicalURL).toString();
const safeImageAlt = String(imageAlt || `${title} — SES ICT HUB`).replace(/\s+/g, ' ').trim().slice(0, 200);
const usesDefaultSocialImage = socialImage === defaultSocialImage;
const faviconVersion = '20260322';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`/favicon.ico?v=${faviconVersion}`} sizes="any" />
    <link rel="shortcut icon" href={`/favicon.ico?v=${faviconVersion}`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32x32.png?v=${faviconVersion}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16x16.png?v=${faviconVersion}`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${faviconVersion}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${faviconVersion}`} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title} | SES ICT HUB</title>
    <meta name="title" content={`${title} | SES ICT HUB`} />
    <meta name="description" content={safeDescription} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:site_name" content="SES ICT HUB" />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:image" content={canonicalImage} />
    <meta property="og:image:secure_url" content={canonicalImage} />
    <meta property="og:image:alt" content={safeImageAlt} />
    {usesDefaultSocialImage && <meta property="og:image:type" content="image/jpeg" />}
    {usesDefaultSocialImage && <meta property="og:image:width" content="1200" />}
    {usesDefaultSocialImage && <meta property="og:image:height" content="630" />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={safeDescription} />
    <meta name="twitter:image" content={canonicalImage} />
    <meta name="twitter:image:alt" content={safeImageAlt} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    {!hideAnnouncementStrip && <AnnouncementStrip />}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingChat />
    <div class="cart-toast" id="cart-toast" role="status" aria-live="polite" aria-atomic="true" hidden>
      <span class="cart-toast-icon" aria-hidden="true">✓</span>
      <span class="cart-toast-copy">
        <strong id="cart-toast-title">Added to cart</strong>
        <span id="cart-toast-detail">Item added successfully.</span>
      </span>
      <a href="/cart">View cart</a>
    </div>
    
    <script>
      if (!localStorage.getItem('ses_session_id')) {
        localStorage.setItem('ses_session_id', crypto.randomUUID());
      }

      if (!window.__sesCartHandlerBound) {
        window.__sesCartHandlerBound = true;

        document.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('[data-add-to-cart]') : null;
          if (!(button instanceof HTMLButtonElement)) return;
          if (!button.dataset.id || !button.dataset.title || !button.dataset.slug) return;

          const item = {
            id: button.dataset.id,
            title: button.dataset.title,
            price_kes: Number(button.dataset.price || '0'),
            slug: button.dataset.slug,
            image: button.dataset.image,
            qty: 1
          };

          const cart = JSON.parse(localStorage.getItem('ses_cart') || '[]') as Array<{
            id: string | number;
            title: string;
            price_kes: number;
            slug: string;
            image?: string | undefined;
            qty: number;
          }>;
          const existing = cart.find((entry) => String(entry.id) === String(item.id));

          if (existing) {
            existing.qty += 1;
          } else {
            cart.push(item);
          }

          localStorage.setItem('ses_cart', JSON.stringify(cart));
          window.dispatchEvent(new Event('cart-updated'));

          const originalText = button.dataset.originalLabel || button.textContent || 'Add to cart';
          button.dataset.originalLabel = originalText;
          button.textContent = 'Added';
          button.setAttribute('aria-label', `${item.title} added to cart`);
          button.style.backgroundColor = '#047857';

          const toast = document.getElementById('cart-toast');
          const toastTitle = document.getElementById('cart-toast-title');
          const toastDetail = document.getElementById('cart-toast-detail');

          if (toast) {
            if (toastTitle) toastTitle.textContent = existing ? 'Quantity updated' : 'Added to cart';
            if (toastDetail) toastDetail.textContent = item.title;
            toast.hidden = false;
            toast.dataset.visible = 'true';

            const cartToastWindow = window as Window & { __sesCartToastTimer?: number };
            window.clearTimeout(cartToastWindow.__sesCartToastTimer);
            cartToastWindow.__sesCartToastTimer = window.setTimeout(() => {
              toast.dataset.visible = 'false';
              window.setTimeout(() => {
                if (toast.dataset.visible === 'false') {
                  toast.hidden = true;
                }
              }, 220);
            }, 6000);
          }

          window.setTimeout(() => {
            button.textContent = originalText;
            button.removeAttribute('aria-label');
            button.style.backgroundColor = '';
          }, 1400);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }

  .cart-toast {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 120;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    width: min(26rem, calc(100vw - 2rem));
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.98);
    color: #0f172a;
    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.18);
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .cart-toast[hidden] {
    display: none;
  }

  .cart-toast[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  .cart-toast-icon {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
    background: #047857;
    color: #ffffff;
    font-weight: 900;
  }

  .cart-toast-copy {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
  }

  .cart-toast-copy strong,
  .cart-toast-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cart-toast-copy strong {
    font-size: 0.92rem;
    font-weight: 900;
  }

  .cart-toast-copy span {
    color: #64748b;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .cart-toast a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 900;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .cart-toast {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .cart-toast a {
      grid-column: 1 / -1;
      width: 100%;
    }
  }
</style>
