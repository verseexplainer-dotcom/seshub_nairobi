---
import '../styles/global.css';
import AnnouncementStrip from '../components/AnnouncementStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteAssets } from '../lib/siteAssets';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const siteAssets = getSiteAssets(import.meta.env.PUBLIC_SUPABASE_URL);

const {
  title,
  description = "SES ICT HUB - Brand-new and certified refurbished electronics in Kenya. Laptops, printers, and smartphones with clear pricing and stock status.",
  image = siteAssets.hero.src,
  canonical
} = Astro.props;

const canonicalURL = new URL(canonical || Astro.url.pathname, Astro.site || 'https://sesicthub.co.ke');
const plainDescription = String(description || '')
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 320);
const safeDescription =
  plainDescription ||
  'SES ICT HUB - Brand-new and certified refurbished electronics in Kenya. Laptops, printers, and smartphones with clear pricing and stock status.';
const canonicalImage = new URL(image, Astro.site || canonicalURL).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title} | SES ICT HUB</title>
    <meta name="title" content={`${title} | SES ICT HUB`} />
    <meta name="description" content={safeDescription} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:image" content={canonicalImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={safeDescription} />
    <meta property="twitter:image" content={canonicalImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <AnnouncementStrip />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    
    <script>
      if (!localStorage.getItem('ses_session_id')) {
        localStorage.setItem('ses_session_id', crypto.randomUUID());
      }

      if (!window.__sesCartHandlerBound) {
        window.__sesCartHandlerBound = true;

        document.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('[data-add-to-cart]') : null;
          if (!(button instanceof HTMLButtonElement)) return;
          if (!button.dataset.id || !button.dataset.title || !button.dataset.slug) return;

          const item = {
            id: button.dataset.id,
            title: button.dataset.title,
            price_kes: Number(button.dataset.price || '0'),
            slug: button.dataset.slug,
            image: button.dataset.image,
            imageFallback: button.dataset.imageFallback,
            qty: 1
          };

          const cart = JSON.parse(localStorage.getItem('ses_cart') || '[]') as Array<{
            id: string | number;
            title: string;
            price_kes: number;
            slug: string;
            image?: string | undefined;
            imageFallback?: string | undefined;
            qty: number;
          }>;
          const existing = cart.find((entry) => String(entry.id) === String(item.id));

          if (existing) {
            existing.qty += 1;
            if (!existing.imageFallback && item.imageFallback) {
              existing.imageFallback = item.imageFallback;
            }
          } else {
            cart.push(item);
          }

          localStorage.setItem('ses_cart', JSON.stringify(cart));
          window.dispatchEvent(new Event('cart-updated'));

          const originalText = button.dataset.originalLabel || button.textContent || 'Add to cart';
          button.dataset.originalLabel = originalText;
          button.textContent = 'Added';
          button.style.backgroundColor = '#047857';

          window.setTimeout(() => {
            button.textContent = originalText;
            button.style.backgroundColor = '';
          }, 1400);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }
</style>
